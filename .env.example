TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
# Optional public address (canonical links, sitemap, RSS, share and mail links), e.g. https://mangahub.com.tr
# Admin → Tema → Genel → "Site adresi" overrides it; when both are empty the visited address is used.
# APP_URL=
APP_KEY=
NODE_ENV=development
SESSION_DRIVER=cookie
# Fast local default (no database server required)
DB_CONNECTION=sqlite
SQLITE_DB_PATH=tmp/manga.sqlite3
# Optional persistent content directory; absolute paths are recommended for standalone production.
# CONTENT_ROOT=/srv/mangahub/content

# Used only when DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=manga_theme
# Account mails (password reset, e-mail verification). All optional: without SMTP_HOST the
# mails are written to the log (and printed in the console in development).
# Mail links use the same public address as above (Site adresi / APP_URL).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM_ADDRESS=no-reply@example.com
# MAIL_FROM_NAME=MangaHub
