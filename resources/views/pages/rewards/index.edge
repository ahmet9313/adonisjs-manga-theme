@component('components/layout/main', { title })

@slot('main')
  @let(me = auth.user)
  @let(summary = account || null)
  @let(info = summary || levelOf(me))
  @let(maxed = !info.needed)
  @let(left = Math.max(0, info.needed - info.current))
  @let(next = upcoming.length ? upcoming[0] : null)
  {{-- Daily check-in: where today sits in the 7-day cycle (the 7th day of every cycle drops a card). --}}
  @let(streak = summary ? summary.streak : 0)
  @let(checkedIn = summary ? summary.checkedIn : false)
  @let(cycle = week.length)
  @let(todayStreak = checkedIn ? Math.max(streak, 1) : streak + 1)
  @let(todayIndex = ((todayStreak - 1) % cycle) + 1)
  @let(cycleBase = todayStreak - todayIndex)
  @let(todayGain = exp.checkinBase + exp.checkinStreakBonus * Math.min(todayStreak - 1, exp.checkinStreakCap - 1))
  @let(tomorrowGain = exp.checkinBase + exp.checkinStreakBonus * Math.min(todayStreak, exp.checkinStreakCap - 1))
  @let(checkinMax = exp.checkinBase + exp.checkinStreakBonus * (exp.checkinStreakCap - 1))

  @component('components/ui/page_header', { title: 'Seviye ve Ödüller', description: 'Burada satın alınacak bir şey yok. Okudukça, yorum yaptıkça ve her gün uğradıkça seviye atlarsın; çerçeve, ad efekti, duvar kağıdı ve çıkartmalar kendiliğinden açılır.', breadcrumb: [{ label: 'Seviye ve Ödüller' }] })
    @slot('actions')
    @component('components/ui/button', { href: '/rozetler', icon: 'trophy' })
      Rozetler
    @end
    @component('components/ui/button', { href: '/kozmetik/cerceveler', icon: 'sparkles', variant: 'ghost' })
      Kozmetikler
    @end
    @end
  @end

  <div class="rewards-grid">
    {{-- Level --}}
    <section class="panel level-hero" aria-labelledby="level-title">
      <div class="level-hero__main">
        <h2 id="level-title" class="level-medal">
          <span class="level-medal__label">Seviye</span>
          <span class="level-medal__value">{{ info.level }}</span>
        </h2>
        <div class="min-w-0 flex-1">
          <p class="t-overline">{{ maxed ? 'Zirvedesin' : 'Sonraki seviye' }}</p>
          <p class="level-hero__goal mt-1">
            @if(maxed)
            En yüksek seviyeye ulaştın
            @else
            Lv.{{ info.level + 1 }} için <span class="t-num">{{ left.toLocaleString('tr-TR') }}</span> EXP kaldı
            @end
          </p>
          @!component('components/ui/progress', { value: maxed ? 1 : info.current, max: maxed ? 1 : info.needed, label: maxed ? 'Seviye ilerlemesi' : 'Seviye ' + (info.level + 1) + ' ilerlemesi', valueText: maxed ? 'Tamamlandı' : info.current + ' / ' + info.needed + ' EXP', class: 'mt-3' })
          <p class="mt-2 flex flex-wrap justify-between gap-x-3 text-xs text-muted">
            @if(maxed)
            <span>Bütün seviye ödüllerini açtın.</span>
            @else
            <span class="t-num">{{ info.current.toLocaleString('tr-TR') }} / {{ info.needed.toLocaleString('tr-TR') }} EXP</span>
            <span class="t-num">%{{ info.progress }}</span>
            @end
          </p>
        </div>
      </div>

      @if(next)
      <a href="#yakinda" class="next-unlock">
        @!component('components/ui/cosmetic_preview', { kind: next.type, visual: next.visual, user: me, size: 'sm', class: 'shrink-0' })
        <span class="min-w-0 flex-1">
          <span class="t-overline block">Sıradaki ödül</span>
          <span class="block truncate text-sm font-bold text-ink">{{ next.name }}</span>
          <span class="block text-xs text-muted">{{ next.kind }} · Lv.{{ next.level }} olunca açılır</span>
        </span>
        @!component('components/icon', { name: 'chevron-right' })
      </a>
      @end

      <dl class="reward-stats">
        <div>
          <dt class="stat__label">Toplam EXP</dt>
          <dd class="reward-stats__value">{{ info.exp.toLocaleString('tr-TR') }}</dd>
        </div>
        @if(summary)
        <div>
          <dt class="stat__label">Rozetler</dt>
          <dd>
            <a href="/rozetler" class="reward-stats__value">
              <span>{{ summary.badges }}<span class="text-base text-muted"> / {{ badgeCount }}</span></span>
              <span class="sr-only">rozet: rozetleri gör</span>
              @!component('components/icon', { name: 'chevron-right' })
            </a>
          </dd>
        </div>
        <div>
          <dt class="stat__label">Kartlar</dt>
          <dd>
            <a href="/kartlar" class="reward-stats__value">
              <span>{{ summary.cards.toLocaleString('tr-TR') }}</span>
              <span class="sr-only">kart: kartları gör</span>
              @!component('components/icon', { name: 'chevron-right' })
            </a>
          </dd>
        </div>
        @end
      </dl>
    </section>

    {{-- Daily check-in --}}
    <section id="gunluk-giris" class="panel checkin scroll-mt-24" aria-labelledby="checkin-title">
      <div class="mb-3">
        <div class="flex items-center justify-between gap-3">
          <h2 id="checkin-title" class="panel__title">Günlük giriş</h2>
          <p class="checkin-streak" data-active="{{ streak ? 'true' : 'false' }}">
            @!component('components/icon', { name: 'fire' })
            <span>{{ streak }} gün seri</span>
          </p>
        </div>
        <p class="panel__desc">Her gün uğra, serini büyüt. Her {{ cycle }}. gün bir kart garanti!</p>
      </div>

      <ol class="checkin-strip" aria-label="Bu haftanın giriş ödülleri" tabindex="0" x-data
          x-init="const day = $el.querySelector('[aria-current]'); if (day) $el.scrollLeft = day.offsetLeft + day.offsetWidth / 2 - $el.clientWidth / 2">
        @each(day in week)
        @let(gain = exp.checkinBase + exp.checkinStreakBonus * Math.min(cycleBase + day.day - 1, exp.checkinStreakCap - 1))
        @let(phase = day.day < todayIndex || (day.day === todayIndex && checkedIn) ? 'claimed' : day.day === todayIndex ? 'today' : 'upcoming')
        <li class="checkin-day" data-state="{{ phase }}"
          @if(day.card)
          data-card
          @end
          @if(day.day === todayIndex)
          aria-current="date"
          @end
          >
          @if(day.card)
          <span class="checkin-day__card" aria-hidden="true">Kart</span>
          @end
          <span class="checkin-day__label" aria-hidden="true">{{ day.day === todayIndex ? 'Bugün' : day.day + '. gün' }}</span>
          <span class="checkin-day__icon" aria-hidden="true">
            @!component('components/icon', { name: phase === 'claimed' ? 'check' : phase === 'today' ? 'gift' : day.card ? 'cards' : 'bolt', stroke: phase === 'claimed' ? 2.4 : 1.8 })
          </span>
          <span class="checkin-day__exp" aria-hidden="true">+{{ gain }}</span>
          <span class="sr-only">{{ day.day }}. gün{{ day.day === todayIndex ? ' (bugün)' : '' }}: {{ phase === 'claimed' ? 'alındı' : phase === 'today' ? 'alınmaya hazır' : 'sırada' }}, {{ gain }} EXP{{ day.card ? ' ve bir kart' : '' }}</span>
        </li>
        @end
      </ol>

      <div class="checkin__foot mt-5">
        <div class="min-w-0">
          @if(checkedIn)
          <p class="text-sm text-body-2">Bugünkü ödülünü aldın. Yarın: <strong class="t-num text-ink">+{{ tomorrowGain }} EXP</strong>{{ todayIndex === cycle - 1 ? ' ve bir kart' : '' }}</p>
          @else
          <p class="text-sm text-body-2">Bugünkü ödülün hazır: <strong class="t-num text-ink">+{{ todayGain }} EXP</strong>{{ todayIndex === cycle ? ' ve bir kart' : '' }}</p>
          @end
          <p class="mt-0.5 text-xs text-muted">En iyi serin: <span class="t-num">{{ Math.max(me.bestStreak || 0, streak) }}</span> gün</p>
        </div>
        <form action="/gunluk-giris" method="POST" class="w-full sm:w-auto" data-submit-once>
          {{ csrfField() }}
          @if(checkedIn)
          @component('components/ui/button', { type: 'submit', icon: 'check', class: 'w-full sm:w-auto', disabled: true })
            Bugün alındı
          @end
          @else
          @component('components/ui/button', { type: 'submit', variant: 'primary', icon: 'gift', class: 'w-full sm:w-auto' })
            Günlük giriş (+{{ summary ? summary.nextCheckin : todayGain }})
          @end
          @end
        </form>
      </div>
    </section>

    {{-- Upcoming unlocks --}}
    <section id="yakinda" class="panel scroll-mt-24 xl:self-start" aria-labelledby="yakinda-title">
      <div class="panel__head">
        <div class="min-w-0">
          <h2 id="yakinda-title" class="panel__title">Yakında açılacaklar</h2>
          <p class="panel__desc">Seviye atladıkça kendiliğinden açılır.</p>
        </div>
        <a href="/kozmetik/cerceveler" class="section-head__link">
          Tüm kozmetikler
          @!component('components/icon', { name: 'arrow-right', class: 'h-4 w-4' })
        </a>
      </div>
      @if(upcoming.length)
      <ul class="unlock-grid" role="list">
        @each(entry in upcoming)
        <li class="unlock-card">
          <div class="relative">
            @!component('components/ui/cosmetic_preview', { kind: entry.type, visual: entry.visual, user: me, name: me.fullName, class: 'unlock-card__preview' })
            <span class="unlock-card__level">
              @!component('components/level_badge', { level: entry.level })
            </span>
          </div>
          <div class="min-w-0 px-1">
            <p class="unlock-card__name" title="{{ entry.name }}">{{ entry.name }}</p>
            <p class="truncate text-xs text-muted">{{ entry.kind }}</p>
            <p class="unlock-card__lock mt-2">
              @!component('components/icon', { name: 'lock' })
              <span class="t-num">{{ entry.expLeft.toLocaleString('tr-TR') }} EXP kaldı</span>
            </p>
          </div>
        </li>
        @end
      </ul>
      @else
      @component('components/ui/empty_state', { icon: 'sparkles', title: 'Hepsi açık', description: 'Seviyeyle açılan her şeyi açtın. Rozetlere bağlı kozmetikler için rozet sayfasına göz at.' })
        @component('components/ui/button', { href: '/rozetler', icon: 'trophy' })
          Rozetler
        @end
      @end
      @end
    </section>

    {{-- EXP sources --}}
    <section class="panel xl:self-start" aria-labelledby="exp-title">
      <div class="panel__head">
        <div class="min-w-0">
          <h2 id="exp-title" class="panel__title">EXP nasıl kazanılır?</h2>
          <p class="panel__desc">Her şey okuyarak ve topluluğa katılarak kazanılır.</p>
        </div>
      </div>
      <ul class="earn-list" role="list">
        <li>
          <span class="earn-icon" data-tone="accent">
            @!component('components/icon', { name: 'book-open' })
          </span>
          <div class="min-w-0 flex-1">
            <p class="earn-list__title">Yeni bir bölüm okumak</p>
            <p class="earn-list__hint">Her bölümün ilk okunuşu sayılır.</p>
          </div>
          <p class="earn-list__value">+{{ exp.chapterRead }}<span class="earn-list__unit">EXP</span></p>
        </li>
        <li>
          <span class="earn-icon" data-tone="info">
            @!component('components/icon', { name: 'chat' })
          </span>
          <div class="min-w-0 flex-1">
            <p class="earn-list__title">Yorum yazmak</p>
            <p class="earn-list__hint">Seri ve bölüm sayfalarında.</p>
          </div>
          <p class="earn-list__value">+{{ exp.comment }}<span class="earn-list__unit">EXP</span></p>
        </li>
        <li>
          <span class="earn-icon" data-tone="warning">
            @!component('components/icon', { name: 'star' })
          </span>
          <div class="min-w-0 flex-1">
            <p class="earn-list__title">Bir seriye ilk kez puan vermek</p>
            <p class="earn-list__hint">Puanı sonradan düzenlemek ek EXP vermez.</p>
          </div>
          <p class="earn-list__value">+{{ exp.review }}<span class="earn-list__unit">EXP</span></p>
        </li>
        <li>
          <span class="earn-icon" data-tone="success">
            @!component('components/icon', { name: 'calendar' })
          </span>
          <div class="min-w-0 flex-1">
            <p class="earn-list__title">Günlük giriş</p>
            <p class="earn-list__hint">Seri büyüdükçe artar; {{ exp.checkinStreakCap }}. günden sonra her gün +{{ checkinMax }}.</p>
          </div>
          <p class="earn-list__value">+{{ exp.checkinBase }}–{{ checkinMax }}<span class="earn-list__unit">EXP</span></p>
        </li>
        <li>
          <span class="earn-icon" data-tone="warning">
            @!component('components/icon', { name: 'trophy' })
          </span>
          <div class="min-w-0 flex-1">
            <p class="earn-list__title">Rozet kazanmak</p>
            <p class="earn-list__hint">{{ badgeCount }} rozetin çoğu ek EXP verir.</p>
          </div>
          <p class="earn-list__value"><a href="/rozetler" class="link">Bonus</a></p>
        </li>
        <li>
          <span class="earn-icon" data-tone="info">
            @!component('components/icon', { name: 'user-plus' })
          </span>
          <div class="min-w-0 flex-1">
            <p class="earn-list__title">Topluluğa katılmak</p>
            <p class="earn-list__hint">Kayıt olduğunda bir kez.</p>
          </div>
          <p class="earn-list__value">+{{ exp.signup }}<span class="earn-list__unit">EXP</span></p>
        </li>
        <li>
          <span class="earn-icon" data-tone="danger">
            @!component('components/icon', { name: 'cards' })
          </span>
          <div class="min-w-0 flex-1">
            <p class="earn-list__title">Okurken kart düşmesi</p>
            <p class="earn-list__hint">Yeni bölümlerde şans eseri; her {{ cycle }}. günlük giriş kart garanti eder.</p>
          </div>
          <p class="earn-list__value">%{{ cardChance }}<span class="earn-list__unit">şans</span></p>
        </li>
      </ul>
    </section>
  </div>
@end

@end
