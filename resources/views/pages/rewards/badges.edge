@component('components/layout/main', { title })

@slot('main')
  @let(total = board.length)
  @let(locked = total - earned)
  @let(won = board.filter((badge) => badge.earnedAt))
  @let(wonExp = won.reduce((sum, badge) => sum + (badge.exp || 0), 0))
  @let(latest = won.length ? won.slice().sort((a, b) => String(b.earnedAt).localeCompare(String(a.earnedAt)))[0] : null)
  @component('components/ui/page_header', { title: 'Rozetler', description: 'Okudukça, yorum yaptıkça ve her gün uğradıkça rozet kazanırsın. Rozetler EXP verir ve bazı kozmetiklerin kilidini açar.', breadcrumb: [{ label: 'Seviye ve Ödüller', href: '/oduller' }, { label: 'Rozetler' }] })
    @if(latest)
    <p class="mt-2 text-sm text-muted">
      Rozetlerden toplam <strong class="t-num text-ink">{{ wonExp.toLocaleString('tr-TR') }} EXP</strong> kazandın · Son rozetin: <strong class="text-ink">{{ latest.name }}</strong> ({{ dateOf(latest.earnedAt) }})
    </p>
    @end
    @slot('actions')
    <div class="badge-summary">
      <p class="flex items-baseline gap-2">
        <span class="badge-summary__count">{{ earned }} <span class="text-muted">/ {{ total }}</span></span>
        <span class="text-sm text-muted">kazanıldı</span>
      </p>
      @!component('components/ui/progress', { value: earned, max: total || 1, label: 'Kazanılan rozetler', valueText: earned + ' / ' + total })
    </div>
    @end
  @end

  <section aria-labelledby="badges-title" x-data="{ filter: 'all' }">
    <h2 id="badges-title" class="sr-only">Rozet listesi</h2>
    <div x-cloak class="mb-4 flex flex-wrap gap-2" role="group" aria-label="Rozetleri süz">
      <button type="button" class="chip" aria-pressed="true" :aria-pressed="(filter === 'all').toString()" @click="filter = 'all'">
        Tümü
        <span class="chip__count">{{ total }}</span>
      </button>
      <button type="button" class="chip" aria-pressed="false" :aria-pressed="(filter === 'earned').toString()" @click="filter = 'earned'">
        Kazanılan
        <span class="chip__count">{{ earned }}</span>
      </button>
      <button type="button" class="chip" aria-pressed="false" :aria-pressed="(filter === 'locked').toString()" @click="filter = 'locked'">
        Kilitli
        <span class="chip__count">{{ locked }}</span>
      </button>
    </div>

    <ul class="badge-grid" role="list">
      @each(badge in board)
      @if(badge.earnedAt)
      <li x-show="filter !== 'locked'">
      @else
      <li x-show="filter !== 'earned'">
      @end
        @!component('components/ui/badge_card', { badge })
      </li>
      @end
    </ul>

    @if(!earned)
    <div x-cloak x-show="filter === 'earned'">
      @component('components/ui/empty_state', { icon: 'trophy', title: 'Henüz rozetin yok', description: 'İlk bölümünü okuyarak “İlk Adım” rozetini kazanabilirsin.' })
        @component('components/ui/button', { href: '/seriler', variant: 'primary', iconRight: 'arrow-right' })
          Serilere göz at
        @end
      @end
    </div>
    @end
    @if(!locked)
    <div x-cloak x-show="filter === 'locked'">
      @!component('components/ui/empty_state', { icon: 'trophy', title: 'Bütün rozetleri kazandın', description: 'Kilitli rozetin kalmadı. Yeni rozetler eklendiğinde burada görünecek.' })
    </div>
    @end
  </section>
@end

@end
