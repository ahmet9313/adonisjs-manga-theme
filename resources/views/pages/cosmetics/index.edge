@component('components/layout/main', { title })

@slot('main')
  @let(me = auth && auth.user ? auth.user : null)
  @let(hue = me ? [...me.username].reduce((sum, char) => sum + char.charCodeAt(0), 0) * 37 % 360 : 150)
  @let(descriptions = {
    sticker: 'Yorumlarında kullanabileceğin çıkartmaları keşfet ve topla.',
    frame: 'Profil fotoğrafını özelleştirmek için avatar çerçevelerini keşfet ve topla.',
    effect: 'Görünen adını süslemek için ad efektlerini keşfet ve topla.',
    wallpaper: 'Yorum kartlarının ve profilinin arkasında görünen duvar kağıtlarını keşfet ve topla.',
  })
  @let(nouns = { sticker: 'çıkartma', frame: 'çerçeve', effect: 'efekt', wallpaper: 'duvar kağıdı' })
  @let(tabLabels = { frame: 'Çerçeveler', effect: 'Efektler', wallpaper: 'Duvar Kağıtları', sticker: 'Çıkartmalar' })
  @let(kindTabs = ['frame', 'effect', 'wallpaper', 'sticker'].map((name) => kinds.find((entry) => entry.name === name)).filter(Boolean).map((entry) => ({ key: entry.name, label: tabLabels[entry.name] || entry.plural, href: '/kozmetik/' + entry.path })))
  @let(sortOptions = [['featured', 'Öne çıkanlar'], ['level', 'Seviyeye göre'], ['popular', 'En çok kullanılan'], ['name', 'Ada göre']])
  @let(sortChips = sortOptions.map((option) => ({ label: option[1], href: withQuery(request, { sirala: option[0] === 'featured' ? null : option[0] }), active: sort === option[0] })))
  @let(unlockedCount = items.filter((item) => item.unlocked).length)
  <div
    x-data="cosmeticStore"
    data-config="{{ JSON.stringify({ kind, items, me: me ? { name: me.fullName, username: me.username, avatar: me.avatar, hue, level: me.level, look: lookOf(me) } : null }) }}"
  >
    @component('components/ui/page_header', {
      title: info.plural,
      eyebrow: 'Kozmetikler',
      description: descriptions[kind] + ' Hiçbiri satılmaz: okudukça, yorum yaptıkça ve rozet kazandıkça açılır.',
      breadcrumb: [{ label: info.plural }],
    })
      @slot('actions')
        @if(me)
          <a href="/oduller" class="btn btn--ghost btn--md">
            @!component('components/icon', { name: 'gift', class: 'btn__icon' })
            <span>Seviye ve ödüller</span>
          </a>
          <button type="button" class="btn btn--secondary btn--md" @click="$dispatch('open-inventory', kind)">
            @!component('components/icon', { name: 'stack', class: 'btn__icon' })
            <span>Envanter</span>
          </button>
        @else
          <button type="button" class="btn btn--primary btn--md" @click="$dispatch('open-auth', 'login')">
            @!component('components/icon', { name: 'login', class: 'btn__icon' })
            <span>Giriş yap ve topla</span>
          </button>
        @end
      @end
    @end

    <div class="cos-kinds">
      @!component('components/ui/tabs', { mode: 'links', tabs: kindTabs, active: kind, label: 'Kozmetik türleri' })
    </div>

    <div class="cos-toolbar">
      <p class="cos-toolbar__count">
        <strong class="t-num">{{ items.length }}</strong> {{ nouns[kind] }}
        @if(me && !onlyUnlocked)
          <span aria-hidden="true">·</span>
          <strong class="t-num">{{ unlockedCount }}</strong> açık
        @end
      </p>
      <div class="cos-toolbar__filters">
        <span class="t-caption max-sm:hidden" aria-hidden="true">Sırala</span>
        @!component('components/ui/pill_group', { label: 'Sıralama', items: sortChips })
        @if(me)
          <a href="{{ withQuery(request, { acik: onlyUnlocked ? null : '1' }) }}" class="chip cos-only {{ onlyUnlocked ? 'chip--active' : '' }}"
            @if(onlyUnlocked)
            aria-current="true"
            @end
            >
            <span class="cos-only__box" aria-hidden="true">
              @if(onlyUnlocked)
                @!component('components/icon', { name: 'check', stroke: 3 })
              @end
            </span>
            Yalnızca açılanlar
          </a>
        @end
      </div>
    </div>

    @if(!items.length)
      @if(onlyUnlocked)
        @component('components/ui/empty_state', { icon: 'sparkles', title: 'Bu türde henüz açtığın bir öğe yok', description: 'Okudukça, yorum yaptıkça ve rozet kazandıkça yeni öğelerin kilidi açılır.' })
          <a href="{{ withQuery(request, { acik: null }) }}" class="btn btn--secondary btn--md">Tümünü göster</a>
        @end
      @else
        @!component('components/ui/empty_state', { icon: 'sparkles', title: 'Bu türde henüz öğe yok', description: 'Yeni öğeler eklendiğinde burada görünecek.' })
      @end
    @else
      <noscript>
        <p class="alert mb-4" data-tone="warning">Koleksiyonu görmek ve öğeleri kuşanmak için tarayıcında JavaScript'i etkinleştir.</p>
      </noscript>

      <ul class="cos-grid" role="list">
        <template x-for="item in items" :key="item.id">
          <li class="cos-item" :class="item.equipped && 'is-equipped'">
            <div class="cos-item__preview" @click="tryOn(item)">
              @if(kind === 'sticker')
                <img :src="item.visual.img" alt="" class="cos-sticker" loading="lazy" decoding="async">
              @elseif(kind === 'frame')
                @!component('partials/cosmetics/avatar', { size: 'h-16 w-16', text: 'text-xl', frame: 'item.visual' })
              @elseif(kind === 'effect')
                <span class="cos-name" :class="item.visual.cls" :style="item.visual.css || ''" x-text="displayName()"></span>
              @else
                <span class="wall absolute inset-0" :class="item.visual.cls" :style="imageStyle(item.visual)"></span>
              @end
              <span x-show="item.featured" class="cos-flag">
                @!component('components/icon', { name: 'star' })
                Öne çıkan
              </span>
              <span x-show="item.equipped" class="cos-flag cos-flag--end" data-tone="accent">
                @!component('components/icon', { name: 'check', stroke: 2.5 })
                Kuşanıldı
              </span>
            </div>

            <div class="cos-item__body">
              <h2 class="cos-item__name" x-text="item.name"></h2>
              <p class="cos-item__status" :data-state="item.unlocked ? 'open' : 'locked'">
                <span x-show="item.unlocked" class="contents">
                  @!component('components/icon', { name: 'check-circle' })
                </span>
                <span x-show="!item.unlocked" class="contents">
                  @!component('components/icon', { name: 'lock' })
                </span>
                <span class="truncate" x-text="statusText(item)"></span>
              </p>
              <p class="cos-item__users t-num" x-text="usersText(item)"></p>

              <div class="cos-item__actions">
                <button type="button" class="btn btn--ghost btn--sm cos-try {{ kind === 'sticker' ? 'cos-try--wide' : '' }}" @click="tryOn(item)" :aria-label="'Dene: ' + item.name">
                  @!component('components/icon', { name: 'eye', class: 'btn__icon' })
                  <span class="cos-try__text">Dene</span>
                </button>
                @if(kind !== 'sticker')
                  <button type="button" class="btn btn--secondary btn--sm cos-equip" @click="equip(item)"
                          :disabled="busy || (me && !item.unlocked)" :aria-pressed="item.equipped.toString()"
                          :aria-busy="busyId === item.id">
                    <span x-show="me && !item.unlocked" class="contents">
                      @!component('components/icon', { name: 'lock', class: 'btn__icon' })
                    </span>
                    <span x-text="equipLabel(item)"></span>
                  </button>
                @end
              </div>
            </div>
          </li>
        </template>
      </ul>
    @end

    {{-- "Dene": the visitor's own profile card and comment with the item applied. --}}
    @component('components/ui/modal', { id: 'cosmetic-try', title: 'Önizleme', titleExpr: "trying ? trying.name : 'Önizleme'", size: 'md', open: 'tryOpen', close: 'closeTry()' })
      <template x-if="trying">
        <div x-data="{ get look() { return previewLook() } }" class="space-y-5">
          <div class="alert" :data-tone="hintTone()">
            <span x-show="me && !trying.unlocked" class="cos-hint__icon">
              @!component('components/icon', { name: 'lock' })
            </span>
            <span x-show="!me || trying.unlocked" class="cos-hint__icon">
              @!component('components/icon', { name: 'info' })
            </span>
            <p x-text="tryHint()"></p>
          </div>

          @if(kind !== 'sticker')
            <section aria-labelledby="cosmetic-try-profile">
              <h3 id="cosmetic-try-profile" class="t-overline mb-2">Profilinde</h3>
              <div class="cos-profile">
                <template x-if="look.wallpaper">
                  <div class="wall absolute inset-0 -z-20" :class="look.wallpaper.cls" :style="imageStyle(look.wallpaper)"></div>
                </template>
                <div x-show="look.wallpaper" class="wall-veil absolute inset-0 -z-10"></div>
                @!component('partials/cosmetics/avatar', { size: 'h-16 w-16', text: 'text-2xl', frame: 'look.frame' })
                <div class="min-w-0">
                  <p class="flex min-w-0 items-center gap-2">
                    <span class="presence" data-online="1" title="Çevrimiçi"></span>
                    <span class="truncate text-lg font-extrabold text-ink" :class="look.effect && look.effect.cls" :style="look.effect ? (look.effect.css || '') : ''" x-text="displayName()"></span>
                    <span class="lv-badge" :data-tier="tierOf(level())" x-text="'Lv.' + level()"></span>
                  </p>
                  <p class="truncate t-caption" x-text="handle()"></p>
                </div>
              </div>
            </section>
          @end

          <section aria-labelledby="cosmetic-try-comment">
            <h3 id="cosmetic-try-comment" class="t-overline mb-2">Yorumlarında</h3>
            <article class="c-card">
              <template x-if="look.wallpaper">
                <div class="c-wall wall" :class="look.wallpaper.cls" :style="imageStyle(look.wallpaper)"></div>
              </template>
              <div class="c-veil"></div>
              <div class="p-4">
                <div class="flex items-center gap-3">
                  @!component('partials/cosmetics/avatar', { size: 'h-10 w-10', text: 'text-base', frame: 'look.frame' })
                  <div class="min-w-0">
                    <p class="flex min-w-0 items-center gap-1.5 text-sm font-bold">
                      <span class="truncate text-ink" :class="look.effect && look.effect.cls" :style="look.effect ? (look.effect.css || '') : ''" x-text="displayName()"></span>
                      <span class="lv-badge" :data-tier="tierOf(level())" x-text="'Lv.' + level()"></span>
                    </p>
                    <p class="t-caption">şimdi</p>
                  </div>
                </div>
                @if(kind === 'sticker')
                  <img :src="trying.visual.img" :alt="trying.name" class="mt-3 h-28 w-28 object-contain" decoding="async">
                @else
                  <p class="mt-3 text-body">Bu bölüm efsaneydi, bir sonrakini bekliyorum!</p>
                @end
                <div class="mt-3 flex items-center gap-4 t-caption" aria-hidden="true">
                  <span class="inline-flex items-center gap-1">
                    @!component('components/icon', { name: 'up', class: 'h-4 w-4' })
                    12
                  </span>
                  <span class="inline-flex items-center gap-1">
                    @!component('components/icon', { name: 'down', class: 'h-4 w-4' })
                    0
                  </span>
                  <span class="inline-flex items-center gap-1">
                    @!component('components/icon', { name: 'reply', class: 'h-4 w-4' })
                    Yanıtla
                  </span>
                </div>
              </div>
            </article>
          </section>
        </div>
      </template>
      @slot('footer')
        <button type="button" class="btn btn--secondary btn--md" @click="closeTry()">Kapat</button>
        @if(kind !== 'sticker')
          <button type="button" class="btn btn--md" :class="trying && trying.equipped ? 'btn--secondary' : 'btn--primary'"
                  x-show="trying && (!me || trying.unlocked)" @click="equipTried()" :disabled="busy" :aria-busy="busy">
            <span x-text="trying && trying.equipped ? 'Çıkar' : 'Kuşan'">Kuşan</span>
          </button>
        @else
          <button type="button" class="btn btn--primary btn--md" x-show="!me" @click="closeTry(); $dispatch('open-auth', 'login')">Giriş yap</button>
        @end
      @end
    @end
  </div>
@end

@end
