@component('components/layout/main', { title })

@slot('main')
  @let(me = auth && auth.user ? auth.user : null)
  @let(hue = me ? [...me.username].reduce((sum, char) => sum + char.charCodeAt(0), 0) * 37 % 360 : 150)
  @let(descriptions = {
    sticker: 'Yorumlarında kullanabileceğin çıkartmaları keşfet ve topla.',
    frame: 'Profil fotoğrafını özelleştirmek için avatar çerçevelerini keşfet ve topla.',
    effect: 'Görünen adını süslemek için ad efektlerini keşfet ve topla.',
    wallpaper: 'Yorum kartlarının ve profilinin arkasında görünen duvar kağıtlarını keşfet ve topla.',
  })
  <div
    x-data="cosmeticStore"
    data-config="{{ JSON.stringify({ kind, items, me: me ? { name: me.fullName, username: me.username, avatar: me.avatar, hue, level: me.level, look: lookOf(me) } : null }) }}"
  >
    @!component('components/breadcrumb', { items: [{ label: info.plural }] })

    <div class="glass rounded-3xl border border-white/10 p-5 sm:p-7">
      <h1 class="section-title">{{ info.plural }}</h1>
      <p class="mt-3 text-sm text-gray-300">{{ descriptions[kind] }} Hiçbiri satılmaz: okudukça, yorum yaptıkça ve rozet kazandıkça açılır.</p>

      {{-- Kind switcher --}}
      <div class="mt-4 flex flex-wrap gap-2">
        @each(entry in kinds)
          <a href="/kozmetik/{{ entry.path }}" class="pill {{ entry.name === kind ? 'pill-active' : '' }}">{{ entry.plural }}</a>
        @end
        @if(me)
          <button type="button" @click="$dispatch('open-inventory', '{{ kind }}')" class="pill">
            @!component('components/icon', { name: 'stack', class: 'h-4 w-4' })
            Envanter
          </button>
        @end
      </div>

      <div class="mt-5 flex items-center justify-between border-b border-white/10 pb-3">
        <p class="text-sm text-gray-300"><strong class="text-(--t-heading)">{{ items.length }}</strong> {{ info.plural }}</p>
        <div class="relative" x-data="{ menu: false }" @click.outside="menu = false">
          <button type="button" @click="menu = !menu" class="flex h-9 w-9 items-center justify-center rounded-full text-gray-300 hover:bg-white/10 hover:text-(--t-heading)" aria-label="Sıralama ve filtre" :aria-expanded="menu.toString()">
            @!component('components/icon', { name: 'dots', class: 'h-6 w-6' })
          </button>
          <div x-cloak x-show="menu" x-transition class="absolute right-0 top-full z-20 mt-1 w-56 overflow-hidden rounded-xl border border-white/10 bg-(--t-surface-2) py-1 text-sm shadow-2xl">
            @each(option in [['featured', 'Öne çıkanlar'], ['level', 'Seviyeye göre'], ['popular', 'En çok kullanılan'], ['name', 'Ada göre']])
              <a href="?sirala={{ option[0] }}{{ onlyUnlocked ? '&acik=1' : '' }}" class="flex items-center justify-between px-4 py-2 {{ sort === option[0] ? 'text-emerald-300' : 'text-gray-200' }} hover:bg-white/5">
                {{ option[1] }}
                @if(sort === option[0])
                  @!component('components/icon', { name: 'check', class: 'h-4 w-4' })
                @end
              </a>
            @end
            @if(me)
              <div class="my-1 border-t border-white/10"></div>
              <a href="?sirala={{ sort }}{{ onlyUnlocked ? '' : '&acik=1' }}" class="flex items-center gap-2 px-4 py-2 text-gray-200 hover:bg-white/5">
                <span class="flex h-4 w-4 items-center justify-center rounded border border-white/30 {{ onlyUnlocked ? 'bg-emerald-500 border-emerald-500' : '' }}">
                  @if(onlyUnlocked)
                    @!component('components/icon', { name: 'check', class: 'h-3 w-3 text-(--t-heading)', stroke: 3 })
                  @end
                </span>
                Yalnızca açılanlar
              </a>
            @end
          </div>
        </div>
      </div>

      @if(!items.length)
        <p class="py-12 text-center text-gray-400">{{ onlyUnlocked ? 'Henüz bu türde açtığın bir öğe yok.' : 'Bu türde henüz öğe eklenmemiş.' }}</p>
      @end

      <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
        <template x-for="item in items" :key="item.id">
          <div class="relative flex flex-col items-center rounded-2xl border px-3 pb-4 pt-5 text-center transition hover:-translate-y-0.5"
               :class="item.equipped ? 'border-emerald-500/60 bg-emerald-500/[0.08]' : 'border-white/10 bg-white/[0.04] hover:border-white/20'">
            <span x-show="item.featured" class="absolute left-3 top-3 flex h-6 w-7 items-center justify-center rounded bg-sky-500 text-(--t-on-accent)" title="Öne çıkan">
              <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 3l5 5-3 1-4 4 1 5-2 2-4-5-5 5-1-1 5-5-5-4 2-2 5 1 4-4z"/></svg>
            </span>
            <span x-show="!item.unlocked" class="absolute right-3 top-3 text-gray-400" title="Kilitli">
              @!component('components/icon', { name: 'lock', class: 'h-4 w-4' })
            </span>
            <h2 class="w-full truncate px-6 text-sm font-bold text-(--t-heading)" x-text="item.name"></h2>

            {{-- Preview --}}
            <div class="my-4 flex h-24 w-full items-center justify-center" :class="!item.unlocked && 'opacity-70'">
              @if(kind === 'sticker')
                <img :src="item.visual.img" :alt="item.name" class="max-h-24 max-w-[7rem] object-contain" loading="lazy">
              @elseif(kind === 'frame')
                <span class="relative inline-flex h-16 w-16">
                  <span class="h-full w-full overflow-hidden rounded-full bg-gradient-to-br from-slate-500 to-slate-700">
                    <template x-if="me && me.avatar"><img :src="me.avatar" alt="" class="h-full w-full object-cover"></template>
                  </span>
                  <template x-if="item.visual.img"><img :src="item.visual.img" alt="" class="avatar-frame-img"></template>
                  <template x-if="!item.visual.img"><span class="avatar-frame" :class="item.visual.cls"></span></template>
                </span>
              @elseif(kind === 'effect')
                <span class="max-w-full truncate px-1 text-xl font-extrabold sm:text-2xl" :class="item.visual.cls" :style="item.visual.css || ''" x-text="me ? me.name : 'Okur'"></span>
              @else
                <span class="wall h-full w-full rounded-xl border border-white/10" :class="item.visual.cls" :style="imageStyle(item.visual)"></span>
              @end
            </div>

            <p class="text-sm font-bold" :class="item.unlocked ? 'text-emerald-300' : 'text-gray-300'" x-text="item.unlocked ? 'Açıldı' : item.lockText"></p>
            <p class="mt-0.5 text-xs text-gray-400"><span x-text="item.users"></span> {{ kind === 'sticker' ? 'kez kullanıldı' : 'kişi kullanıyor' }}</p>

            @if(kind !== 'sticker')
              <button type="button" @click="item.unlocked ? equip(item) : null" :disabled="busy || !item.unlocked"
                      class="btn-soft mt-3 w-full max-w-[10rem]" :class="item.equipped && 'btn-green'"
                      x-text="!item.unlocked ? 'Kilitli' : item.equipped ? 'Kuşanıldı' : 'Kuşan'"></button>
            @else
              <span class="btn-soft mt-3 w-full max-w-[10rem] pointer-events-none" :class="item.unlocked && 'btn-green'" x-text="item.unlocked ? 'Kullanılabilir' : 'Kilitli'"></span>
            @end
            <button type="button" @click="tryOn(item)" class="mt-2 text-xs font-bold uppercase tracking-wide text-gray-200 hover:text-emerald-300">Dene</button>
          </div>
        </template>
      </div>
    </div>

    {{-- Try-on preview: your own comment card with the item applied --}}
    <div x-cloak x-show="trying" x-transition.opacity class="fixed inset-0 z-[85] flex items-center justify-center bg-black/75 p-4 backdrop-blur-sm" @click.self="trying = null" @keydown.escape.window="trying = null">
      <div role="dialog" aria-modal="true" aria-label="Önizleme" class="glass-strong relative w-full max-w-lg rounded-3xl border border-white/10 p-5 shadow-2xl sm:p-6">
        <button type="button" @click="trying = null" class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full text-gray-400 hover:bg-white/10 hover:text-(--t-heading)" aria-label="Kapat">
          @!component('components/icon', { name: 'x', class: 'h-5 w-5' })
        </button>
        <h2 class="text-lg font-bold text-(--t-heading)">Önizleme: <span x-text="trying && trying.name"></span></h2>
        <p class="mb-4 text-sm text-gray-400" x-text="trying && (trying.unlocked ? 'Bu öğe açık; kuşanınca yorumlarında böyle görünür.' : 'Kilidi açmak için: ' + trying.lockText)"></p>

        <template x-if="trying">
          <article class="c-card" x-data="{ get look() { return previewLook() } }">
            <template x-if="look.wallpaper"><div class="c-wall wall" :class="look.wallpaper.cls" :style="imageStyle(look.wallpaper)"></div></template>
            <div class="c-veil"></div>
            <div class="p-4">
              <div class="flex items-center gap-3">
                <span class="relative inline-flex h-12 w-12 shrink-0">
                  <span class="flex h-full w-full items-center justify-center overflow-hidden rounded-full text-lg font-bold text-(--t-heading)" :style="`background: linear-gradient(135deg, hsl(${me ? me.hue : 150} 70% 45%), hsl(${((me ? me.hue : 150) + 50) % 360} 70% 35%))`">
                    <template x-if="me && me.avatar"><img :src="me.avatar" alt="" class="h-full w-full object-cover"></template>
                    <span x-show="!me || !me.avatar" x-text="(me ? me.name : 'O').charAt(0).toUpperCase()"></span>
                  </span>
                  <template x-if="look.frame && look.frame.img"><img :src="look.frame.img" alt="" class="avatar-frame-img"></template>
                  <template x-if="look.frame && !look.frame.img"><span class="avatar-frame" :class="look.frame.cls"></span></template>
                </span>
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5">
                    <span class="presence" data-online="1"></span>
                    <span class="truncate font-bold text-(--t-heading)" :class="look.effect && look.effect.cls" :style="look.effect && look.effect.css" x-text="me ? me.name : 'Okur'"></span>
                    <span class="lv-badge" :data-tier="tierOf(me ? me.level : 1)" x-text="'Lv.' + (me ? me.level : 1)"></span>
                  </div>
                  <span class="text-xs text-gray-400">şimdi</span>
                </div>
              </div>
              <p class="mt-3 text-[15px] text-gray-100" x-show="kind !== 'sticker'">Bu bölüm efsaneydi, bir sonrakini bekliyorum!</p>
              <template x-if="kind === 'sticker'"><img :src="trying.visual.img" alt="" class="mt-3 h-32 w-32 object-contain"></template>
              <div class="mt-3 flex justify-end gap-3 text-sm text-gray-300"><span>▲ 12</span><span>▼ 0</span></div>
            </div>
          </article>
        </template>

        <div class="mt-5 flex justify-end gap-2" x-show="trying && kind !== 'sticker'">
          <button type="button" @click="trying = null" class="btn-soft">Kapat</button>
          <button type="button" x-show="trying && trying.unlocked && !trying.equipped" @click="equip(trying); trying = null" class="btn-soft btn-green">Kuşan</button>
        </div>
      </div>
    </div>
  </div>
@end

@end
