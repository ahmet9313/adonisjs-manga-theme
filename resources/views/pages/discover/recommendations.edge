@component('components/layout/main', { title })

@slot('main')
  @!component('components/breadcrumb', { items: [{ label: 'Sana Özel Öneriler' }] })
  <div class="glass rounded-3xl border border-white/10 p-5 sm:p-7">
    <h1 class="section-title">Sana Özel Öneriler</h1>
    <p class="mt-3 text-sm leading-relaxed text-gray-300">
      Bugün ne okuyacağına karar veremiyor musun? {{ site.name }}’un <strong class="text-(--t-heading)">sana özel öneriler</strong> sayfası okuma geçmişini ve kaydettiğin serilerin türlerini inceleyerek zevkine uygun yeni seriler bulur.
      @if(!(auth && auth.user))
        <button type="button" @click="$dispatch('open-auth', 'login')" class="text-emerald-300 hover:underline">Giriş yaparsan</button> öneriler sana göre kişiselleşir.
      @end
    </p>

    <div class="mt-5 flex gap-1 border-b border-white/10" role="tablist">
      <a href="/oneriler" role="tab" aria-selected="{{ tab === 'fresh' }}" class="-mb-px border-b-2 px-4 py-2.5 text-xs font-bold uppercase tracking-wide {{ tab === 'fresh' ? 'border-white text-(--t-heading)' : 'border-transparent text-gray-400 hover:text-gray-200' }}">Yeni</a>
      <a href="/oneriler?sekme=populer" role="tab" aria-selected="{{ tab === 'popular' }}" class="-mb-px border-b-2 px-4 py-2.5 text-xs font-bold uppercase tracking-wide {{ tab === 'popular' ? 'border-white text-(--t-heading)' : 'border-transparent text-gray-400 hover:text-gray-200' }}">Popüler</a>
    </div>

    @if(tab === 'fresh')
      <h2 class="mt-6 text-lg font-bold text-(--t-heading)">Sevebileceğin yeni yayınlar</h2>
      <p class="mb-4 text-sm text-gray-400">{{ fresh.personal ? 'Sık okuduğun türlerdeki yeni seriler önce gelir.' : 'En son eklenen seriler.' }}</p>
      @if(fresh.items.length)
        <div class="grid gap-2 md:grid-cols-2">
          @each(item in fresh.items)
            @!component('partials/community/series_row', { item, label: 'Son yayımlananlar' })
          @end
        </div>
      @else
        <p class="py-10 text-center text-gray-400">Okumadığın yeni bir seri kalmadı. Harikasın!</p>
      @end
    @else
      <h2 class="mt-6 text-lg font-bold text-(--t-heading)">Henüz denemediğin popüler seriler</h2>
      <p class="mb-4 text-sm text-gray-400">Okumadığın, okurların en çok takip ettiği seriler.</p>
      @if(popular.length)
        <div class="grid gap-2 md:grid-cols-2">
          @each(item in popular)
            @!component('partials/community/series_row', { item, label: 'Okurlar arasında popüler' })
          @end
        </div>
      @else
        <p class="py-10 text-center text-gray-400">Gösterilecek seri bulunamadı.</p>
      @end
    @end
  </div>
@end

@end
