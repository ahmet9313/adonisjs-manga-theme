{{--
  Recommendations (/oneriler). Tabs are links: Yeni (/oneriler, new series, favourite genres
  first) and Popüler (/oneriler?sekme=populer, most read series the visitor has not started).
  No "continue reading" block here: the popular tab must never list series the reader started.
--}}
@component('components/layout/main', { title })

@slot('main')
  @let(signedIn = Boolean(auth && auth.user))
  @let(items = tab === 'popular' ? popular : fresh.items)

  @!component('components/ui/page_header', {
    title: 'Öneriler',
    description: signedIn ? 'Okuduğun ve kaydettiğin serilere göre seçilmiş yeni ve popüler seriler.' : 'Yeni eklenen ve okurların en çok takip ettiği seriler.',
  })

  @!component('components/ui/tabs', {
    mode: 'links',
    label: 'Öneri listeleri',
    active: tab,
    tabs: [
      { key: 'fresh', label: 'Yeni', href: '/oneriler' },
      { key: 'popular', label: 'Popüler', href: '/oneriler?sekme=populer' },
    ],
  })

  @if(!signedIn)
  @component('components/ui/alert', { tone: 'accent', title: 'Öneriler sana göre şekillensin', class: 'mt-6' })
    <p>Giriş yaptığında okuduğun ve kaydettiğin serilerin türleri öne çıkar, başladığın seriler listeden düşer.</p>
    <div class="mt-3 flex flex-wrap gap-2">
      @component('components/ui/button', { variant: 'primary', size: 'sm', href: '/giris?next=' + encodeURIComponent(request.url(true)), '@click.prevent': "$dispatch('open-auth', 'login')" })
        Giriş yap
      @end
      @component('components/ui/button', { variant: 'secondary', size: 'sm', href: '/kayit', '@click.prevent': "$dispatch('open-auth', 'register')" })
        Kayıt ol
      @end
    </div>
  @end
  @end

  <section class="mt-8" aria-labelledby="discover-title">
    @if(tab === 'popular')
    @!component('components/ui/section_head', {
      id: 'discover-title',
      title: signedIn ? 'Henüz denemediğin popüler seriler' : 'Okurların en çok takip ettiği seriler',
      description: 'Okur ve kaydeden sayısına göre sıralandı.',
    })
    @else
    @!component('components/ui/section_head', {
      id: 'discover-title',
      title: 'Sevebileceğin yeni yayınlar',
      description: fresh.personal ? 'Sık okuduğun türlerdeki yeni seriler önce gelir.' : 'En son eklenen seriler.',
    })
    @end

    @if(items.length)
    <{{ tab === 'popular' ? 'ol' : 'ul' }} class="discover-list {{ tab === 'popular' ? 'discover-list--ranked' : '' }}">
      @each(item in items)
      @let(match = tab === 'fresh' ? item.genres.find((genre) => favourites.includes(genre)) : null)
      <li>
        @component('components/series/card', { series: item, layout: 'row', meta: item.chapterCount + ' bölüm', class: 'discover-card' })
          @if(item.description)
          <p class="discover-card__desc">{{ truncate(item.description, 220) }}</p>
          @end
          <div class="discover-card__foot">
            @if(tab === 'popular')
            <span class="discover-card__reason">
              @!component('components/icon', { name: 'fire', class: 'h-3.5 w-3.5' })
              Okurlar arasında popüler
            </span>
            @elseif(match)
            <span class="discover-card__reason">
              @!component('components/icon', { name: 'heart', class: 'h-3.5 w-3.5' })
              Sevdiğin tür: {{ match }}
            </span>
            @else
            <span class="discover-card__reason">
              @!component('components/icon', { name: 'sparkles', class: 'h-3.5 w-3.5' })
              Yeni eklendi
              @if(agoOf(item.createdAt))
              · {{ agoOf(item.createdAt) }}
              @end
            </span>
            @end
            <span class="discover-card__stats">
              <span title="Okuyan kişi">
                @!component('components/icon', { name: 'eye', class: 'h-4 w-4' })
                {{ item.readers.toLocaleString('tr-TR') }}<span class="sr-only"> okur</span>
              </span>
              <span title="Kaydeden kişi">
                @!component('components/icon', { name: 'bookmark', class: 'h-4 w-4' })
                {{ item.savers.toLocaleString('tr-TR') }}<span class="sr-only"> kayıt</span>
              </span>
            </span>
          </div>
        @end
      </li>
      @end
    </{{ tab === 'popular' ? 'ol' : 'ul' }}>
    @elseif(tab === 'popular')
    @component('components/ui/empty_state', { icon: 'fire', title: 'Gösterilecek seri kalmadı', description: 'Popüler serilerin hepsine başlamışsın. Seri listesinde yeni bir şey bulabilirsin.' })
      @component('components/ui/button', { variant: 'primary', href: '/seriler', iconRight: 'arrow-right' })
        Seri listesine göz at
      @end
    @end
    @else
    @component('components/ui/empty_state', { icon: 'sparkles', title: 'Okumadığın yeni bir seri kalmadı', description: 'Harikasın! Okurların en çok takip ettiği serilere de bakabilirsin.' })
      @component('components/ui/button', { variant: 'primary', href: '/oneriler?sekme=populer', iconRight: 'arrow-right' })
        Popüler seriler
      @end
    @end
    @end
  </section>
@end

@end
