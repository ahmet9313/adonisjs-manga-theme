{{--
  Reading history (/gecmis): one row per series, most recent first, grouped by recency
  (groups come from DiscoverController.history). Each row shows the last chapter read as the
  contiguous text "Bölüm N", the share of chapters read and a "Devam et" link to that chapter.
--}}
@component('components/layout/main', { title })

@slot('main')
  @let(periods = { today: 'Bugün', week: 'Son 7 gün', older: 'Daha önce' })

  @component('components/ui/page_header', {
    title: 'Okuma Geçmişi',
    description: items.length ? items.length + ' seri · kaldığın bölümden devam et.' : 'Okuduğun seriler burada listelenir.',
  })
    @slot('actions')
      @component('components/ui/button', { variant: 'secondary', href: '/kaydedilenler', icon: 'bookmark' })
        Kaydedilenler
      @end
    @end
  @end

  @if(groups.length)
    @each(group in groups)
    <section class="discover-history" aria-labelledby="history-{{ group.period }}">
      <div class="discover-history__head">
        <h2 id="history-{{ group.period }}" class="discover-history__title">{{ periods[group.period] }}</h2>
        <span class="t-caption">{{ group.items.length }} seri</span>
      </div>
      <ul class="discover-history__list">
        @each(item in group.items)
        @let(url = '/series/' + item.type + '/' + item.slug)
        @let(stamp = item.readAt.replace('Z', ''))
        @let(done = item.chapterCount > 0 && item.readCount >= item.chapterCount)
        <li class="discover-row">
          <a href="{{ url }}" class="discover-row__cover" tabindex="-1" aria-hidden="true">
            <img src="{{ item.coverImage }}" alt="" width="96" height="128" loading="lazy" decoding="async" data-fallback="/images/no-cover.svg">
          </a>
          <div class="discover-row__body">
            <h3 class="discover-row__title"><a href="{{ url }}">{{ item.title }}</a></h3>
            <p class="discover-row__meta">
              @!component('components/ui/badge', { kind: 'type', value: item.type, size: 'sm' })
              <span class="discover-row__chapter">Bölüm {{ item.lastRead }}</span>
              <span aria-hidden="true">·</span>
              <time datetime="{{ item.readAt }}" title="{{ dateOf(stamp) }}">{{ agoOf(stamp) }}</time>
            </p>
            <div class="discover-row__progress">
              @!component('components/ui/progress', {
                value: item.readCount,
                max: item.chapterCount || 1,
                size: 'sm',
                tone: done ? 'success' : 'accent',
                label: item.title + ': okunan bölümler',
                valueText: item.readCount + ' / ' + item.chapterCount + ' bölüm',
              })
              <p class="discover-row__count" data-done="{{ done ? 'true' : 'false' }}">
                @if(done)
                Hepsi okundu
                @else
                {{ item.readCount }} / {{ item.chapterCount }} bölüm
                @end
              </p>
            </div>
          </div>
          <div class="discover-row__action">
            @component('components/ui/button', { variant: done ? 'secondary' : 'primary', size: 'sm', href: url + '/' + item.lastRead, iconRight: 'arrow-right' })
              Devam et<span class="sr-only">: {{ item.title }}, Bölüm {{ item.lastRead }}</span>
            @end
          </div>
        </li>
        @end
      </ul>
    </section>
    @end
  @else
    @component('components/ui/empty_state', { icon: 'clock', title: 'Henüz bir bölüm okumadın', description: 'Okuduğun seriler burada listelenir; kaldığın bölümden tek dokunuşla devam edebilirsin.' })
      @component('components/ui/button', { variant: 'primary', href: '/seriler', iconRight: 'arrow-right' })
        Seri listesine göz at
      @end
      @component('components/ui/button', { variant: 'secondary', href: '/oneriler' })
        Öneriler
      @end
    @end
  @end
@end

@end
