@component('components/layout/main', { title })

@slot('main')
  @!component('components/breadcrumb', { items: [{ label: 'Okuma Geçmişi' }] })
  <div class="glass rounded-3xl border border-white/10 p-5 sm:p-7">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h1 class="section-title">Okuma Geçmişi</h1>
      <a href="/kaydedilenler" class="pill">
        @!component('components/icon', { name: 'bookmark', class: 'h-4 w-4' })
        Kaydedilenler
      </a>
    </div>
    <p class="mt-3 text-sm text-gray-300">Son okuduğun seriler; kaldığın bölümden devam edebilirsin.</p>

    @if(items.length)
      <ul class="mt-5 grid gap-3 md:grid-cols-2">
        @each(item in items)
          <li class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-2.5 transition hover:border-white/20">
            <a href="/series/{{ item.type }}/{{ item.slug }}" class="shrink-0">
              <img src="{{ item.coverImage }}" alt="" loading="lazy" class="h-20 w-14 rounded-lg object-cover" onerror="this.onerror=null;this.src='/images/no-cover.svg'">
            </a>
            <div class="min-w-0 flex-1">
              <a href="/series/{{ item.type }}/{{ item.slug }}" class="line-clamp-1 font-semibold text-(--t-heading) hover:text-emerald-300">{{ item.title }}</a>
              <p class="text-xs text-gray-400">{{ item.readCount }} bölüm okundu · <time datetime="{{ item.readAt }}">{{ new Date(item.readAt).toLocaleString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: site.timezone }) }}</time></p>
            </div>
            <a href="/series/{{ item.type }}/{{ item.slug }}/{{ item.lastRead }}" class="btn-soft btn-green shrink-0 !normal-case !tracking-normal">
              @!component('components/icon', { name: 'reply', class: 'h-4 w-4 rotate-180' })
              Bölüm {{ item.lastRead }}
            </a>
          </li>
        @end
      </ul>
    @else
      <p class="py-12 text-center text-gray-400">Henüz bir bölüm okumadın. <a href="/seriler" class="text-emerald-300 hover:underline">Seri listesine göz at.</a></p>
    @end
  </div>
@end

@end
