@component('components/layout/main', { title })

@slot('main')
  @!component('components/breadcrumb', { items: [{ label: 'Kartlar' }] })
  <div x-data="cardCollection" data-config="{{ JSON.stringify({ cards: collection.cards, shards: collection.shards, rules }) }}">
    <h1 class="section-title">Kartlar</h1>
    <p class="mt-2 text-sm text-gray-300">Serileri okurken karakter kartları topla. Yeni bir bölüm okuduğunda kart düşebilir; 7 günlük giriş serisi bir kart garantiler.</p>

    {{-- Shards and crafting --}}
    <section class="glass mt-6 rounded-3xl border border-white/10 p-5 sm:p-6">
      <h2 class="section-title">Kart parçaları ve üretim</h2>
      <p class="mt-2 text-sm text-gray-400">Fazladan kopyaları parçalayarak aynı nadirlikte parça elde et, sonra parçaları o nadirlikte rastgele bir karta dönüştür (eksik kartlar önceliklidir).</p>
      <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-7">
        <template x-for="rule in rules" :key="rule.rarity">
          <div class="tcg-shard flex flex-col items-center gap-1 rounded-2xl border border-white/10 bg-white/[0.04] px-2 py-3 text-center">
            <span class="font-serif text-xl font-black text-(--t-heading)" x-text="rule.rarity"></span>
            <span class="text-[11px] text-gray-400" x-text="rule.label"></span>
            <span class="text-sm text-gray-200"><span x-text="shards[rule.rarity] || 0"></span> Parça</span>
            <button type="button" @click="craft(rule.rarity)" :disabled="busy || (shards[rule.rarity] || 0) < rule.craft" class="btn-soft mt-1 !px-3 !py-1" x-text="'Üret (' + rule.craft + ')'"></button>
          </div>
        </template>
      </div>
    </section>

    {{-- Tabs --}}
    <div class="mt-8 flex flex-wrap items-center justify-between gap-3">
      <div class="flex gap-1.5" role="tablist">
        <button type="button" role="tab" @click="tab = 'all'" :aria-selected="(tab === 'all').toString()" class="pill" :class="tab === 'all' && '!bg-white !text-gray-900'">Tümü <span class="opacity-60" x-text="cards.length"></span></button>
        <button type="button" role="tab" @click="tab = 'owned'" :aria-selected="(tab === 'owned').toString()" class="pill" :class="tab === 'owned' && '!bg-white !text-gray-900'">Sahip olunan <span class="opacity-60" x-text="ownedCount()"></span></button>
        <button type="button" role="tab" @click="tab = 'missing'" :aria-selected="(tab === 'missing').toString()" class="pill" :class="tab === 'missing' && '!bg-white !text-gray-900'">Eksik <span class="opacity-60" x-text="cards.length - ownedCount()"></span></button>
      </div>
    </div>

    <p x-show="!visible().length" x-cloak class="py-12 text-center text-gray-400" x-text="cards.length ? 'Bu sekmede kart yok.' : 'Henüz kart eklenmemiş.'"></p>

    <div class="mt-5 grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
      <template x-for="card in visible()" :key="card.id">
        <div class="flex flex-col">
          <button type="button" class="tcg block w-full text-left" :data-rarity="card.rarity" :data-locked="card.count ? '0' : '1'" @click="card.count && (selected = card)" :aria-label="card.count ? card.name : 'Bilinmeyen kart'">
            <img :src="card.image" alt="" loading="lazy">
            <span class="tcg-letter" x-text="card.rarity"></span>
            <span x-show="card.count > 1" class="absolute right-1.5 top-1.5 rounded-md bg-black/80 px-1.5 text-xs font-bold text-(--t-heading)" x-text="'x' + card.count"></span>
          </button>
          <p class="mt-2 truncate text-sm font-bold text-(--t-heading)" x-text="card.count ? card.name : '???'"></p>
          <a x-show="card.series" :href="card.series && card.series.url" class="truncate text-xs text-gray-400 hover:text-emerald-300" x-text="card.series && card.series.title"></a>
          <button type="button" x-show="card.count > 1" @click="disassemble(card)" :disabled="busy" class="mt-1 self-start text-xs font-semibold text-amber-300 hover:underline" x-text="'Parçala (+' + ((card.count - 1) * rules.find(r => r.rarity === card.rarity).shards) + ')'"></button>
        </div>
      </template>
    </div>

    {{-- Card detail / craft reveal --}}
    <div x-cloak x-show="reveal || selected" x-transition.opacity class="fixed inset-0 z-[85] flex items-center justify-center bg-black/80 p-4 backdrop-blur-sm" @click.self="reveal = null; selected = null" @keydown.escape.window="reveal = null; selected = null">
      <template x-if="reveal || selected">
        <div class="w-full max-w-xs text-center" x-data="{ get card() { return reveal || selected } }">
          <p x-show="reveal" class="mb-3 text-sm font-bold uppercase tracking-widest text-amber-300">Yeni kart üretildi!</p>
          <div class="tcg mx-auto w-60" :data-rarity="card.rarity">
            <img :src="card.image" alt="">
            <span class="tcg-letter" x-text="card.rarity"></span>
          </div>
          <p class="mt-4 text-lg font-bold text-(--t-heading)" x-text="card.name"></p>
          <p class="text-sm text-gray-400" x-text="rules.find(r => r.rarity === card.rarity).label + ' · ' + card.rarity"></p>
          <button type="button" @click="reveal = null; selected = null" class="btn-soft mt-4">Kapat</button>
        </div>
      </template>
    </div>
  </div>
@end

@end
