{{--
  Catalog (/seriler).
  The filter bar is a GET form that works without JavaScript: the dropdowns are <details>, the
  sort menu is a list of links and every link keeps the other filters. Alpine `filterBar`
  (catalog.js) keeps one dropdown open at a time, closes it on Escape or an outside click, adds
  arrow keys, a genre search that ignores diacritics and clean URLs. Its initial state comes from
  `data-config`.
  Contracts (tests): "<N> seri bulundu"; author/artist chips "<span …>Yazar:</span> <name>" with
  people[].removeUrl; ids #filter-genre, #filter-status, #filter-type, #filter-sort; no
  /series/<type>/<slug> link before the result grid (sort tests read the first occurrence).
--}}
@component('components/layout/main', { title })

@slot('main')
  @let(sortOptions = [
    { value: '', label: 'Son güncellenen' },
    { value: 'newest', label: 'En yeni eklenen' },
    { value: 'views', label: 'En çok okunan' },
    { value: 'trending', label: 'Trend' },
    { value: 'rating', label: 'En yüksek puan' },
    { value: 'votes', label: 'En çok puanlanan' },
    { value: 'title', label: 'Ada göre (A–Z)' },
    { value: 'title-desc', label: 'Ada göre (Z–A)' },
  ])
  @let(currentSort = sortOptions.find((option) => option.value === filters.orderBy) || sortOptions[0])
  @let(capital = (text) => String(text).charAt(0).toLocaleUpperCase('tr-TR') + String(text).slice(1))
  @let(typeLabel = (slug) => capital((contentTypes.find((type) => type.slug === slug) || { name: slug }).name))
  {{-- Catalog URLs are built from the sanitised filters, so malformed query strings never leak into links. --}}
  @let(query = {
    search: filters.search ? [filters.search] : [],
    genre: filters.genres,
    status: filters.statuses,
    type: filters.types,
    author: filters.authors,
    artist: filters.artists,
    order: currentSort.value ? [currentSort.value] : [],
  })
  @let(urlWith = (changes) => ((text) => text ? '/seriler?' + text : '/seriler')(new URLSearchParams(Object.entries(Object.assign({}, query, changes)).flatMap((entry) => entry[1].map((value) => [entry[0], value]))).toString()))
  @let(without = (key, value) => urlWith({ [key]: query[key].filter((item) => item !== value) }))
  @let(clearUrl = urlWith({ search: [], genre: [], status: [], type: [], author: [], artist: [] }))
  @let(hasFilters = Boolean(filters.search) || filters.genres.length + filters.statuses.length + filters.types.length + filters.authors.length + filters.artists.length > 0)
  @let(missingPeople = [
    ...filters.authors.filter((slug) => !people.some((person) => person.field === 'author' && person.slug === slug)).map((slug) => ({ label: 'Yazar', name: slug, href: without('author', slug) })),
    ...filters.artists.filter((slug) => !people.some((person) => person.field === 'artist' && person.slug === slug)).map((slug) => ({ label: 'Sanatçı', name: slug, href: without('artist', slug) })),
  ])
  @let(chips = [
    ...filters.genres.map((genre) => ({ label: 'Tür', name: genre, href: without('genre', genre) })),
    ...filters.statuses.map((status) => ({ label: 'Durum', name: status, href: without('status', status) })),
    ...filters.types.map((type) => ({ label: 'İçerik türü', name: typeLabel(type), href: without('type', type) })),
  ])
  @let(config = {
    genres: filters.genres,
    statuses: filters.statuses,
    types: filters.types,
    order: currentSort.value,
    sorts: Object.fromEntries(sortOptions.map((option) => [option.value, option.label])),
  })

  @!component('components/ui/page_header', {
    title: 'Seriler',
    description: Number(totalResults || 0).toLocaleString('tr-TR') + ' seri bulundu' + (totalPages > 1 && results.length ? ' · Sayfa ' + currentPage + ' / ' + totalPages : ''),
  })

  <form method="GET" action="/seriler" role="search" aria-label="Serileri ara ve filtrele" class="catalog-filters"
        x-data="filterBar()" data-config="{{ JSON.stringify(config) }}"
        @submit.prevent="submit()" @keydown.escape="onEscape($event)" @keydown="onKeydown($event)">
    @each(person in people)
    <input type="hidden" name="{{ person.field }}" value="{{ person.slug }}">
    @end
    @if(currentSort.value)
    <input type="hidden" name="order" value="{{ currentSort.value }}">
    @end

    <div class="catalog-toolbar">
      <div class="control control--icon catalog-search">
        <label for="catalog-search" class="sr-only">Seri ara</label>
        @!component('components/icon', { name: 'search' })
        <input type="search" id="catalog-search" name="search" value="{{ filters.search }}" maxlength="200"
               placeholder="Seri adı veya alternatif başlık" autocomplete="off" enterkeyhint="search">
        <button type="submit" class="btn btn--primary btn--sm catalog-search__submit">Ara</button>
      </div>

      <div class="catalog-toolbar__filters">
        {{-- Tür (genre): multiple choice with its own search box. --}}
        <details class="catalog-filter" data-menu="openGenre" :open="openGenre" @toggle="sync('openGenre', $el.open)" @click.outside="openGenre = false">
          <summary class="catalog-filter__trigger" data-active="{{ filters.genres.length ? 'true' : 'false' }}" :data-active="String(selectedGenres.length > 0)">
            @!component('components/icon', { name: 'tag', class: 'catalog-filter__icon' })
            <span class="catalog-filter__name">Tür</span>
            <span class="count" x-show="selectedGenres.length"
              @if(!filters.genres.length)
              style="display: none"
              @end
              ><span x-text="selectedGenres.length">{{ filters.genres.length }}</span><span class="sr-only"> seçili</span></span>
            @!component('components/icon', { name: 'chevron-down', class: 'catalog-filter__chevron' })
          </summary>
          <div id="filter-genre" class="catalog-filter__panel catalog-filter__panel--wide">
            <div class="catalog-filter__search" x-cloak>
              <div class="control control--sm control--icon">
                @!component('components/icon', { name: 'search' })
                <input type="search" x-model="genreSearch" aria-label="Türlerde ara" placeholder="Tür ara" autocomplete="off" @keydown.enter.prevent>
              </div>
            </div>
            <div role="group" aria-label="Türler" class="catalog-filter__options catalog-filter__options--grid">
              @each(genre in genres)
              <label class="catalog-option" data-genre="{{ genre }}" x-show="genreMatches($el.dataset.genre)">
                <input type="checkbox" name="genre" value="{{ genre }}" x-model="selectedGenres" {{ filters.genres.includes(genre) ? 'checked' : '' }}>
                <span>{{ genre }}</span>
              </label>
              @end
            </div>
            <p class="catalog-filter__empty" x-cloak x-show="!hasGenreMatch()">Eşleşen tür yok.</p>
            <div class="catalog-filter__foot">
              <span class="catalog-filter__picked" x-cloak x-show="selectedGenres.length"><span x-text="selectedGenres.length"></span> seçili</span>
              <button type="button" class="btn btn--ghost btn--sm" x-cloak @click="selectedGenres = []" :disabled="!selectedGenres.length">Temizle</button>
              <button type="submit" class="btn btn--primary btn--sm">Uygula</button>
            </div>
          </div>
        </details>

        {{-- Durum (status) --}}
        <details class="catalog-filter" data-menu="openStatus" :open="openStatus" @toggle="sync('openStatus', $el.open)" @click.outside="openStatus = false">
          <summary class="catalog-filter__trigger" data-active="{{ filters.statuses.length ? 'true' : 'false' }}" :data-active="String(selectedStatuses.length > 0)">
            @!component('components/icon', { name: 'clock', class: 'catalog-filter__icon' })
            <span class="catalog-filter__name">Durum</span>
            <span class="count" x-show="selectedStatuses.length"
              @if(!filters.statuses.length)
              style="display: none"
              @end
              ><span x-text="selectedStatuses.length">{{ filters.statuses.length }}</span><span class="sr-only"> seçili</span></span>
            @!component('components/icon', { name: 'chevron-down', class: 'catalog-filter__chevron' })
          </summary>
          <div id="filter-status" class="catalog-filter__panel">
            <div role="group" aria-label="Yayın durumu" class="catalog-filter__options">
              @each(status in site.statuses)
              <label class="catalog-option">
                <input type="checkbox" name="status" value="{{ status }}" x-model="selectedStatuses" {{ filters.statuses.includes(status) ? 'checked' : '' }}>
                <span class="badge catalog-option__dot" data-tone="{{ badgeTone('status', status) }}" aria-hidden="true"></span>
                <span>{{ status }}</span>
              </label>
              @end
            </div>
            <div class="catalog-filter__foot">
              <button type="button" class="btn btn--ghost btn--sm" x-cloak @click="selectedStatuses = []" :disabled="!selectedStatuses.length">Temizle</button>
              <button type="submit" class="btn btn--primary btn--sm">Uygula</button>
            </div>
          </div>
        </details>

        {{-- İçerik türü (content type) --}}
        <details class="catalog-filter" data-menu="openType" :open="openType" @toggle="sync('openType', $el.open)" @click.outside="openType = false">
          <summary class="catalog-filter__trigger" data-active="{{ filters.types.length ? 'true' : 'false' }}" :data-active="String(selectedTypes.length > 0)">
            @!component('components/icon', { name: 'book-open', class: 'catalog-filter__icon' })
            <span class="catalog-filter__name">İçerik türü</span>
            <span class="count" x-show="selectedTypes.length"
              @if(!filters.types.length)
              style="display: none"
              @end
              ><span x-text="selectedTypes.length">{{ filters.types.length }}</span><span class="sr-only"> seçili</span></span>
            @!component('components/icon', { name: 'chevron-down', class: 'catalog-filter__chevron' })
          </summary>
          <div id="filter-type" class="catalog-filter__panel">
            <div role="group" aria-label="İçerik türü" class="catalog-filter__options">
              @each(type in contentTypes)
              <label class="catalog-option">
                <input type="checkbox" name="type" value="{{ type.slug }}" x-model="selectedTypes" {{ filters.types.includes(type.slug) ? 'checked' : '' }}>
                <span class="badge catalog-option__dot" data-tone="{{ badgeTone('type', type.slug) }}" aria-hidden="true"></span>
                <span>{{ capital(type.name) }}</span>
              </label>
              @end
            </div>
            <div class="catalog-filter__foot">
              <button type="button" class="btn btn--ghost btn--sm" x-cloak @click="selectedTypes = []" :disabled="!selectedTypes.length">Temizle</button>
              <button type="submit" class="btn btn--primary btn--sm">Uygula</button>
            </div>
          </div>
        </details>

        {{-- Sırala: links, so a choice applies at once and keeps the other filters. --}}
        <details class="catalog-filter" data-menu="openSort" :open="openSort" @toggle="sync('openSort', $el.open)" @click.outside="openSort = false">
          <summary class="catalog-filter__trigger">
            @!component('components/icon', { name: 'sort', class: 'catalog-filter__icon' })
            <span class="sr-only">Sıralama:</span>
            <span class="catalog-filter__name">{{ currentSort.label }}</span>
            @!component('components/icon', { name: 'chevron-down', class: 'catalog-filter__chevron' })
          </summary>
          <div id="filter-sort" class="catalog-filter__panel catalog-filter__panel--end">
            <p class="menu__label">Sırala</p>
            <ul class="catalog-sort">
              @each(option in sortOptions)
              <li>
                <a href="{{ urlWith({ order: option.value ? [option.value] : [] }) }}" class="menu__item" {{ option.value === currentSort.value ? 'aria-current=page' : '' }}>
                  @if(option.value === currentSort.value)
                  @!component('components/icon', { name: 'check', class: 'catalog-sort__check' })
                  @else
                  <span class="catalog-sort__check" aria-hidden="true"></span>
                  @end
                  {{ option.label }}
                </a>
              </li>
              @end
            </ul>
          </div>
        </details>
      </div>
    </div>

    @if(hasFilters)
    <div class="catalog-chips">
      <p class="t-overline">Etkin filtreler</p>
      <ul class="catalog-chips__list">
        @if(filters.search)
        <li>
          <a href="{{ urlWith({ search: [] }) }}" class="chip catalog-chip">
            <span class="catalog-chip__key">Arama:</span> “{{ truncate(filters.search, 40) }}”
            <span class="chip__remove" aria-hidden="true">
              @!component('components/icon', { name: 'x', class: 'h-3.5 w-3.5' })
            </span>
            <span class="sr-only">filtresini kaldır</span>
          </a>
        </li>
        @end
        @each(person in people)
        <li>
          <a href="{{ person.removeUrl }}" class="chip catalog-chip">
            <span class="catalog-chip__key">{{ person.label }}:</span> {{ person.name }}
            <span class="chip__remove" aria-hidden="true">
              @!component('components/icon', { name: 'x', class: 'h-3.5 w-3.5' })
            </span>
            <span class="sr-only">filtresini kaldır</span>
          </a>
        </li>
        @end
        @each(chip in [...missingPeople, ...chips])
        <li>
          <a href="{{ chip.href }}" class="chip catalog-chip">
            <span class="catalog-chip__key">{{ chip.label }}:</span> {{ chip.name }}
            <span class="chip__remove" aria-hidden="true">
              @!component('components/icon', { name: 'x', class: 'h-3.5 w-3.5' })
            </span>
            <span class="sr-only">filtresini kaldır</span>
          </a>
        </li>
        @end
      </ul>
      @component('components/ui/button', { variant: 'ghost', size: 'sm', href: clearUrl, icon: 'x' })
        Filtreleri sıfırla
      @end
    </div>
    @end
  </form>

  <section class="catalog-results" aria-labelledby="catalog-results-title">
    <h2 id="catalog-results-title" class="sr-only">Sonuçlar</h2>
    @if(results.length)
    <div class="series-grid">
      @each((item, index) in results)
      @!component('components/series/card', { series: item, priority: index < 6, meta: currentSort.value === 'views' && item.viewCount ? countOf(item.viewCount) + ' görüntülenme' : '' })
      @end
    </div>
    @!component('components/ui/pagination', { current: currentPage, total: totalPages, label: 'Seri listesi sayfaları', class: 'mt-10' })
    @elseif(totalResults > 0)
    @component('components/ui/empty_state', { icon: 'book-open', title: 'Bu sayfada seri yok', description: 'Liste ' + totalPages + ' sayfa sürüyor. İlk sayfadan devam edebilirsin.' })
      @component('components/ui/button', { variant: 'primary', href: urlWith({}), icon: 'arrow-left' })
        İlk sayfaya dön
      @end
    @end
    @elseif(hasFilters)
    @component('components/ui/empty_state', { icon: 'search', title: filters.search ? '“' + truncate(filters.search, 40) + '” için sonuç yok' : 'Bu filtrelere uyan seri yok', description: 'Filtrelerden birkaçını kaldırmayı ya da farklı bir arama yapmayı dene.' })
      @component('components/ui/button', { variant: 'primary', href: clearUrl, icon: 'refresh' })
        Filtreleri sıfırla
      @end
      @component('components/ui/button', { variant: 'secondary', href: '/oneriler' })
        Önerilere göz at
      @end
    @end
    @else
    @!component('components/ui/empty_state', { icon: 'library', title: 'Henüz seri yok', description: 'Yeni seriler eklendiğinde burada listelenecek.' })
    @end
  </section>
@end

@end
