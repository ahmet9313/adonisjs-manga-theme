{{--
  Public member profile (/uye/<kullanıcı>), AccountController.show.
  Hero (banner, avatar, name, actions) over the full width, then the summary column (level and
  statistics, equipped cosmetics, badges) beside the "Son etkinlik" tabs (comments, reviews,
  card showcase, collection). On small screens the summary comes first.
  Cosmetic classes (fx-*, frame-*, wall-*, tcg, lv-badge) are content and keep their own look.
--}}
@let(look = lookOf(member))
@let(progress = levelOf(member))
@let(owned = inventory.frame.length + inventory.effect.length + inventory.wallpaper.length + inventory.sticker.length)
@let(fmt = (value) => Number(value || 0).toLocaleString('tr-TR'))
@component('components/layout/main', { title, description: member.bio || site.description })

@slot('main')
  @include('partials/profile/hero')

  <div class="profile-layout">
    @include('partials/profile/summary')
    @include('partials/profile/activity')
  </div>
@end

@end
