{{--
  Settings (/ayarlar). Hooks: profileSettings (profile_settings.js) with data-config, the hash
  tabs #profile / #account / #security, [data-user-avatar] and [data-user-banner] (updated live
  after an upload), $refs.file / stage / img, and the /ayarlar/* endpoints.
  A failed form opens its own tab: the account form flashes `email`, the password form only
  `current_password` (passwords are never flashed).
--}}
@component('components/layout/main', { title })

@slot('main')
  @let(look = lookOf(member))
  @let(failed = flashMessages.has('inputErrorsBag'))
  @let(initialTab = flashMessages.has('email') ? 'account' : (flashMessages.has('inputErrorsBag.current_password') || flashMessages.has('inputErrorsBag.password') || flashMessages.has('inputErrorsBag.password_confirmation')) ? 'security' : 'profile')
  @let(nameValue = flashMessages.has('full_name') ? String(flashMessages.get('full_name') || '') : member.fullName)
  @let(bioValue = flashMessages.has('bio') ? String(flashMessages.get('bio') || '') : (member.bio || ''))
  @let(sections = [{ key: 'profile', label: 'Profil', icon: 'user' }, { key: 'account', label: 'Hesap', icon: 'mail' }, { key: 'security', label: 'Güvenlik', icon: 'lock' }])
  <div class="settings" x-data="profileSettings"
       data-config="{{ JSON.stringify({ csrf: csrfToken, avatar: member.avatar, banner: member.banner, name: nameValue, username: member.username, bio: bioValue, tab: initialTab, errors: failed }) }}">
    @!component('components/ui/page_header', { title: 'Ayarlar', description: 'Profilini, hesap bilgilerini ve parolanı buradan yönet.' })

    <div class="settings__layout">
      {{-- Section tabs: a row on phones and tablets, a vertical list from lg. --}}
      <div role="tablist" aria-label="Ayar bölümleri" class="tabs settings-tabs" aria-orientation="horizontal" :aria-orientation="vertical ? 'vertical' : 'horizontal'" @keydown="onTabKey($event)">
        @each(section in sections)
        <button type="button" role="tab" id="settings-tab-{{ section.key }}" data-tab="{{ section.key }}" aria-controls="settings-panel-{{ section.key }}"
                aria-selected="{{ section.key === initialTab ? 'true' : 'false' }}" tabindex="{{ section.key === initialTab ? 0 : -1 }}"
                :aria-selected="(tab === '{{ section.key }}').toString()" :tabindex="tab === '{{ section.key }}' ? 0 : -1"
                @click="select('{{ section.key }}')" class="tab">
          @!component('components/icon', { name: section.icon })
          <span>{{ section.label }}</span>
        </button>
        @end
      </div>

      <div class="min-w-0">
        {{-- Profile: live card (avatar and cover change at once) and the name/bio form --}}
        <div role="tabpanel" id="settings-panel-profile" aria-labelledby="settings-tab-profile" class="settings-panel" :hidden="tab !== 'profile'"
          @if(initialTab !== 'profile')
          hidden
          @end
          >
          <section class="profile-card" aria-labelledby="profile-card-title">
            <h2 id="profile-card-title" class="sr-only">Profil kartı önizlemesi</h2>
            @if(look.wallpaper)
            <div class="profile-card__wall wall {{ look.wallpaper.cls || '' }}" style="{{ visualStyle(look.wallpaper) }}" aria-hidden="true"></div>
            @end

            <div class="profile-card__banner" data-art="{{ look.wallpaper ? 'wall' : 'plain' }}">
              <img data-user-banner alt="" width="1500" height="500" decoding="async" class="{{ member.banner ? '' : 'hidden' }}"
                @if(member.banner)
                src="{{ member.banner }}"
                @end
                >
            </div>
            <div class="profile-card__cover">
              @component('components/ui/dropdown', { id: 'cover-menu', label: 'Kapağı değiştir', icon: 'camera', align: 'right', width: 'w-60', buttonClass: 'btn btn--sm max-sm:h-10 profile-card__cover-btn' })
                <button type="button" class="menu__item" @click="close(true); pick('banner')">
                  @!component('components/icon', { name: 'upload' })
                  Yeni kapak görseli yükle
                </button>
                <button type="button" class="menu__item menu__item--danger" x-cloak x-show="banner" :disabled="removing === 'banner'" @click="close(true); remove('banner')">
                  @!component('components/icon', { name: 'trash' })
                  Kapak görselini kaldır
                </button>
              @end
            </div>

            <div class="profile-card__body {{ look.wallpaper ? 'wall-veil' : '' }}">
              <div class="profile-card__avatar">
                @component('components/ui/dropdown', { id: 'avatar-menu', label: 'Profil resmini değiştir', iconOnly: true, width: 'w-60', buttonClass: 'profile-card__avatar-btn' })
                  @slot('trigger')
                    @!component('components/avatar', { user: member, size: 'h-20 w-20 sm:h-24 sm:w-24', text: 'text-3xl sm:text-4xl', frame: look.frame })
                    <span class="profile-card__avatar-badge" aria-hidden="true">
                      @!component('components/icon', { name: 'camera', class: 'h-4 w-4' })
                    </span>
                  @end
                  <button type="button" class="menu__item" @click="close(true); pick('avatar')">
                    @!component('components/icon', { name: 'upload' })
                    Yeni profil resmi yükle
                  </button>
                  <button type="button" class="menu__item menu__item--danger" x-cloak x-show="avatar" :disabled="removing === 'avatar'" @click="close(true); remove('avatar')">
                    @!component('components/icon', { name: 'trash' })
                    Profil resmini kaldır
                  </button>
                @end
              </div>

              <div class="profile-card__actions">
                @component('components/ui/button', { variant: 'secondary', href: '/uye/' + member.username, icon: 'user', class: 'profile-card__action' })
                  <span class="max-sm:sr-only">Profilini gör</span>
                @end
                @component('components/ui/button', { variant: 'secondary', icon: 'archive', class: 'profile-card__action', '@click': "$dispatch('open-inventory', 'frame')" })
                  <span class="max-sm:sr-only">Envanter</span>
                @end
              </div>

              <div class="profile-card__identity">
                <p class="profile-card__title">
                  <span class="profile-card__name {{ look.effect && look.effect.cls ? look.effect.cls : '' }}" style="{{ visualStyle(look.effect) }}" x-text="name.trim() || username">{{ nameValue }}</span>
                  @!component('components/level_badge', { level: member.level })
                  @if(member.role !== 'member')
                  @!component('components/role_badge', { user: member })
                  @end
                </p>
                <p class="profile-card__handle">&#64;{{ member.username }}</p>
                <p class="profile-card__bio" x-show="bio.trim()" x-text="bio">{{ bioValue }}</p>
                <p class="profile-card__bio profile-card__bio--empty" x-cloak x-show="!bio.trim()">Henüz bir tanıtım yazın yok. Aşağıdaki Hakkında alanına yazdıkların burada görünür.</p>
              </div>
            </div>
          </section>
          <p class="settings-note">
            @!component('components/icon', { name: 'info' })
            <span>Profil resmi ve kapak görseli seçtiğin anda kaydedilir. Görünen ad ve hakkında yazısı için formu kaydet.</span>
          </p>

          <form action="/ayarlar/profil" method="POST" class="panel panel--flush settings-form" aria-labelledby="profile-form-title" data-submit-once @submit="rememberTab()">
            {{ csrfField() }}
            <div class="settings-form__body">
              <div class="panel__head">
                <div class="min-w-0">
                  <h2 id="profile-form-title" class="panel__title">Profil bilgileri</h2>
                  <p class="panel__desc">Herkese açık profilinde, yorumlarında ve incelemelerinde görünür.</p>
                </div>
              </div>
              <div class="settings-form__fields">
                @!component('components/ui/field', { name: 'full_name', id: 'full_name', label: 'Görünen ad', value: nameValue, required: true, minlength: 2, maxlength: 40, autocomplete: 'nickname', 'x-model': 'name', hint: '2–40 karakter. Kullanıcı adın (@' + member.username + ') değişmez.' })
                <div class="relative">
                  @!component('components/ui/field', { name: 'bio', id: 'bio', type: 'textarea', label: 'Hakkında', value: bioValue, rows: 4, maxlength: 300, 'x-model': 'bio', placeholder: 'Sevdiğin türler, favori serilerin, okuma alışkanlıkların…', hint: 'En fazla 300 karakter. Satır sonları korunur.' })
                  <span class="settings-counter t-num" aria-hidden="true" x-text="bio.length + ' / 300'">{{ bioValue.length }} / 300</span>
                </div>
              </div>
            </div>
            <div class="settings-form__foot">
              <p class="t-caption">Değişiklikler kaydettiğinde yayınlanır.</p>
              <button type="submit" class="btn btn--primary btn--md">Kaydet</button>
            </div>
          </form>
        </div>

        {{-- Account: e-mail address --}}
        <div role="tabpanel" id="settings-panel-account" aria-labelledby="settings-tab-account" class="settings-panel" :hidden="tab !== 'account'"
          @if(initialTab !== 'account')
          hidden
          @end
          >
          <form action="/ayarlar/hesap" method="POST" class="panel panel--flush settings-form" aria-labelledby="account-form-title" data-submit-once @submit="rememberTab()">
            {{ csrfField() }}
            <div class="settings-form__body">
              <div class="panel__head">
                <div class="min-w-0">
                  <h2 id="account-form-title" class="panel__title">Hesap bilgileri</h2>
                  <p class="panel__desc">Giriş yaparken kullanıcı adını ya da e-posta adresini kullanabilirsin.</p>
                </div>
              </div>
              <div class="settings-form__fields">
                @!component('components/ui/field', { name: 'username', id: 'account-username', label: 'Kullanıcı adı', value: member.username, disabled: true, hint: 'Kullanıcı adı değiştirilemez. Profil adresin: /uye/' + member.username })
                @!component('components/ui/field', { name: 'email', id: 'account-email', type: 'email', label: 'E-posta adresi', value: member.email, required: true, maxlength: 255, autocomplete: 'email', spellcheck: 'false' })
                @!component('components/auth/password', { id: 'account-current', name: 'current_password', label: 'Mevcut parola', autocomplete: 'current-password', hint: 'E-posta adresini değiştirmek için mevcut parolanı gir.' })
              </div>
            </div>
            <div class="settings-form__foot">
              <p class="t-caption">Bildirimler ve giriş için bu adres kullanılır.</p>
              <button type="submit" class="btn btn--primary btn--md">E-postayı güncelle</button>
            </div>
          </form>
        </div>

        {{-- Security: password --}}
        <div role="tabpanel" id="settings-panel-security" aria-labelledby="settings-tab-security" class="settings-panel" :hidden="tab !== 'security'"
          @if(initialTab !== 'security')
          hidden
          @end
          >
          <form action="/ayarlar/parola" method="POST" class="panel panel--flush settings-form" aria-labelledby="security-form-title" data-submit-once @submit="rememberTab()">
            {{ csrfField() }}
            <div class="settings-form__body">
              <div class="panel__head">
                <div class="min-w-0">
                  <h2 id="security-form-title" class="panel__title">Parolayı değiştir</h2>
                  <p class="panel__desc">Başka sitelerde kullanmadığın, en az 8 karakterli bir parola seç.</p>
                </div>
              </div>
              <div class="settings-form__fields">
                @!component('components/auth/password', { id: 'security-current', name: 'current_password', label: 'Mevcut parola', autocomplete: 'current-password' })
                @!component('components/auth/password', { id: 'security-new', name: 'password', label: 'Yeni parola', autocomplete: 'new-password', minlength: 8, hint: 'En az 8 karakter. Harf, rakam ve sembolleri karıştırmak parolanı güçlendirir.' })
                @!component('components/auth/password', { id: 'security-confirm', name: 'password_confirmation', label: 'Yeni parola (tekrar)', autocomplete: 'new-password' })
              </div>
            </div>
            <div class="settings-form__foot">
              <p class="t-caption">Parolan değiştikten sonra bu cihazda oturumun açık kalır.</p>
              <button type="submit" class="btn btn--primary btn--md">Parolayı değiştir</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <input type="file" x-ref="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="hidden" tabindex="-1" aria-hidden="true" @change="chosen($event)">

    {{-- Crop dialog: drag, wheel or the slider; arrow keys move the image, + / − zoom, 0 resets. --}}
    @component('components/ui/modal', { id: 'crop', title: 'Görseli düzenle', titleExpr: "editor.kind === 'avatar' ? 'Profil resmini düzenle' : 'Kapak görselini düzenle'", description: 'Sürükleyerek ya da ok tuşlarıyla konumlandır; fare tekeri, kaydırıcı veya + / − tuşlarıyla yakınlaştır, 0 ile baştan al.', size: 'md', open: 'editor.open', close: 'closeEditor()' })
      <div class="crop">
        <div x-ref="stage" class="crop__stage" tabindex="0" data-autofocus role="application" aria-roledescription="kırpma alanı" aria-label="Görselin konumu" aria-describedby="crop-desc"
             :class="{ 'is-dragging': dragging }" :style="`width:${frame.w}px;height:${frame.h}px`"
             @pointerdown="dragStart($event)" @pointermove="dragMove($event)" @pointerup="dragEnd()" @pointercancel="dragEnd()" @lostpointercapture="dragEnd()"
             @wheel.prevent="wheel($event)" @keydown="onCropKey($event)">
          <img x-ref="img" :src="editor.src || null" alt="" draggable="false" class="crop__img"
               :style="`width:${view.nw * view.scale}px;height:${view.nh * view.scale}px;left:${view.x}px;top:${view.y}px`">
          <span class="crop__mask" :class="{ 'crop__mask--round': editor.kind === 'avatar' }" aria-hidden="true"></span>
        </div>
      </div>
      <div class="crop__zoom">
        <button type="button" class="btn btn--ghost btn--sm btn--icon" @click="zoomOut()" :disabled="view.zoom <= 1" aria-label="Uzaklaştır">
          @!component('components/icon', { name: 'minus', class: 'btn__icon' })
        </button>
        <input type="range" min="1" max="4" step="0.01" class="crop__range" :value="view.zoom" @input="zoom(Number($event.target.value))"
               aria-label="Yakınlaştırma" :aria-valuetext="'%' + Math.round(view.zoom * 100)">
        <button type="button" class="btn btn--ghost btn--sm btn--icon" @click="zoomIn()" :disabled="view.zoom >= 4" aria-label="Yakınlaştır">
          @!component('components/icon', { name: 'plus', class: 'btn__icon' })
        </button>
      </div>
      <p x-cloak x-show="editor.error" x-text="editor.error" role="alert" class="field__error mt-3 text-center"></p>
      @slot('footer')
        <button type="button" class="btn btn--ghost btn--md mr-auto" @click="reset()" :disabled="editor.busy">
          @!component('components/icon', { name: 'refresh', class: 'btn__icon' })
          <span>Sıfırla</span>
        </button>
        <button type="button" class="btn btn--secondary btn--md" @click="closeEditor()" :disabled="editor.busy">Vazgeç</button>
        <button type="button" class="btn btn--primary btn--md" @click="apply()" :disabled="editor.busy" aria-busy="false" :aria-busy="editor.busy.toString()">
          <span x-text="editor.busy ? 'Yükleniyor…' : 'Kaydet'">Kaydet</span>
        </button>
      @end
    @end
  </div>
@end

@end
