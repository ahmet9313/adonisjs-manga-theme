{{--
  Admin → Topluluk → Kozmetikler: kind tabs with item counts, a card grid that previews every
  item as it looks when equipped (components/ui/cosmetic_preview), its status and unlock rule,
  and edit / gift / delete actions. Gifting happens on the edit page (#hediye).
--}}
@let(number = (value) => Number(value || 0).toLocaleString('tr-TR'))
@let(kindOf = Object.fromEntries(kinds.map((entry) => [entry.name, entry])))
@let(current = kind ? kindOf[kind] : null)
@let(tabs = [{ key: 'all', label: 'Tümü', count: number(total), href: '/admin/kozmetikler' }].concat(kinds.map((entry) => ({ key: entry.name, label: entry.plural, count: number(counts[entry.name]), href: '/admin/kozmetikler?tur=' + entry.name }))))
@let(first = items.total ? (items.currentPage - 1) * items.perPage + 1 : 0)
@let(last = Math.min(items.currentPage * items.perPage, items.total))
@let(unit = current ? current.label.toLocaleLowerCase('tr') : 'öğe')
@component('components/layout/admin', { title, description: 'Satış yok: öğeler seviye, rozet ya da yönetici hediyesiyle açılır. Kartlarda her öğe kuşanılmış hâliyle görünür.' })
  @slot('actions')
    @component('components/ui/button', { variant: 'primary', href: '/admin/kozmetikler/ekle' + (kind ? '?tur=' + kind : ''), icon: 'plus' })
      Yeni kozmetik
    @end
  @end

  @slot('main')
    <div class="ac-page">
      @!component('components/ui/tabs', { mode: 'links', tabs, active: kind || 'all', label: 'Kozmetik türleri' })

      @if(items.total)
      <p class="ac-summary">
        <span><strong>{{ number(items.total) }}</strong> {{ unit }}</span>
        <span aria-hidden="true">·</span>
        <span>{{ current ? 'sıra numarasına göre' : 'türe ve sıra numarasına göre' }}</span>
      </p>

      <ul class="ac-grid" aria-label="{{ current ? current.plural : 'Kozmetikler' }}">
        @each(item in items)
        @let(look = visual(item))
        @let(editUrl = '/admin/kozmetikler/' + item.id + '/duzenle')
        @let(lockIcon = item.grantOnly ? 'gift' : item.requiredBadge ? 'badge' : 'lock')
        @let(deleteMessage = '“' + item.name + '” kalıcı olarak silinecek. ' + (item.kind === 'sticker' ? 'Bu çıkartmayla gönderilen yorumlardan kaldırılır' : 'Kuşanan üyelerin profilinden çıkarılır') + ' ve hediye kayıtları da silinir. Bu işlem geri alınamaz.')
        <li class="ac-item {{ item.active ? '' : 'is-off' }}">
          <a href="{{ editUrl }}" class="ac-item__stage" tabindex="-1" aria-hidden="true">
            @!component('components/ui/cosmetic_preview', { kind: item.kind, visual: look, user: auth.user, size: 'lg' })
          </a>
          <div class="ac-item__body">
            <a href="{{ editUrl }}" class="ac-item__name">{{ item.name }}</a>
            <p class="ac-item__meta">
              @if(!current)
              <span>{{ kindOf[item.kind].label }}</span>
              <span aria-hidden="true">·</span>
              @end
              <span class="ac-lock">
                @!component('components/icon', { name: lockIcon })
                {{ lockText(item) }}
              </span>
            </p>
            <p class="ac-item__badges">
              @if(item.active)
              @!component('components/ui/badge', { kind: 'success', text: 'Aktif', size: 'sm' })
              @else
              @!component('components/ui/badge', { kind: 'neutral', text: 'Gizli', size: 'sm', title: 'Koleksiyonda ve envanterde görünmez' })
              @end
              @if(item.featured)
              @!component('components/ui/badge', { kind: 'accent', text: 'Öne çıkan', size: 'sm' })
              @end
            </p>
          </div>
          <div class="ac-actions ac-item__actions">
            @!component('components/ui/button', { variant: 'ghost', size: 'sm', icon: 'pencil', href: editUrl, label: 'Düzenle: ' + item.name, title: 'Düzenle' })
            @!component('components/ui/button', { variant: 'ghost', size: 'sm', icon: 'gift', href: editUrl + '#hediye', label: 'Hediye et: ' + item.name, title: 'Hediye et' })
            <form action="/admin/kozmetikler/{{ item.id }}/sil" method="POST" data-submit-once
                  data-confirm="{{ deleteMessage }}" data-confirm-title="Kozmetik silinsin mi?" data-confirm-label="Kalıcı olarak sil">
              {{ csrfField() }}
              @!component('components/ui/button', { type: 'submit', variant: 'ghost', size: 'sm', icon: 'trash', label: 'Sil: ' + item.name, title: 'Sil', class: 'ac-danger' })
            </form>
          </div>
        </li>
        @end
      </ul>

      <div class="ac-listfoot">
        <p class="ac-listfoot__info">{{ number(first) }}–{{ number(last) }} / {{ number(items.total) }} {{ unit }}</p>
        @!component('components/ui/pagination', { current: items.currentPage, total: items.lastPage, label: 'Kozmetik sayfaları' })
      </div>
      @else
      @component('components/ui/empty_state', { icon: 'sparkles', title: current ? 'Bu türde öğe yok' : 'Henüz kozmetik yok', description: current ? 'Bu türdeki ilk öğeyi ekleyin; seviye, rozet ya da hediyeyle açılmasını seçebilirsiniz.' : 'Ad efektleri, avatar çerçeveleri, duvar kağıtları ve çıkartmalar ekleyin.', class: 'mt-6' })
        @component('components/ui/button', { variant: 'primary', href: '/admin/kozmetikler/ekle' + (kind ? '?tur=' + kind : ''), icon: 'plus' })
          Yeni kozmetik
        @end
      @end
      @end
    </div>
  @end
@end
