{{--
  Admin → Topluluk → Kartlar: rarity filter (F Sıradan … R Kalıntı, with counts), the collectible
  card grid (.tcg, cosmetics.css — the look is content and stays unchanged), the series of each
  card and edit / delete actions. "Seri kapaklarından oluştur" makes one card per series that has
  a cover and no card yet (POST /admin/kartlar/seri-kapaklari).
--}}
@let(number = (value) => Number(value || 0).toLocaleString('tr-TR'))
@let(current = rarity ? rarities.find((entry) => entry.rarity === rarity) : null)
@let(first = items.total ? (items.currentPage - 1) * items.perPage + 1 : 0)
@let(last = Math.min(items.currentPage * items.perPage, items.total))
@component('components/layout/admin', { title, description: 'Okurlar yeni bölüm okurken ve 7 günlük giriş serisinde kart kazanır; kopyalar parçalanıp yeni kartlara dönüşür.' })
  @slot('actions')
    @if(missingSeries)
    <form action="/admin/kartlar/seri-kapaklari" method="POST" data-submit-once
          data-confirm="Kartı olmayan {{ number(missingSeries) }} serinin kapağından birer kart oluşturulacak. Nadirlikler düşme oranlarına göre rastgele seçilir; kapağı olmayan seriler atlanır."
          data-confirm-title="Seri kapaklarından kart oluşturulsun mu?" data-confirm-label="Kartları oluştur" data-confirm-tone="accent">
      {{ csrfField() }}
      @component('components/ui/button', { type: 'submit', icon: 'stack' })
        Seri kapaklarından oluştur ({{ number(missingSeries) }})
      @end
    </form>
    @end
    @component('components/ui/button', { variant: 'primary', href: '/admin/kartlar/ekle', icon: 'plus' })
      Yeni kart
    @end
  @end

  @slot('main')
    <div class="ac-page">
      <nav class="ac-rarities" aria-label="Nadirliğe göre filtrele">
        <a href="/admin/kartlar" class="chip" {{ rarity ? '' : 'aria-current=page' }}>
          Tümü
          <span class="chip__count">{{ number(total) }}</span>
        </a>
        @each(entry in rarities)
        <a href="/admin/kartlar?nadirlik={{ entry.rarity }}" class="chip" {{ rarity === entry.rarity ? 'aria-current=page' : '' }}>
          <span class="tcg ac-gem" data-rarity="{{ entry.rarity }}" aria-hidden="true"></span>
          <span><strong class="ac-rarity-letter">{{ entry.rarity }}</strong> {{ entry.label }}</span>
          <span class="chip__count">{{ number(counts[entry.rarity]) }}</span>
        </a>
        @end
      </nav>

      @if(items.total)
      <p class="ac-summary">
        <span><strong>{{ number(items.total) }}</strong> {{ current ? current.label.toLocaleLowerCase('tr') + ' kart' : 'kart' }}</span>
        <span aria-hidden="true">·</span>
        <span>en yeni önce</span>
      </p>

      <ul class="ac-cards" aria-label="{{ current ? current.label + ' kartlar' : 'Kartlar' }}">
        @each(card in items)
        @let(editUrl = '/admin/kartlar/' + card.id + '/duzenle')
        @let(rarityLabel = (rarities.find((entry) => entry.rarity === card.rarity) || { label: '' }).label)
        <li class="ac-card {{ card.active ? '' : 'is-off' }}">
          <a href="{{ editUrl }}" class="tcg block" data-rarity="{{ card.rarity }}" tabindex="-1" aria-hidden="true">
            <img src="{{ thumbOf(card.image, 320) }}" alt="" loading="lazy" decoding="async" data-fallback="/images/no-cover.svg">
            <span class="tcg-letter">{{ card.rarity }}</span>
          </a>
          <div class="ac-card__body">
            <a href="{{ editUrl }}" class="ac-item__name">{{ card.name }}</a>
            @if(card.series)
            <a href="/admin/seriler/{{ card.series.id }}/duzenle" class="ac-card__series" title="Seriyi düzenle">{{ card.series.title }}</a>
            @else
            <span class="ac-card__series">Seriden bağımsız</span>
            @end
            <p class="ac-item__badges">
              @!component('components/ui/badge', { kind: 'neutral', text: card.rarity + ' · ' + rarityLabel, size: 'sm' })
              @if(!card.active)
              @!component('components/ui/badge', { kind: 'warning', text: 'Pasif', size: 'sm', title: 'Düşmez ve üretilemez' })
              @end
            </p>
          </div>
          <div class="ac-actions ac-card__actions">
            @!component('components/ui/button', { variant: 'ghost', size: 'sm', icon: 'pencil', href: editUrl, label: 'Düzenle: ' + card.name, title: 'Düzenle' })
            <form action="/admin/kartlar/{{ card.id }}/sil" method="POST" data-submit-once
                  data-confirm="“{{ card.name }}” kartı kalıcı olarak silinecek ve sahip olan okurların koleksiyonundan çıkar. Okurların parçaları korunur. Bu işlem geri alınamaz."
                  data-confirm-title="Kart silinsin mi?" data-confirm-label="Kartı sil">
              {{ csrfField() }}
              @!component('components/ui/button', { type: 'submit', variant: 'ghost', size: 'sm', icon: 'trash', label: 'Sil: ' + card.name, title: 'Sil', class: 'ac-danger' })
            </form>
          </div>
        </li>
        @end
      </ul>

      <div class="ac-listfoot">
        <p class="ac-listfoot__info">{{ number(first) }}–{{ number(last) }} / {{ number(items.total) }} kart</p>
        @!component('components/ui/pagination', { current: items.currentPage, total: items.lastPage, label: 'Kart sayfaları' })
      </div>
      @else
      @component('components/ui/empty_state', { icon: 'cards', title: current ? current.label + ' nadirlikte kart yok' : 'Henüz kart yok', description: current ? 'Başka bir nadirlik seçin ya da bu nadirlikte yeni bir kart ekleyin.' : 'Kart ekleyin ya da kartı olmayan serilerin kapaklarından toplu oluşturun.', class: 'mt-6' })
        @component('components/ui/button', { variant: 'primary', href: '/admin/kartlar/ekle', icon: 'plus' })
          Yeni kart
        @end
        @if(current)
        @component('components/ui/button', { href: '/admin/kartlar', icon: 'x' })
          Filtreyi kaldır
        @end
        @end
      @end
      @end
    </div>
  @end
@end
