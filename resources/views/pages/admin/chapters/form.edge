{{--
  Admin chapter form (create and edit), driven by `chapterForm` (resources/js/components/
  chapter_form.js): series combobox, page manager for image series (drop zone, drag or buttons
  to reorder, refused files), a large text area for text types or the source editor for video types
  (the series' content type format: seriesFormats, id → image/text/video)
  (config/watch.ts: one row per source with an uploaded video or link/iframe code, host and
  label), upload progress in the save bar and per video row.
  Posted fields: series_id, number, title, pages (files), page_order (JSON), text_content and
  sources (JSON [{ kind: 'local'|'link', url, host, label }]).
--}}
@let(isEdit = Boolean(chapter))
@let(oldSeries = flashMessages.get('series_id'))
@let(initialSeries = oldSeries ? Number(oldSeries) : (isEdit ? chapter.seriesId : (preSelectedSeriesId || '')))
@let(seriesOptions = seriesList.map((s) => ({ id: s.id, title: s.title, typeName: s.contentType ? s.contentType.name.charAt(0).toLocaleUpperCase('tr') + s.contentType.name.slice(1) : '-', type: s.contentType ? s.contentType.slug : '', cover: s.coverImage || '/images/no-cover.svg' })))
@let(oldSources = flashMessages.get('sources'))
@let(formConfig = {
  seriesId: initialSeries,
  formats: seriesFormats,
  series: seriesOptions,
  pages: isEdit && chapter.content.type === 'images' ? chapter.content.pages : [],
  localHost: localHost || '',
  maxUploadBytes: maxUploadBytes || 0,
  videoExtensions: videoExtensions || [],
  sources: typeof oldSources === 'string' ? oldSources : (isEdit && chapter.content.type === 'video' ? chapter.content.sources : []),
})
@let(sourcesError = flashMessages.has('inputErrorsBag.sources') ? flashMessages.get('inputErrorsBag.sources')[0] : '')
@let(action = isEdit ? '/admin/bolumler/' + chapter.id + '/duzenle' : '/admin/bolumler/ekle')
@let(listUrl = '/admin/bolumler' + (initialSeries ? '?series_id=' + initialSeries : ''))
@let(readerUrl = isEdit && chapter.series && chapter.series.contentType ? '/series/' + chapter.series.contentType.slug + '/' + chapter.series.slug + '/' + chapter.number : '')
@let(seriesError = flashMessages.has('inputErrorsBag.series_id') ? flashMessages.get('inputErrorsBag.series_id')[0] : '')
@let(pagesError = flashMessages.has('inputErrorsBag.pages') ? flashMessages.get('inputErrorsBag.pages')[0] : (flashMessages.has('inputErrorsBag.page_order') ? flashMessages.get('inputErrorsBag.page_order')[0] : ''))
@component('components/layout/admin', {
  title: isEdit ? (chapter.series ? chapter.series.title + ' · ' : '') + 'Bölüm ' + chapter.number : title,
  description: isEdit ? 'Bölüm bilgilerini, sayfalarını, metnini veya video kaynaklarını düzenleyin.' : 'Seriyi seçin; içerik alanı serinin türüne göre görsel sayfalar, metin ya da video kaynakları olarak açılır.',
  crumbs: [{ label: 'Bölümler', href: '/admin/bolumler' }, { label: isEdit ? 'Düzenle' : 'Yeni bölüm' }]
})
  @slot('actions')
    @if(readerUrl)
    @component('components/ui/button', { href: readerUrl, iconRight: 'external', target: '_blank', rel: 'noopener' })
      {{ chapter.series.contentType.format === 'video' ? 'Oynatıcıda aç' : 'Okuyucuda aç' }}
    @end
    @end
  @end

  @slot('main')
    <form id="chapter-form" action="{{ action }}" method="POST" enctype="multipart/form-data" data-submit-once
          x-data="chapterForm" data-form="{{ JSON.stringify(formConfig) }}" x-ref="chapterFormEl" @submit="prepareSubmit($event)">
      {{ csrfField() }}
      <input type="hidden" name="series_id" :value="seriesId" value="{{ initialSeries }}">
      <p class="sr-only" aria-live="polite" x-text="announcement"></p>

      <div x-show="errors.length" x-cloak x-ref="errorBox" tabindex="-1" class="alert mb-6" data-tone="danger" role="alert">
        @!component('components/icon', { name: 'exclamation' })
        <div class="min-w-0 flex-1">
          <p class="alert__title">Bölüm kaydedilemedi</p>
          <ul class="mt-1 list-disc space-y-1 pl-5">
            <template x-for="(message, index) in errors" :key="index">
              <li x-text="message"></li>
            </template>
          </ul>
        </div>
      </div>

      <div class="admin-form">
        @component('components/ui/panel', { title: 'Bölüm bilgileri', id: 'chapter-info' })
          <div class="admin-fields">
            <div class="field {{ seriesError ? 'field--invalid' : '' }}">
              <label for="f-series" class="field__label">
                Seri
                <span class="field__req" aria-hidden="true">*</span>
              </label>
              <div class="admin-combo" @click.outside="if (dropdownOpen) closeList()">
                <label class="control control--icon">
                  @!component('components/icon', { name: 'search' })
                  <input type="text" id="f-series" x-ref="seriesInput" x-model="searchQuery" autocomplete="off" spellcheck="false" placeholder="Seri adı yazın"
                         role="combobox" aria-autocomplete="list" aria-controls="series-listbox" aria-describedby="f-series-hint f-series-error" aria-required="true"
                         :aria-expanded="dropdownOpen.toString()" :aria-activedescendant="activeOptionId" :aria-invalid="seriesError ? 'true' : null"
                         @click="openList()" @input="onSeriesInput()" @keydown="onSeriesKeydown($event)" @focus="$el.select()">
                  @!component('components/icon', { name: 'chevron-down', class: 'admin-picker__caret' })
                </label>
                <ul id="series-listbox" role="listbox" aria-label="Seriler" class="menu admin-combo__list" x-show="dropdownOpen" x-cloak x-transition.opacity.duration.100ms>
                  <template x-for="(s, index) in filteredSeries" :key="s.id">
                    <li role="option" :id="'series-option-' + s.id" class="menu__item admin-option" :class="{ 'is-active': index === activeIndex, 'is-chosen': String(seriesId) === String(s.id) }"
                        :aria-selected="(String(seriesId) === String(s.id)).toString()" @mousedown.prevent @click="selectSeries(s)" @mousemove="activeIndex = index">
                      <img :src="s.cover" alt="" class="admin-thumb" width="28" height="37" loading="lazy" decoding="async" data-fallback="/images/no-cover.svg">
                      <span class="min-w-0 flex-1 truncate" x-text="s.title"></span>
                      <span class="badge badge--sm" :data-tone="['manga', 'manhwa', 'manhua', 'novel', 'webtoon', 'anime'].includes(s.type) ? s.type : 'neutral'" x-text="s.typeName"></span>
                    </li>
                  </template>
                  <li role="presentation" class="px-3 py-4 text-center text-sm text-muted" x-show="filteredSeries.length === 0">Bu adla bir seri yok.</li>
                </ul>
              </div>
              <p id="f-series-hint" class="field__hint">
                <span x-show="!selectedSeries">Yazarak arayın; ok tuşlarıyla gezinip Enter ile seçin.</span>
                <span x-show="selectedSeries" x-cloak>
                  Seçili:
                  <strong class="text-ink" x-text="selectedSeries ? selectedSeries.title : ''"></strong>
                  ·
                  <span x-text="isVideo ? 'video bölümü (kaynaklar)' : (format === 'text' ? 'metin bölümü' : 'görsel sayfalı bölüm')"></span>
                </span>
              </p>
              <p id="f-series-error" class="field__error" role="alert" x-show="seriesError" x-text="seriesError" x-cloak></p>
              @if(seriesError)
              <p class="field__error" role="alert" x-show="!seriesError">{{ seriesError }}</p>
              @end
            </div>

            <div class="admin-fields admin-fields--number">
              @!component('components/ui/field', { name: 'number', label: 'Bölüm numarası', type: 'number', required: true, min: 0, step: 1, inputmode: 'numeric', value: isEdit ? chapter.number : '' })
              @!component('components/ui/field', { name: 'title', label: 'Başlık', value: isEdit ? (chapter.title || '') : '', maxlength: 255, placeholder: 'ör. İlk Savaş', hint: 'İsteğe bağlı. Okuyucuda “Bölüm N” yanında görünür.' })
            </div>
          </div>
        @end

        @component('components/ui/panel', { title: 'Yayın ve erişim', id: 'chapter-access', description: 'Taslak bölümler listelerde görünmez ve kaydedenlere bildirim gitmez; taslaktan çıkınca bildirim gönderilir.' })
          <div class="admin-fields">
            @!component('components/ui/field', { name: 'draft', label: 'Taslak (yayınlama)', type: 'toggle', value: flashMessages.has('inputErrorsBag') ? flashMessages.has('draft') : (isEdit && chapter.draft), hint: 'Açıkken bölümü yalnız yönetici ve editörler görür.' })
            @!component('components/ui/field', { name: 'access', label: 'Erişim', type: 'select', value: isEdit ? chapter.access : 'public', options: Object.entries(site.accessLevels).map(([value, level]) => ({ value, label: level.chapterLabel })), hint: 'Seri daha kısıtlıysa serinin ayarı geçerlidir. Üyelere özel: giriş gerekir. VIP: yalnız VIP rolündekiler (ve yönetim).' })
            @!component('components/ui/field', { name: 'warning', label: 'Bölüm öncesi uyarı (isteğe bağlı)', type: 'textarea', rows: 3, maxlength: 500, value: isEdit ? (chapter.warning || '') : '', placeholder: 'ör. Bu bölüm şiddet ve kan içeren sahneler barındırır.', hint: 'Doluysa okur bölümü açmadan önce bu metni görür ve “Devam et” der.' })
          </div>
        @end

        @include('partials/teams/chapter_panel')

        <div x-show="!format" x-cloak>
          @!component('components/ui/empty_state', { icon: 'book-open', title: 'Önce bir seri seçin', description: 'İçerik alanı serinin içerik türünün biçimine göre açılır: görsel türlerde (manga, manhwa, webtoon) sayfa görselleri, metin türlerinde (novel) bölüm metni, video türlerde (anime) video kaynakları.' })
        </div>

        <section class="panel" aria-labelledby="pages-title" x-show="format === 'image'" x-cloak>
          <div class="panel__head">
            <div class="min-w-0">
              <h2 id="pages-title" class="panel__title">Sayfalar</h2>
              <p class="panel__desc">Okuyucuda bu sırayla gösterilir. Sürükleyerek veya düğmelerle sıralayın.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2" x-show="allPages.length > 0">
              <span class="badge" data-tone="neutral" x-text="allPages.length + ' sayfa'"></span>
              <span class="badge" data-tone="accent" x-show="newCount > 0" x-text="newCount + ' yeni'"></span>
            </div>
          </div>

          <input type="hidden" name="page_order" :value="getPageOrderJSON()">
          <label for="f-pages" class="dropzone" :class="{ 'is-over': imageDragging }"
                 @dragover.prevent="imageDragging = true" @dragleave="if (!$el.contains($event.relatedTarget)) imageDragging = false"
                 @drop.prevent="imageDragging = false; addFiles($event.dataTransfer.files)">
            <input type="file" id="f-pages" name="pages" multiple accept="image/jpeg,image/png,image/webp" x-ref="pagesInput" class="sr-only"
                   aria-describedby="f-pages-hint" @change="handleFileSelect($event)">
            @!component('components/icon', { name: 'upload', class: 'h-7 w-7 text-accent' })
            <span class="text-sm font-bold text-ink">Sayfa görsellerini seçin veya buraya sürükleyin</span>
            <span id="f-pages-hint">JPG, PNG veya WebP · her biri en fazla 10 MB · birden çok dosya seçebilirsiniz</span>
          </label>
          @if(pagesError)
          <p class="field__error mt-2" role="alert">{{ pagesError }}</p>
          @end

          <div x-show="rejected.length" x-cloak class="alert mt-4" data-tone="warning" role="alert">
            @!component('components/icon', { name: 'exclamation' })
            <div class="min-w-0 flex-1">
              <p class="alert__title" x-text="rejected.length + ' dosya eklenmedi'"></p>
              <ul class="mt-1 space-y-0.5 text-sm">
                <template x-for="(file, index) in rejected" :key="index">
                  <li class="truncate"><span class="font-semibold" x-text="file.name"></span>: <span x-text="file.reason"></span></li>
                </template>
              </ul>
            </div>
            @!component('components/ui/button', { variant: 'ghost', size: 'sm', icon: 'x', label: 'Uyarıyı kapat', class: '-my-1', '@click': 'rejected = []' })
          </div>

          <ol class="admin-pages mt-5" x-show="allPages.length > 0" aria-label="Sayfa sırası" @dragover.prevent @drop.prevent="dropOnList($event)">
            <template x-for="(page, index) in allPages" :key="page.id">
              <li class="admin-page" :data-page-id="page.id" draggable="true"
                  :class="{ 'is-dragging': dragStartIndex === index, 'is-target': dragOverIndex === index && dragStartIndex !== null && dragStartIndex !== index }"
                  @dragstart="dragStart(index, $event)" @dragover.prevent="dragOverIndex = index" @drop.prevent.stop="dragStartIndex === null ? dropOnList($event) : reorderPages(index)"
                  @dragend="dragStartIndex = null; dragOverIndex = null">
                <div class="admin-page__thumb">
                  <img :src="page.preview" alt="" x-show="page.preview" decoding="async" draggable="false">
                  <span class="admin-page__num" x-text="index + 1"></span>
                  <span class="admin-page__flag badge badge--sm badge--solid" data-tone="accent" x-show="page.type === 'new'">Yeni</span>
                  <span class="admin-page__grip" aria-hidden="true">
                    @!component('components/icon', { name: 'drag' })
                  </span>
                </div>
                <p class="admin-page__name" x-text="page.type === 'new' ? page.name : 'Kayıtlı'" :title="page.type === 'new' ? page.name : 'Kayıtlı sayfa'"></p>
                <div class="admin-page__tools">
                  <button type="button" class="btn btn--ghost btn--sm btn--icon" data-tool="up" @click="movePage(index, -1)" :disabled="index === 0"
                          :aria-label="'Sayfa ' + (index + 1) + ': bir öne al'" title="Öne al">
                    @!component('components/icon', { name: 'arrow-left', class: 'btn__icon' })
                  </button>
                  <button type="button" class="btn btn--ghost btn--sm btn--icon" data-tool="down" @click="movePage(index, 1)" :disabled="index === allPages.length - 1"
                          :aria-label="'Sayfa ' + (index + 1) + ': bir sonraya al'" title="Sonraya al">
                    @!component('components/icon', { name: 'arrow-right', class: 'btn__icon' })
                  </button>
                  <button type="button" class="btn btn--ghost btn--sm btn--icon admin-danger" data-tool="remove" @click="removePage(index)"
                          :aria-label="'Sayfa ' + (index + 1) + ': kaldır'" title="Kaldır">
                    @!component('components/icon', { name: 'trash', class: 'btn__icon' })
                  </button>
                </div>
              </li>
            </template>
          </ol>
          <p class="mt-4 text-sm text-muted" x-show="allPages.length === 0">Henüz sayfa yok. Görseller dosya adına göre değil, seçtiğiniz sırayla eklenir.</p>
        </section>

        <section class="panel" aria-labelledby="text-title" x-show="format === 'text'" x-cloak>
          <div class="panel__head">
            <div class="min-w-0">
              <h2 id="text-title" class="panel__title">Bölüm metni</h2>
              <p class="panel__desc">Paragrafları boş satırla ayırın; okuyucuda aynen gösterilir.</p>
            </div>
            <span class="badge" data-tone="neutral" x-text="words.toLocaleString('tr-TR') + ' kelime'"></span>
          </div>
          @!component('components/ui/field', { name: 'text_content', label: 'Metin', type: 'textarea', rows: 22, value: isEdit && chapter.content && chapter.content.type === 'text' ? chapter.content.text : '', controlClass: 'admin-novel', '@input': 'countWords($event.target.value)' })
        </section>

        @include('partials/admin/chapter_sources')
      </div>

      <div class="savebar">
        <div class="admin-savebar__status" aria-live="polite">
          <template x-if="uploading">
            <div class="flex min-w-0 flex-1 flex-wrap items-center gap-x-3 gap-y-1.5">
              <div class="min-w-40 flex-1" x-ref="progress" x-effect="paintProgress(progress)">
                @!component('components/ui/progress', { label: 'Yükleme ilerlemesi', value: 0 })
              </div>
              <span class="t-num whitespace-nowrap text-xs font-semibold text-body" x-text="progressText"></span>
              <button type="button" class="btn btn--ghost btn--sm" x-show="phase === 'upload'" @click="cancelUpload()">İptal</button>
            </div>
          </template>
          <span x-show="!uploading && format === 'image'" x-text="allPages.length ? allPages.length + ' sayfa' + (newCount ? ' · ' + newCount + ' yeni yüklenecek' : ' · yeni yükleme yok') : 'Sayfa eklenmedi'"></span>
          <span x-show="!uploading && isVideo" x-cloak x-text="sourcesSummary"></span>
          <span x-show="!uploading && format === 'text'" x-cloak x-text="words.toLocaleString('tr-TR') + ' kelime'"></span>
          <span x-show="!uploading && !format" x-cloak>Seri seçilmedi</span>
        </div>
        <div class="form-actions">
          @component('components/ui/button', { variant: 'ghost', href: listUrl })
            Vazgeç
          @end
          @component('components/ui/button', { type: 'submit', variant: 'primary', icon: 'check', ':disabled': 'uploading || videoUploading', ':aria-busy': "uploading || videoUploading ? 'true' : null" })
            {{ isEdit ? 'Değişiklikleri kaydet' : 'Bölümü ekle' }}
          @end
        </div>
      </div>
    </form>

    @if(isEdit)
    <section class="panel admin-danger-zone mt-6 flex flex-wrap items-center justify-between gap-4" aria-labelledby="danger-title">
      <div class="min-w-0">
        <h2 id="danger-title" class="panel__title">Bölümü sil</h2>
        <p class="panel__desc">Bölüm ve ona yazılan yorumlar kalıcı olarak silinir. Geri alınamaz.</p>
      </div>
      <form action="/admin/bolumler/{{ chapter.id }}/sil" method="POST" data-submit-once
            data-confirm="{{ chapter.series ? chapter.series.title + ' · ' : '' }}Bölüm {{ chapter.number }} ve bu bölüme yazılan yorumlar kalıcı olarak silinecek. Bu işlem geri alınamaz."
            data-confirm-title="Bölüm silinsin mi?" data-confirm-label="Bölümü sil">
        {{ csrfField() }}
        @component('components/ui/button', { type: 'submit', variant: 'danger', icon: 'trash' })
          Bölümü sil
        @end
      </form>
    </section>
    @end
  @end
@end
