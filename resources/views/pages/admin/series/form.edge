{{--
  Admin series form (create and edit). Two columns on wide screens: the main fields on the left,
  images, showcase and (edit) summary and deletion on the right; a sticky save bar at the end.
  Posted fields are unchanged: title, description, content_type_id, status, translation_status,
  publication_year, age_rating, alternative_titles and keywords (comma separated), featured
  ('on'), featured_description, draft, access, cover_mode, genres[], authors[], artists[], cover_image,
  banner_image.
  "Otomatik doldur" (partials/admin/cover_finder) fills these fields, cover_image and banner_image.
--}}
@let(isEdit = Boolean(series))
@let(failed = flashMessages.has('inputErrorsBag'))
@let(errorList = failed ? Object.entries(flashMessages.get('inputErrorsBag') || {}) : [])
@let(action = isEdit ? '/admin/seriler/' + series.id + '/duzenle' : '/admin/seriler/ekle')
@let(siteUrl = isEdit && series.contentType ? '/series/' + series.contentType.slug + '/' + series.slug : '')
@let(chapterCount = isEdit ? Number(series.$extras.chapters_count || 0) : 0)
@let(noCover = '/images/no-cover.svg')
@let(fieldLabels = { title: 'Başlık', description: 'Açıklama', content_type_id: 'İçerik türü', status: 'Durum', translation_status: 'Çeviri durumu', publication_year: 'Yayın yılı', age_rating: 'Yaş sınırı', alternative_titles: 'Alternatif başlıklar', keywords: 'Anahtar kelimeler', featured_description: 'Vitrin açıklaması', genres: 'Türler', authors: 'Yazarlar', artists: 'Çizerler', cover_image: 'Kapak görseli', banner_image: 'Banner görseli' })
@component('components/layout/admin', {
  title: isEdit ? series.title : title,
  description: isEdit ? 'Seri bilgilerini, görsellerini ve ilişkilerini düzenleyin. Adres değişmez: /series/' + (series.contentType ? series.contentType.slug : '') + '/' + series.slug : 'Kataloğa yeni bir seri ekleyin. Adres başlıktan otomatik oluşturulur.',
  crumbs: [{ label: 'Seriler', href: '/admin/seriler' }, { label: isEdit ? 'Düzenle' : 'Yeni seri' }]
})
  @slot('actions')
    @if(isEdit)
    @component('components/ui/button', { href: '/admin/bolumler?series_id=' + series.id, icon: 'document' })
      Bölümler
    @end
    @if(siteUrl)
    @component('components/ui/button', { href: siteUrl, iconRight: 'external', target: '_blank', rel: 'noopener' })
      Sitede aç
    @end
    @end
    @end
  @end

  @slot('main')
    <form id="series-form" action="{{ action }}" method="POST" enctype="multipart/form-data" data-submit-once
          x-data="{ dirty: false, featured: false }" x-init="featured = Boolean($el.querySelector('#f-featured')?.checked)"
          @input="dirty = true" @change="dirty = true">
      {{ csrfField() }}

      @if(errorList.length)
      @component('components/ui/alert', { tone: 'danger', title: 'Seri kaydedilemedi', class: 'mb-6' })
        <p>Aşağıdaki alanları düzeltip yeniden kaydedin. Seçtiğiniz görseller güvenlik nedeniyle yeniden seçilmelidir.</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          @each(entry in errorList)
          @let(label = fieldLabels[entry[0]] || entry[0])
          @if(String(entry[1][0]).startsWith(label))
          <li><a href="#f-{{ entry[0] }}" class="link">{{ entry[1][0] }}</a></li>
          @else
          <li><a href="#f-{{ entry[0] }}" class="link">{{ label }}</a>: {{ entry[1][0] }}</li>
          @end
          @end
        </ul>
      @end
      @end

      <div class="admin-form admin-form--split">
        <div class="admin-form__col">
          @component('components/ui/panel', { title: 'Temel bilgiler', id: 'basics' })
            @slot('actions')
              @component('components/ui/button', { size: 'sm', icon: 'sparkles', '@click': "$dispatch('open-cover-finder')", 'aria-haspopup': 'dialog' })
                Otomatik doldur
              @end
            @end
            @slot('main')
            <div class="admin-fields">
              @!component('components/ui/field', { name: 'title', label: 'Başlık', required: true, value: isEdit ? series.title : '', maxlength: 255, autocomplete: 'off', hint: isEdit ? 'Başlık değişse de seri adresi aynı kalır.' : 'Adres (slug) başlıktan oluşturulur, sonradan değişmez.' })
              @!component('components/ui/field', { name: 'description', label: 'Açıklama', type: 'textarea', rows: 7, required: true, value: isEdit ? series.description : '', hint: 'Seri sayfasında ve arama sonuçlarında görünen özet. “Otomatik doldur” AniList, MyAnimeList veya Kitsu’dan açıklama, türler, kişiler ve görsellerle formu doldurur.' })
            </div>
            @end
          @end

          @component('components/ui/panel', { title: 'Yayın bilgileri', id: 'publication' })
            <div class="admin-fields admin-fields--3">
              @!component('components/ui/field', { name: 'content_type_id', label: 'İçerik türü', type: 'select', required: true, value: isEdit ? series.contentTypeId : '', options: [{ value: '', label: 'Seçin' }].concat(contentTypes.map((type) => ({ value: type.id, label: type.name }))) })
              @!component('components/ui/field', { name: 'publication_year', label: 'Yayın yılı', type: 'number', required: true, min: 1900, max: 2100, inputmode: 'numeric', value: isEdit ? series.publicationYear : new Date().getFullYear() })
              @!component('components/ui/field', { name: 'age_rating', label: 'Yaş sınırı', type: 'select', value: isEdit ? (series.ageRating || '') : '', options: [{ value: '', label: 'Yok' }].concat(site.ageRatings.map((value) => ({ value, label: value }))) })
              @!component('components/ui/field', { name: 'status', label: 'Yayın durumu', type: 'select', required: true, value: isEdit ? series.status : site.statuses[0], options: site.statuses.map((value) => ({ value, label: value })) })
              @!component('components/ui/field', { name: 'translation_status', label: 'Çeviri durumu', type: 'select', required: true, value: isEdit ? series.translationStatus : site.translationStatuses[0], options: site.translationStatuses.map((value) => ({ value, label: value })) })
            </div>
          @end

          @component('components/ui/panel', { title: 'Arama ve keşif', id: 'discovery', description: 'Okurların seriyi farklı adlarla ve konularla bulmasını sağlar.' })
            <div class="admin-fields">
              @!component('components/ui/tag_input', { name: 'alternative_titles', label: 'Alternatif başlıklar', value: isEdit ? (series.alternativeTitles || []) : [], placeholder: 'Başlık yazıp Enter’a basın', hint: 'Enter veya virgül ile ekleyin; başlıklar virgül içeremez. Seri sayfasında ve aramada kullanılır.' })
              @!component('components/ui/tag_input', { name: 'keywords', label: 'Anahtar kelimeler', value: isEdit ? (series.keywords || []) : [], suggestions: allKeywords || [], placeholder: 'Kelime yazın veya önerilerden seçin', hint: 'Site araması ve arama motorları için kısa ifadeler.' })
            </div>
          @end

          @component('components/ui/panel', { title: 'Türler ve kişiler', id: 'relations' })
            <div class="admin-fields">
              @!component('components/ui/multi_select', { name: 'genres', label: 'Türler', items: genres, selected: selectedGenreIds || [], placeholder: 'Tür ara veya seçin…', hint: 'Seri sayfasında etiket olarak görünür ve kataloğu filtreler.' })
              @!component('components/ui/multi_select', { name: 'authors', label: 'Yazarlar', items: authors, selected: selectedAuthorIds || [], placeholder: 'Yazar ara veya seçin…' })
              @!component('components/ui/multi_select', { name: 'artists', label: 'Çizerler', items: artists, selected: selectedArtistIds || [], placeholder: 'Çizer ara veya seçin…' })
            </div>
          @end
        </div>

        <div class="admin-form__col">
          @component('components/ui/panel', { title: 'Görseller', id: 'images', description: 'JPG, PNG veya WebP; en fazla 10 MB.' })
            <div class="admin-fields admin-images">
              @!component('components/ui/dropzone', { name: 'cover_image', label: 'Kapak', aspect: 'cover', current: isEdit && series.coverImage !== noCover ? series.coverImage : '', hint: isEdit ? 'Yeni görsel seçmezseniz mevcut kapak kalır.' : 'Kapak seçilmezse varsayılan görsel kullanılır. Önerilen oran 3:4.' })
              @!component('components/ui/dropzone', { name: 'banner_image', label: 'Banner', aspect: 'banner', current: isEdit ? (series.bannerImage || '') : '', hint: 'Seri sayfasının üstünde geniş görsel. Önerilen oran 3:1.' })
            </div>
            @!component('partials/admin/cover_finder', { isNew: !isEdit })
          @end

          @component('components/ui/panel', { title: 'Yayın ve erişim', id: 'access', description: 'Taslaklar yalnız yönetimde görünür. Erişim, bölümleri kimin açabileceğini belirler; yaş uyarısı Yaş sınırı ve Tema → Yaş ve Erişim ayarından gelir.' })
            <div class="admin-fields">
              @!component('components/ui/field', { name: 'draft', label: 'Taslak (yayınlama)', type: 'toggle', value: failed ? flashMessages.has('draft') : (isEdit && series.draft), hint: 'Açıkken seri katalogda, aramada ve ana sayfada görünmez; adresi yalnız yönetici ve editörler açabilir.' })
              @!component('components/ui/field', { name: 'cover_mode', label: 'Kapak görünümü', type: 'select', value: isEdit ? (series.coverMode || 'auto') : 'auto', options: [{ value: 'auto', label: 'Yaş sınırına göre (Tema → Yaş ve Erişim)' }].concat(Object.entries(site.coverModes).map(([value, mode]) => ({ value, label: mode.label }))), hint: 'Hassas kapaklar listelerde, aramada ve seri sayfasında bulanık ya da varsayılan görselle gösterilir. Asıl kapağı kimlerin göreceği Tema → Yaş ve Erişim → “Gizli kapakları kimler açık görsün?” ayarından gelir.' })
              @!component('components/ui/field', { name: 'access', label: 'Erişim', type: 'select', value: isEdit ? series.access : 'public', options: Object.entries(site.accessLevels).map(([value, level]) => ({ value, label: level.label })), hint: 'Seri sayfası herkese görünür; kilitli bölümler kilit simgesiyle listelenir ve açılırken giriş ya da VIP rolü istenir.' })
            </div>
          @end

          @component('components/ui/panel', { title: 'Vitrin', id: 'showcase', description: 'Öne çıkan seriler ana sayfadaki büyük vitrinde döner.' })
            <div class="admin-fields">
              @!component('components/ui/field', { name: 'featured', label: 'Ana sayfa vitrininde göster', type: 'toggle', value: failed ? flashMessages.has('featured') : (isEdit && series.featured), '@change': 'featured = $event.target.checked' })
              <div x-show="featured" x-transition.opacity>
                @!component('components/ui/field', { name: 'featured_description', label: 'Vitrin açıklaması', type: 'textarea', rows: 3, value: isEdit ? (series.featuredDescription || '') : '', hint: 'Vitrinde başlığın altında görünen kısa tanıtım.' })
              </div>
              @include('partials/admin/series_pin')
            </div>
          @end

          @if(isEdit)
          @component('components/ui/panel', { title: 'Özet', id: 'summary' })
            <dl class="admin-facts">
              <div>
                <dt>Bölüm</dt>
                <dd>{{ chapterCount.toLocaleString('tr-TR') }}</dd>
              </div>
              <div>
                <dt>Puan</dt>
                <dd>{{ series.ratingCount ? '★ ' + Number(series.ratingAvg).toFixed(1) + ' (' + series.ratingCount + ')' : '—' }}</dd>
              </div>
              <div>
                <dt>Eklendi</dt>
                <dd>{{ dateOf(series.createdAt) || '—' }}</dd>
              </div>
              <div>
                <dt>Son güncelleme</dt>
                <dd>{{ agoOf(series.updatedAt) || '—' }}</dd>
              </div>
            </dl>
            <div class="mt-4 grid gap-2">
              @component('components/ui/button', { href: '/admin/bolumler/ekle?series_id=' + series.id, icon: 'upload', block: true })
                Bu seriye bölüm ekle
              @end
              @if(series.contentType && series.contentType.format === 'image')
              @component('components/ui/button', { href: '/admin/toplu-yukle?series_id=' + series.id, icon: 'archive', variant: 'ghost', block: true })
                ZIP'ten toplu yükle
              @end
              @end
            </div>
          @end

          <section class="panel admin-danger-zone" aria-labelledby="danger-title">
            <h2 id="danger-title" class="panel__title">Seriyi sil</h2>
            <p class="panel__desc">{{ chapterCount ? chapterCount + ' bölüm, ' : '' }}yorumlar, incelemeler ve okuma kayıtları da silinir. Geri alınamaz.</p>
            @component('components/ui/button', { type: 'submit', variant: 'danger', icon: 'trash', block: true, form: 'series-delete', class: 'mt-4' })
              Seriyi sil
            @end
          </section>
          @end
        </div>
      </div>

      <div class="savebar">
        <p class="admin-savebar__status" aria-live="polite">
          <span x-show="!dirty">
            @if(isEdit)
            Son kayıt {{ agoOf(series.updatedAt) }}.
            @else
            <span class="text-danger" aria-hidden="true">*</span> işaretli alanlar zorunludur.
            @end
          </span>
          <span x-show="dirty" x-cloak class="inline-flex items-center gap-2 font-semibold text-warning">
            <span class="h-2 w-2 rounded-full bg-warning" aria-hidden="true"></span>
            Kaydedilmemiş değişiklikler var
          </span>
        </p>
        <div class="form-actions">
          @component('components/ui/button', { variant: 'ghost', href: '/admin/seriler' })
            Vazgeç
          @end
          @component('components/ui/button', { type: 'submit', variant: 'primary', icon: 'check' })
            {{ isEdit ? 'Değişiklikleri kaydet' : 'Seriyi ekle' }}
          @end
        </div>
      </div>
    </form>

    @if(isEdit)
    <form id="series-delete" action="/admin/seriler/{{ series.id }}/sil" method="POST" hidden
          data-confirm="“{{ series.title }}” serisi{{ chapterCount ? ', ' + chapterCount + ' bölümü' : '' }}, yorumları, incelemeleri ve okuma kayıtlarıyla birlikte kalıcı olarak silinecek. Bu işlem geri alınamaz."
          data-confirm-title="Seri silinsin mi?" data-confirm-label="Seriyi sil">
      {{ csrfField() }}
    </form>
    @end
  @end
@end
