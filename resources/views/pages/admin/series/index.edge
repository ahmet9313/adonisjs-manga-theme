{{--
  Admin series list: GET filters (search, status, content type; page size kept), table that
  turns into cards on phones, filter-aware empty state, pagination and page size.
--}}
@let(number = (value) => Number(value || 0).toLocaleString('tr-TR'))
@let(typeName = (type) => type ? type.name.charAt(0).toLocaleUpperCase('tr') + type.name.slice(1) : 'Tür yok')
@let(statusOptions = [{ value: '', label: 'Tüm durumlar' }].concat(site.statuses.map((value) => ({ value, label: value }))))
@let(typeOptions = [{ value: '', label: 'Tüm içerik türleri' }].concat(contentTypes.map((type) => ({ value: type.slug, label: typeName(type) }))))
@let(first = seriesList.total ? (seriesList.currentPage - 1) * seriesList.perPage + 1 : 0)
@let(last = Math.min(seriesList.currentPage * seriesList.perPage, seriesList.total))
@component('components/layout/admin', { title, description: 'Katalogdaki ' + number(catalogTotal) + ' seri. Bir seriyi düzenleyin, bölümlerini yönetin veya sitede açın.' })
  @slot('actions')
    @component('components/ui/button', { variant: 'primary', href: '/admin/seriler/ekle', icon: 'plus' })
      Yeni seri
    @end
  @end

  @slot('main')
    <form method="GET" action="/admin/seriler" class="panel panel--tight admin-filters" role="search" aria-label="Serileri filtrele" x-data>
      @!component('components/ui/field', { name: 'search', label: 'Ara', type: 'search', value: filters.search, placeholder: 'Başlık, adres veya alternatif başlık', autocomplete: 'off' })
      @!component('components/ui/field', { name: 'status', label: 'Durum', type: 'select', value: filters.status, options: statusOptions, '@change': '$el.form.requestSubmit()' })
      @!component('components/ui/field', { name: 'type', label: 'İçerik türü', type: 'select', value: filters.type, options: typeOptions, '@change': '$el.form.requestSubmit()' })
      @if(perPage !== 20)
      <input type="hidden" name="per_page" value="{{ perPage }}">
      @end
      <div class="admin-filters__actions">
        @component('components/ui/button', { type: 'submit', icon: 'filter' })
          Filtrele
        @end
        @if(filtered)
        @component('components/ui/button', { variant: 'ghost', href: '/admin/seriler' + (perPage !== 20 ? '?per_page=' + perPage : '') })
          Temizle
        @end
        @end
      </div>
    </form>

    <p class="admin-summary">
      @if(filtered)
      <span><strong>{{ number(seriesList.total) }}</strong> sonuç</span>
      <span aria-hidden="true">·</span>
      <span>{{ number(catalogTotal) }} seri içinde arandı</span>
      @else
      <span><strong>{{ number(seriesList.total) }}</strong> seri, son güncellenen önce</span>
      @end
    </p>

    @if(seriesList.length)
    <div class="table-wrap">
      <table class="table table--stack admin-table">
        <caption class="sr-only">Seriler</caption>
        <thead>
          <tr>
            <th scope="col">Seri</th>
            <th scope="col">Durum</th>
            <th scope="col" class="max-xl:hidden">Çeviri</th>
            <th scope="col" class="num">Bölüm</th>
            <th scope="col">Güncellendi</th>
            <th scope="col"><span class="sr-only">İşlemler</span></th>
          </tr>
        </thead>
        <tbody>
          @each(series in seriesList)
          @let(chapterCount = Number(series.$extras.chapters_count || 0))
          @let(siteUrl = series.contentType ? '/series/' + series.contentType.slug + '/' + series.slug : '')
          <tr>
            <td class="cell-main">
              <div class="admin-cell">
                <img src="{{ thumbOf(series.coverImage, 160) || '/images/no-cover.svg' }}" alt="" class="admin-thumb" width="40" height="53" loading="lazy" decoding="async" data-fallback="/images/no-cover.svg">
                <div class="admin-cell__body">
                  <a href="/admin/seriler/{{ series.id }}/duzenle" class="admin-title line-clamp-2">{{ series.title }}</a>
                  <div class="admin-cell__meta">
                    @!component('components/ui/badge', { kind: 'type', value: series.contentType ? series.contentType.slug : '', text: typeName(series.contentType), size: 'sm' })
                    @!component('components/ui/badge', { kind: 'status', value: series.status, size: 'sm', class: 'md:hidden' })
                    @if(series.draft)
                    @!component('components/ui/badge', { kind: 'draft', tone: 'warning', text: 'Taslak', size: 'sm', title: 'Yayında değil; yalnız yönetim görür' })
                    @!component('partials/admin/scheduled_badge', { at: series.publishAt })
                    @end
                    @if(series.access !== 'public')
                    @!component('components/ui/badge', { kind: 'access', tone: series.access === 'vip' ? 'accent' : 'neutral', text: site.accessLevels[series.access].label, size: 'sm' })
                    @end
                    @if(series.featured)
                    @!component('components/ui/badge', { kind: 'accent', text: 'Öne çıkan', size: 'sm', title: 'Ana sayfa vitrininde' })
                    @end
                    <span class="admin-mono truncate max-lg:hidden">/{{ series.slug }}</span>
                  </div>
                  <p class="admin-cell__meta md:hidden">Çeviri: {{ series.translationStatus }} · {{ number(chapterCount) }} bölüm · {{ agoOf(series.updatedAt) }}</p>
                </div>
              </div>
            </td>
            <td data-label="Durum" class="max-md:hidden">
              <div class="flex flex-col items-start gap-1">
                @!component('components/ui/badge', { kind: 'status', value: series.status })
                @!component('components/ui/badge', { kind: 'status', value: series.translationStatus, text: 'Çeviri: ' + series.translationStatus, size: 'sm', class: 'xl:hidden' })
              </div>
            </td>
            <td data-label="Çeviri" class="max-xl:hidden">
              @!component('components/ui/badge', { kind: 'status', value: series.translationStatus })
            </td>
            <td data-label="Bölüm" class="num max-md:hidden">
              @if(chapterCount)
              <a href="/admin/bolumler?series_id={{ series.id }}" class="link" title="{{ series.title }} bölümleri">{{ number(chapterCount) }}</a>
              @else
              <span class="text-muted">0</span>
              @end
            </td>
            <td data-label="Güncellendi" class="whitespace-nowrap text-muted max-md:hidden">
              <time datetime="{{ series.updatedAt }}" title="{{ dateOf(series.updatedAt) }}">{{ agoOf(series.updatedAt) }}</time>
            </td>
            <td class="actions">
              <div class="admin-actions">
                @!component('components/ui/button', { variant: 'ghost', size: 'sm', icon: 'pencil', href: '/admin/seriler/' + series.id + '/duzenle', label: 'Düzenle: ' + series.title, title: 'Düzenle' })
                @!component('components/ui/button', { variant: 'ghost', size: 'sm', icon: 'document', href: '/admin/bolumler?series_id=' + series.id, label: 'Bölümler: ' + series.title, title: 'Bölümler' })
                @if(siteUrl)
                @!component('components/ui/button', { variant: 'ghost', size: 'sm', icon: 'external', href: siteUrl, target: '_blank', rel: 'noopener', label: 'Sitede aç: ' + series.title, title: 'Sitede aç' })
                @end
                <form action="/admin/seriler/{{ series.id }}/sil" method="POST" data-submit-once
                      data-confirm="“{{ series.title }}” serisi{{ chapterCount ? ', ' + chapterCount + ' bölümü' : '' }}, yorumları, incelemeleri ve okuma kayıtlarıyla birlikte kalıcı olarak silinecek. Bu işlem geri alınamaz."
                      data-confirm-title="Seri silinsin mi?" data-confirm-label="Seriyi sil">
                  {{ csrfField() }}
                  @!component('components/ui/button', { type: 'submit', variant: 'ghost', size: 'sm', icon: 'trash', label: 'Sil: ' + series.title, title: 'Sil', class: 'admin-danger' })
                </form>
              </div>
            </td>
          </tr>
          @end
        </tbody>
      </table>
    </div>

    <div class="admin-listfoot">
      <p class="admin-listfoot__info">{{ number(first) }}–{{ number(last) }} / {{ number(seriesList.total) }} seri</p>
      @!component('components/ui/pagination', { current: seriesList.currentPage, total: seriesList.lastPage, label: 'Seri sayfaları' })
      <form method="GET" action="/admin/seriler" class="admin-perpage" x-data>
        @each((value, key) in { search: filters.search, status: filters.status, type: filters.type })
        @if(value)
        <input type="hidden" name="{{ key }}" value="{{ value }}">
        @end
        @end
        <label for="per-page">Sayfa başına</label>
        <select id="per-page" name="per_page" class="control control--sm" @change="$el.form.requestSubmit()">
          @each(size in site.adminPageSizes)
          <option value="{{ size }}" {{ perPage === size ? 'selected' : '' }}>{{ size }}</option>
          @end
        </select>
        <noscript>
          <button type="submit" class="btn btn--secondary btn--sm">Uygula</button>
        </noscript>
      </form>
    </div>
    @elseif(seriesList.total)
    @component('components/ui/empty_state', { icon: 'list', title: 'Bu sayfada kayıt yok', description: 'İstenen sayfa son sayfadan sonra geliyor.' })
      @component('components/ui/button', { href: withQuery(request, { page: null }), icon: 'arrow-left' })
        İlk sayfaya dön
      @end
    @end
    @elseif(filtered)
    @component('components/ui/empty_state', { icon: 'search', title: 'Filtrelere uyan seri yok', description: 'Aramayı kısaltın ya da durum ve içerik türü filtrelerini kaldırın.' })
      @component('components/ui/button', { href: '/admin/seriler', icon: 'x' })
        Filtreleri temizle
      @end
    @end
    @else
    @component('components/ui/empty_state', { icon: 'library', title: 'Henüz seri eklenmemiş', description: 'İlk seriyi ekleyin; ardından bölümlerini yükleyebilirsiniz.' })
      @component('components/ui/button', { variant: 'primary', href: '/admin/seriler/ekle', icon: 'plus' })
        Yeni seri
      @end
    @end
    @end
  @end
@end
