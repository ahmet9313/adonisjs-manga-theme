{{--
  Admin → Kullanıcılar → Roller (Discord-like): the role list (colour dot, member count) and the
  selected role's editor: name and colour with a live badge preview (Alpine `roleEditor`,
  role_editor.js; POST label and color), the fixed permissions as read-only switches and the
  latest members. Texts "Rol rengi" and "Kozmetik ve kart yönetimi" are checked by theme.spec.
--}}
@let(labelValue = flashMessages.has('label') ? flashMessages.get('label') : selected.label)
@let(colorValue = flashMessages.has('color') ? flashMessages.get('color') : selected.color)
@let(colorError = flashMessages.has('inputErrorsBag.color') ? flashMessages.get('inputErrorsBag.color')[0] : '')
@let(me = auth.user)
@component('components/layout/admin', { title, description: 'Rollerin adını ve rengini değiştirin; rozetler, yorumlar ve profiller yeni görünümü kullanır. İzinler sabittir.' })
  @slot('actions')
    @component('components/ui/button', { href: '/admin/kullanicilar', icon: 'users' })
      Kullanıcıya rol ata
    @end
  @end

  @slot('main')
    <div class="ac-page ac-roles">
      <nav class="panel panel--tight ac-roles__list" aria-labelledby="roles-title">
        <h2 id="roles-title" class="t-overline px-2 pb-2">Roller · {{ roles.length }}</h2>
        <ul class="grid gap-1">
          @each(role in roles)
          <li>
            <a href="/admin/roller?rol={{ role.key }}" class="ac-role" {{ role.key === selected.key ? 'aria-current=page' : '' }}>
              <span class="ac-role-dot" style="--role: {{ role.color }}" aria-hidden="true"></span>
              <span class="min-w-0 flex-1 truncate">{{ role.label }}</span>
              <span class="ac-role__count" title="Üye sayısı">
                @!component('components/icon', { name: 'users' })
                <span class="sr-only">Üye sayısı:</span>
                {{ role.members.toLocaleString('tr-TR') }}
              </span>
            </a>
          </li>
          @end
        </ul>
        <p class="mt-3 px-2 text-xs leading-relaxed text-muted">Roller yetkisi azalan sırayla listelenir. Bir kullanıcının rolünü düzenleme sayfasından değiştirin.</p>
      </nav>

      <div class="ac-roles__main" x-data="roleEditor" data-label="{{ labelValue }}" data-color="{{ colorValue }}"
           data-default-label="{{ defaults.label }}" data-default-color="{{ defaults.color }}">
        <form action="/admin/roller/{{ selected.key }}" method="POST" class="panel" aria-labelledby="role-look-title" data-submit-once>
          {{ csrfField() }}
          <div class="panel__head">
            <div class="min-w-0">
              <h2 id="role-look-title" class="panel__title">Görünüm</h2>
              <p class="panel__desc">Rozet; yorumlarda, profillerde ve kullanıcı listesinde bu ad ve renkle görünür.</p>
            </div>
          </div>

          <div class="ac-role-preview" aria-label="Önizleme">
            <div class="user-chip">
              @!component('components/avatar', { user: me, size: 'h-10 w-10', text: 'text-sm' })
              <div class="min-w-0">
                <p class="user-chip__name">
                  <span>{{ me.fullName }}</span>
                  <span class="role-badge" :style="badgeStyle" x-text="label || '—'" style="{{ selected.style }}">{{ selected.label }}</span>
                </p>
                <p class="user-chip__meta">Önizleme · yorum başlığı</p>
              </div>
            </div>
          </div>

          <div class="mt-5 grid gap-5">
            @!component('components/ui/field', { name: 'label', id: 'role-label', label: 'Rol adı', required: true, value: selected.label, minlength: 2, maxlength: 24, autocomplete: 'off', class: 'max-w-sm', hint: '2–24 karakter.', 'x-model': 'label' })

            <div class="field {{ colorError ? 'field--invalid' : '' }}">
              <label for="role-color" class="field__label">Rol rengi <span class="field__req" aria-hidden="true">*</span></label>
              <div class="flex flex-wrap items-center gap-3">
                <input type="color" class="ac-color-input" aria-label="Renk seçici" value="{{ selected.color }}" :value="validColor ? color.toLowerCase() : fallback" @input="pick($event.target.value)">
                <input id="role-color" name="color" type="text" class="control ac-hex" required maxlength="7" pattern="#[0-9a-fA-F]{6}" autocomplete="off" spellcheck="false"
                       value="{{ colorValue }}" x-model="color" aria-describedby="role-color-hint{{ colorError ? ' role-color-error' : '' }}"
                  @if(colorError)
                  aria-invalid="true"
                  @end
                  >
                <button type="button" class="btn btn--ghost btn--sm" @click="reset()" :disabled="isDefault">
                  @!component('components/icon', { name: 'refresh', class: 'btn__icon' })
                  Varsayılana dön
                </button>
              </div>
              <div class="ac-swatches" role="group" aria-label="Hazır renkler">
                <template x-for="swatch in swatches" :key="swatch">
                  <button type="button" class="ac-swatch" :style="'--swatch: ' + swatch" :aria-label="swatch" :title="swatch"
                          :aria-pressed="isPicked(swatch).toString()" @click="pick(swatch)"></button>
                </template>
              </div>
              <p id="role-color-hint" class="field__hint">#rrggbb biçiminde onaltılık renk. Varsayılan: <span class="ac-mono">{{ defaults.color }}</span>. Açık renkler koyu temada, koyu renkler açık temada daha iyi okunur.</p>
              @if(colorError)
              <p id="role-color-error" class="field__error" role="alert">{{ colorError }}</p>
              @end
            </div>
          </div>

          <div class="form-actions mt-5">
            @component('components/ui/button', { type: 'submit', variant: 'primary', icon: 'check' })
              Kaydet
            @end
          </div>
        </form>

        <section class="panel" aria-labelledby="role-perms-title">
          <div class="panel__head">
            <div class="min-w-0">
              <h2 id="role-perms-title" class="panel__title">İzinler</h2>
              <p class="panel__desc">İzinler rol başına sabittir; burada yalnızca görüntülenir.</p>
            </div>
          </div>
          <ul class="ac-perms">
            @each((permission, index) in permissions)
            <li>
              <label class="ac-perm" for="perm-{{ index }}">
                <span class="min-w-0 {{ permission.granted ? 'text-ink' : 'text-muted' }}">{{ permission.label }}</span>
                <span class="sr-only">{{ permission.granted ? 'Var' : 'Yok' }}</span>
                <input id="perm-{{ index }}" type="checkbox" role="switch" class="switch" disabled {{ permission.granted ? 'checked' : '' }}>
              </label>
            </li>
            @end
          </ul>
        </section>

        <section class="panel" aria-labelledby="role-members-title">
          <div class="panel__head">
            <div class="min-w-0">
              <h2 id="role-members-title" class="panel__title">Üyeler · {{ selected.members.toLocaleString('tr-TR') }}</h2>
              <p class="panel__desc">Bu role en son katılanlar.</p>
            </div>
            @if(selected.members > members.length)
            @component('components/ui/button', { variant: 'ghost', size: 'sm', href: '/admin/kullanicilar?role=' + selected.key, iconRight: 'arrow-right' })
              Tümünü gör
            @end
            @end
          </div>
          @if(members.length)
          <ul class="ac-members">
            @each(member in members)
            <li>
              @!component('components/ui/user_chip', { user: member, size: 'sm', meta: '@' + member.username, href: '/admin/kullanicilar/' + member.id + '/duzenle', class: 'ac-member' })
            </li>
            @end
          </ul>
          @else
          @!component('components/ui/empty_state', { icon: 'users', title: 'Bu role sahip kullanıcı yok', description: 'Kullanıcılar sayfasından bir hesabı düzenleyerek bu rolü atayabilirsiniz.' })
          @end
        </section>
      </div>
    </div>
  @end
@end
