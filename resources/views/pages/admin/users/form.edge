{{--
  Admin → Kullanıcılar → Düzenle: account summary, role choice (POST role, keeps the current
  suspension) and a separate suspend / unsuspend action (POST role + banned, with confirmation).
  Both post to the same route as before. Administrators cannot change their own role or status.
--}}
@let(me = auth.user)
@let(isSelf = member.id === me.id)
@let(level = levelOf(member).level)
@let(roleValue = flashMessages.has('role') ? flashMessages.get('role') : member.role)
@let(roleHints = { admin: 'Tam yetki: kozmetik, kart, tema, kullanıcı ve rol yönetimi dahil.', editor: 'Yönetim paneline girer; seri, bölüm ve sözlükleri yönetir, yorumları silebilir.', vip: 'Üye gibi siteyi kullanır, ayrıca VIP\'lere özel seri ve bölümleri açar. Yönetim paneline giremez.', member: 'Yalnızca siteyi kullanır: okur, yorum yapar ve kaydeder; üyelere özel içeriği açar.' })
@let(roleError = flashMessages.has('inputErrorsBag.role') ? flashMessages.get('inputErrorsBag.role')[0] : '')
@component('components/layout/admin', {
  title: member.fullName,
  description: '@' + member.username + ' · ' + member.email,
  crumbs: [{ label: 'Kullanıcılar', href: '/admin/kullanicilar' }, { label: 'Düzenle' }]
})
  @slot('actions')
    @if(!member.bannedAt)
    @component('components/ui/button', { href: '/uye/' + member.username, iconRight: 'external', target: '_blank', rel: 'noopener' })
      Profili aç
    @end
    @end
  @end

  @slot('main')
    <div class="ac-page ac-user">
      <aside class="panel ac-user__card" aria-labelledby="account-title">
        <h2 id="account-title" class="sr-only">Hesap özeti</h2>
        <div class="flex flex-col items-center gap-3 text-center">
          @!component('components/avatar', { user: member, size: 'h-20 w-20', text: 'text-2xl', frame: lookOf(member).frame })
          <div class="min-w-0">
            <p class="truncate text-lg font-extrabold text-ink">
              @!component('components/user_name', { user: member, look: lookOf(member) })
            </p>
            <p class="truncate text-sm text-muted">{{ '@' + member.username }}</p>
          </div>
          <p class="flex flex-wrap items-center justify-center gap-1.5">
            @!component('components/role_badge', { user: member })
            @!component('components/level_badge', { level })
            @if(member.bannedAt)
            @!component('components/ui/badge', { kind: 'danger', text: 'Askıda', size: 'sm' })
            @elseif(member.isOnline)
            @!component('components/ui/badge', { kind: 'success', text: 'Çevrimiçi', size: 'sm' })
            @end
          </p>
        </div>
        <div class="divider my-5"></div>
        <dl class="ac-facts">
          <div>
            <dt>E-posta</dt>
            <dd class="truncate" title="{{ member.email }}">{{ member.email }}</dd>
          </div>
          <div>
            <dt>Katıldı</dt>
            <dd>{{ member.createdAt ? dateOf(member.createdAt) : '—' }}</dd>
          </div>
          <div>
            <dt>Son giriş</dt>
            <dd>{{ member.lastLoginAt ? agoOf(member.lastLoginAt) : '—' }}</dd>
          </div>
          <div>
            <dt>Son görülme</dt>
            <dd>{{ member.isOnline ? 'Şimdi' : member.lastSeenAt ? agoOf(member.lastSeenAt) : '—' }}</dd>
          </div>
          <div>
            <dt>Deneyim</dt>
            <dd class="t-num">{{ Number(member.exp || 0).toLocaleString('tr-TR') }} EXP</dd>
          </div>
          <div>
            <dt>Giriş serisi</dt>
            <dd class="t-num">{{ member.streak || 0 }} gün</dd>
          </div>
        </dl>
      </aside>

      <div class="ac-user__main">
        @if(isSelf)
        @component('components/ui/alert', { tone: 'info', title: 'Bu sizin hesabınız' })
          <p>Kendi rolünüzü ve hesap durumunuzu değiştiremezsiniz; bunun için başka bir yöneticiye başvurun.</p>
        @end
        @end

        <form action="/admin/kullanicilar/{{ member.id }}/duzenle" method="POST" class="panel" aria-labelledby="role-title" data-submit-once>
          {{ csrfField() }}
          <div class="panel__head">
            <div class="min-w-0">
              <h2 id="role-title" class="panel__title">Rol</h2>
              <p class="panel__desc">Rol, yönetim panelinde neleri görebileceğini belirler. Ad ve renkler <a href="/admin/roller" class="link">Roller</a> sayfasından değişir.</p>
            </div>
          </div>
          @if(member.bannedAt)
          <input type="hidden" name="banned" value="on">
          @end
          <fieldset id="f-role" class="ac-fieldset"
            @if(roleError)
            aria-describedby="f-role-error"
            @end
            @if(isSelf)
            disabled
            @end
            >
            <legend class="sr-only">Rol seçin</legend>
            <div class="grid gap-2">
              @each(entry in roleList)
              <label class="ac-choice ac-choice--role">
                <input type="radio" name="role" value="{{ entry.key }}" class="ac-choice__input" {{ roleValue === entry.key ? 'checked' : '' }}>
                <span class="ac-role-dot" style="--role: {{ entry.color }}" aria-hidden="true"></span>
                <span class="ac-choice__text">
                  <span class="ac-choice__label">
                    <span class="role-badge" style="{{ entry.style }}">{{ entry.label }}</span>
                    @if(member.role === entry.key)
                    <span class="ml-1 text-xs font-semibold text-muted">· şu anki rol</span>
                    @end
                  </span>
                  <span class="ac-choice__hint">{{ roleHints[entry.key] }}</span>
                </span>
              </label>
              @end
            </div>
          </fieldset>
          @if(roleError)
          <p id="f-role-error" class="field__error mt-2" role="alert">{{ roleError }}</p>
          @end
          <div class="form-actions mt-5">
            @component('components/ui/button', { variant: 'ghost', href: '/admin/kullanicilar' })
              Vazgeç
            @end
            @component('components/ui/button', { type: 'submit', variant: 'primary', icon: 'check', disabled: isSelf })
              Rolü kaydet
            @end
          </div>
        </form>

        <section class="panel {{ member.bannedAt ? '' : 'ac-danger-zone' }}" aria-labelledby="status-title">
          <div class="panel__head">
            <div class="min-w-0">
              <h2 id="status-title" class="panel__title">Hesap durumu</h2>
              @if(member.bannedAt)
              <p class="panel__desc">Hesap {{ dateOf(member.bannedAt) }} tarihinden beri askıda: giriş yapamaz ve profili gizli.</p>
              @else
              <p class="panel__desc">Hesap etkin. Askıya alınan kullanıcı giriş yapamaz, açık oturumları kapatılır ve profili gizlenir.</p>
              @end
            </div>
            @if(member.bannedAt)
            @!component('components/ui/badge', { kind: 'danger', text: 'Askıda' })
            @else
            @!component('components/ui/badge', { kind: 'success', text: 'Aktif' })
            @end
          </div>
          @if(member.bannedAt)
          <form action="/admin/kullanicilar/{{ member.id }}/duzenle" method="POST" data-submit-once
                data-confirm="{{ '@' + member.username }} yeniden giriş yapabilecek ve profili herkese görünecek."
                data-confirm-title="Askı kaldırılsın mı?" data-confirm-label="Askıyı kaldır" data-confirm-tone="accent">
            {{ csrfField() }}
            <input type="hidden" name="role" value="{{ member.role }}">
            @component('components/ui/button', { type: 'submit', icon: 'check-circle', disabled: isSelf })
              Askıyı kaldır
            @end
          </form>
          @else
          <form action="/admin/kullanicilar/{{ member.id }}/duzenle" method="POST" data-submit-once
                data-confirm="{{ '@' + member.username }} giriş yapamayacak, açık oturumları kapatılacak ve profili gizlenecek. Askıyı daha sonra bu sayfadan kaldırabilirsiniz."
                data-confirm-title="Hesap askıya alınsın mı?" data-confirm-label="Askıya al">
            {{ csrfField() }}
            <input type="hidden" name="role" value="{{ member.role }}">
            <input type="hidden" name="banned" value="on">
            @component('components/ui/button', { type: 'submit', variant: 'danger', icon: 'x-circle', disabled: isSelf })
              Hesabı askıya al
            @end
          </form>
          @end
        </section>
      </div>
    </div>
  @end
@end
