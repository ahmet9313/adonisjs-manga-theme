                  <a href="/uye/{{ member.username }}" class="rounded border border-gray-700 px-3 py-1 text-xs text-gray-400 transition hover:border-gray-500">Profil</a>
                  @if(member.id !== auth.user.id)
                    <a href="/admin/kullanicilar/{{ member.id }}/duzenle" class="rounded border border-emerald-800 px-3 py-1 text-xs text-emerald-400 transition hover:border-emerald-600 hover:text-emerald-300">Düzenle</a>
                  @end
                </div>
              </td>
            </tr>
