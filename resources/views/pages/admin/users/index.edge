        <tbody>
          @each(member in users)
            <tr class="border-b border-gray-700/30 hover:bg-gray-800/30">
              <td class="px-5 py-3">
                <div class="flex items-center gap-3">
                  @!component('components/avatar', { user: member, size: 'h-9 w-9', text: 'text-sm' })
                  <div class="min-w-0">
                    <div class="truncate font-medium text-gray-200">{{ member.fullName }}</div>
                    <div class="truncate text-xs text-gray-500">&#64;{{ member.username }}</div>
                  </div>
                </div>
              </td>
              <td class="px-5 py-3 text-gray-400">{{ member.email }}</td>
              <td class="px-5 py-3">
                @!component('components/role_badge', { user: member })
              </td>
              <td class="px-5 py-3">
