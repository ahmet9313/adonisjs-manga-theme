{{--
  Home page. Page 1: featured carousel (layout banner slot, full width), then "Son Güncellenenler",
  "Popüler Seriler", "Türlere Göre Keşfet", the community block, "Ayın Okurları" and
  "Tamamlanan Seriler". From page 2 on (?page=) only the latest updates list is shown.
  Every section follows its Admin → Tema → Göster/Gizle switch (ui('home_*')); the controller does
  not query hidden sections, and sections without data are left out.
  The page's only <h1> is visually hidden: in front of the carousel when it is shown, else at the
  top of <main>.
--}}
@let(heroOn = ui('home_hero') && featured.length > 0)
@component('components/layout/main')

@slot('banner')
  @if(heroOn)
  <section class="home-intro" aria-labelledby="home-title">
    <h1 id="home-title" class="sr-only">{{ site.name }} — {{ site.description }}</h1>
    @include('partials/home/hero')
  </section>
  @end
@end

@slot('main')
  @if(!heroOn)
  <h1 class="sr-only">{{ site.name }} — {{ site.description }}</h1>
  @end

  @if(ui('home_updates'))
  @include('partials/home/updates')
  @end

  @if(currentPage === 1)
  @if(ui('home_popular') && popular.length)
  @include('partials/home/popular')
  @end

  @if(ui('home_genres') && genres.length)
  @include('partials/home/genres')
  @end

  @if(ui('home_community') && (latestComments.length || topReviews.length))
  @include('partials/home/community')
  @end

  @if(ui('home_readers') && readers.length)
  @include('partials/home/readers')
  @end

  @if(ui('home_completed') && completed.length)
  @include('partials/home/completed')
  @end
  @end
@end

@end
