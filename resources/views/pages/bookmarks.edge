{{--
  Saved series (/kaydedilenler). The grid is drawn in the browser by bookmarkPage
  (bookmarks.js) with the same classes as components/series/card. Members get their list in
  data-items (compact JSON, rendered by the server); guests have no data-items attribute and
  read localStorage. "Hepsini kaldır" asks first through the shared confirm dialog (data-confirm).
--}}
@component('components/layout/main', { title: 'Kaydedilenler' })

@slot('main')
  @if(items)
  <div x-data="bookmarkPage" data-items="{{ JSON.stringify(items) }}" data-video-types="{{ JSON.stringify(videoTypes || []) }}">
  @else
  <div x-data="bookmarkPage" data-video-types="{{ JSON.stringify(videoTypes || []) }}">
  @end
    @component('components/ui/page_header', { title: 'Kaydedilenler', description: items ? 'Kaydettiğin seriler hesabında saklanır; her cihazda aynı listeyi görürsün.' : 'Kaydettiğin seriler ve kaldığın bölümler.' })
      <p class="mt-2 text-sm font-semibold text-(--t-text-2) t-num" x-cloak x-show="bookmarks.length > 0" x-text="summary"></p>
      @slot('actions')
        <form x-cloak x-show="bookmarks.length > 0" @submit.prevent="clearAll()"
              data-confirm="Kaydettiğin tüm seriler listeden kaldırılacak. Okuma geçmişin silinmez."
              data-confirm-title="Tüm kayıtlar kaldırılsın mı?" data-confirm-label="Hepsini kaldır" data-confirm-tone="danger">
          <button type="submit" class="btn btn--danger btn--md" :disabled="busy" aria-busy="false" :aria-busy="busy.toString()">
            @!component('components/icon', { name: 'trash', class: 'btn__icon' })
            <span>Hepsini kaldır</span>
          </button>
        </form>
      @end
    @end

    @if(!items)
    @component('components/ui/alert', { tone: 'info', title: 'Kayıtların yalnızca bu tarayıcıda', class: 'mb-6' })
      <p>Giriş yapmadan kaydettiğin seriler ve okuma geçmişin bu cihazda tutulur. Giriş yaptığında hesabına aktarılır ve her cihazdan erişebilirsin.</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <a href="/giris?next=%2Fkaydedilenler" class="btn btn--primary btn--sm" @click.prevent="$dispatch('open-auth', 'login')">
          @!component('components/icon', { name: 'login', class: 'btn__icon' })
          <span>Giriş yap</span>
        </a>
        <a href="/kayit?next=%2Fkaydedilenler" class="btn btn--secondary btn--sm" @click.prevent="$dispatch('open-auth', 'register')">
          <span>Ücretsiz hesap aç</span>
        </a>
      </div>
    @end
    @end

    <noscript>
      @component('components/ui/alert', { tone: 'warning', title: 'JavaScript kapalı', class: 'mb-6' })
        <p>Kaydedilenler listesi tarayıcında oluşturulur. Listeni görmek için JavaScript'i etkinleştir.</p>
      @end
    </noscript>

    <div x-cloak x-show="error" class="alert mb-6" data-tone="danger" role="alert">
      @!component('components/icon', { name: 'exclamation' })
      <p class="min-w-0 flex-1" x-text="error"></p>
    </div>

    {{-- Empty state --}}
    <div x-cloak x-show="bookmarks.length === 0 && !error" data-bookmarks-empty>
      @component('components/ui/empty_state', { icon: 'bookmark', title: 'Henüz kaydettiğin bir seri yok', description: 'Seri sayfalarındaki Kaydet düğmesiyle beğendiğin serileri buraya ekle; kaldığın bölümden devam etmek tek dokunuş olsun.' })
        @component('components/ui/button', { variant: 'primary', href: '/seriler', iconRight: 'arrow-right' })
          Serilere göz at
        @end
      @end
    </div>

    {{-- Grid: the markup of components/series/card, drawn by Alpine --}}
    <ul class="series-grid" x-cloak x-show="bookmarks.length > 0" aria-label="Kaydedilen seriler">
      <template x-for="item in bookmarks" :key="item.key">
        <li class="series-card bookmark-card">
          <a :href="seriesUrl(item)" class="series-card__cover" tabindex="-1" aria-hidden="true">
            <img :src="cover(item)" :data-veil="item.coverVeil === 'blur' ? 'blur' : null" alt="" width="300" height="400" loading="lazy" decoding="async" data-fallback="/images/no-cover.svg">
            <span class="cover-veil" aria-hidden="true" x-show="item.coverVeil === 'blur'">
              @!component('components/icon', { name: 'eye-off', stroke: 1.8, class: 'cover-veil__icon' })
            </span>
            <span class="series-card__badges">
              <span class="bookmark-card__flags">
                <span class="badge badge--sm badge--solid badge--caps" :data-tone="typeTone(item)" x-text="typeLabel(item)"></span>
                <span x-show="hasNew(item)" class="badge badge--sm badge--solid badge--caps bookmark-card__new" data-tone="accent">YENİ</span>
              </span>
            </span>
          </a>
          <button type="button" class="btn btn--secondary btn--sm btn--icon bookmark-card__remove" @click="removeBookmark(item.key)" :disabled="busy" :aria-label="removeLabel(item)" :title="removeLabel(item)">
            @!component('components/icon', { name: 'x', class: 'btn__icon' })
          </button>
          <div class="series-card__body">
            <h2 class="series-card__title"><a :href="seriesUrl(item)" x-text="item.title"></a></h2>
            <p class="series-card__meta">
              <span x-text="progressText(item)"></span>
              <span x-show="hasNew(item)" class="sr-only">, yeni bölüm var</span>
            </p>
            <a x-show="item.lastRead !== null" :href="chapterUrl(item, item.lastRead)" class="btn btn--secondary btn--sm btn--block bookmark-card__cta" x-text="continueText(item)"></a>
            <a x-show="item.lastRead === null" :href="seriesUrl(item)" class="btn btn--secondary btn--sm btn--block bookmark-card__cta">Seriyi aç</a>
          </div>
        </li>
      </template>
    </ul>
  </div>
@end

@end
