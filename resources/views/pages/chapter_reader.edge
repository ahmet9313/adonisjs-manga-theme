{{--
  Chapter reader: sticky toolbar (banner slot, ui('reader_toolbar')), chapter header, pages or
  novel text, end-of-chapter card, bottom navigation and the chapter's comments.
  Hooks: readingTracker + data-chapter (guest history), data-reward-toast (EXP and card drops),
  reader (reading settings, webtoon/paged mode, page states, ← / → keys). readerView (mode and
  size from the `reader` cookie) lays the pages out before any script runs. and commentSection (loads when visible).
--}}
@let(seriesUrl = '/series/' + series.type + '/' + series.slug)
@let(chapterUrl = (number) => seriesUrl + '/' + number)
@let(typeLabel = series.type.charAt(0).toUpperCase() + series.type.slice(1))
@let(pageCount = chapter.pages ? chapter.pages.length : 0)
@let(isNovel = !pageCount && Boolean(chapter.textContent))
@let(readMinutes = isNovel ? Math.max(1, Math.round(chapter.textContent.trim().split(/\s+/).length / 200)) : 0)
@let(navId = 'top')
@let(layout = readerView || { mode: 'webtoon', zoom: 100 })
@component('components/layout/main', { title, description: series.title + ', Bölüm ' + chapter.number + (chapter.title ? ': ' + chapter.title : '') + '. ' + site.name + ' üzerinde oku.' })

@slot('banner')
  @if(ui('reader_toolbar'))
  @include('partials/reader/toolbar')
  @end
@end

@slot('main')
  @include('partials/draft_notice')
  <div x-data="readingTracker" data-chapter="{{ JSON.stringify({ type: series.type, slug: series.slug, number: chapter.number }) }}" hidden></div>
  @if(reward)
  <div hidden data-reward-toast="{{ JSON.stringify({ text: 'Yeni bölüm okundu: +' + reward.exp + ' EXP', tone: 'success' }) }}"></div>
  @if(reward.card)
  <div hidden data-reward-toast="{{ JSON.stringify({ text: 'Kart düştü! ' + reward.card.name + ' (' + reward.card.rarity + ')', tone: 'reward', image: reward.card.image }) }}"></div>
  @end
  @end

  <div class="reader" x-data="reader"
    data-mode="{{ pageCount ? layout.mode : 'webtoon' }}" :data-mode="paged ? 'paged' : 'webtoon'"
    style="--reader-zoom: {{ layout.zoom / 100 }}" :style="'--reader-zoom:' + zoomScale"
    data-config="{{ JSON.stringify({ base: seriesUrl + '/', prev: prevChapter ? chapterUrl(prevChapter.number) : null, next: nextChapter ? chapterUrl(nextChapter.number) : null }) }}">
    <header class="reader-head">
      <a href="{{ seriesUrl }}" class="reader-head__series">
        @!component('components/icon', { name: 'arrow-left', class: 'h-4 w-4' })
        {{ series.title }}
      </a>
      <h1 class="reader-head__title"><span class="sr-only">{{ series.title }}, </span>Bölüm {{ chapter.number }}<span class="reader-head__name">{{ chapter.title ? ': ' + chapter.title : '' }}</span></h1>
      <p class="reader-head__meta">
        @!component('components/ui/badge', { kind: 'type', value: series.type, size: 'sm' })
        @if(pageCount)
        <span>{{ pageCount }} sayfa</span>
        @elseif(isNovel)
        <span>Yaklaşık {{ readMinutes }} dk okuma</span>
        @end
        @if(chapter.timeAgo)
        <span aria-hidden="true">·</span>
        <span>{{ chapter.timeAgo }}</span>
        @end
      </p>
    </header>

    @if(!ui('reader_toolbar'))
    @include('partials/reader/nav')
    @end

    <div id="reader-content" class="reader-content">
      @include('partials/reader/pages')
    </div>

    @include('partials/reader/end_card')

    @assign(navId = 'bottom')
    @include('partials/reader/nav')
  </div>

  @if(ui('reader_comments'))
  <div class="reader-comments">
    @include('partials/comments/section')
  </div>
  @end
@end

@end
