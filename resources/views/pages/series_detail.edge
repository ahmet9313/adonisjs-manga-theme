{{--
  Series page: banner art, header (cover, title, metadata, actions), information column,
  chapter list, ratings/reviews, comments and similar series. Every block follows the
  Admin → Tema → Göster/Gizle switches (ui('series_*')).
--}}
@let(seriesUrl = '/series/' + series.type + '/' + series.slug)
@let(typeLabel = series.type.charAt(0).toUpperCase() + series.type.slice(1))
{{-- Video series (content type format, Admin → İçerik Türleri): the partials say "izle" instead of "oku". --}}
@let(isVideo = series.format === 'video')
@let(hasKeywords = ui('series_keywords') && series.keywords && series.keywords.length > 0)
@let(hasAside = ui('series_sidebar') || hasKeywords)
@component('components/layout/main', { title, description })

@slot('banner')
  <div class="series-banner" data-art="{{ series.bannerImage ? 'banner' : 'cover' }}" aria-hidden="true">
    <img src="{{ series.bannerImage || series.coverImage }}" alt="" decoding="async" fetchpriority="high" data-fallback="{{ series.bannerImage ? series.coverImage : '' }}">
  </div>
@end

@slot('main')
  @include('partials/draft_notice')
  <noscript>
    <style>
      .chapter-list > li[x-cloak] { display: block !important; }
      .chapters-panel__foot { display: none !important; }
      .series-desc__text.is-clamped { display: block; -webkit-line-clamp: unset; }
    </style>
  </noscript>

  @include('partials/series/hero')

  <div class="series-layout {{ hasAside ? '' : 'series-layout--single' }}">
    @include('partials/series/info')

    <div class="series-layout__main">
      @include('partials/series/chapters')

      @if(ui('series_reviews'))
      @include('partials/reviews/section')
      @end

      @if(ui('series_comments'))
      @include('partials/comments/section')
      @end
    </div>

    @if(hasKeywords)
    <aside class="series-layout__extra panel panel--tight" aria-labelledby="series-keywords-title">
      <h2 id="series-keywords-title" class="series-aside__title">
        @!component('components/icon', { name: 'tag', class: 'h-4 w-4' })
        Anahtar kelimeler
      </h2>
      <ul class="series-keywords">
        @each(keyword in series.keywords)
        <li>{{ keyword }}</li>
        @end
      </ul>
    </aside>
    @end
  </div>

  @if(ui('series_similar') && similar.length)
  <section class="section mt-12" aria-labelledby="similar-title">
    @!component('components/ui/section_head', { title: 'Benzer Seriler', id: 'similar-title', icon: 'sparkles', description: 'Aynı türden ve benzer konulu seriler' })
    <div class="series-grid">
      @each(item in similar)
      @!component('components/series/card', { series: item })
      @end
    </div>
  </section>
  @end
@end

@end
