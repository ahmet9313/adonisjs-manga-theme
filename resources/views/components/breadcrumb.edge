{{-- Breadcrumb starting at the home page (class `breadcrumb`). Props: items = [{ label, href? }], home ('/'), class. --}}
<nav aria-label="Konum" class="breadcrumb mb-4 {{ $props.get('class', '') }}">
  <ol>
    <li>
      <a href="{{ $props.get('home', '/') }}" class="inline-flex items-center gap-1.5">
        @!component('components/icon', { name: 'home', class: 'h-4 w-4' })
        <span class="sr-only">Ana sayfa</span>
      </a>
    </li>
    @each(entry in items)
    <li>
      @if(entry.href)
      <a href="{{ entry.href }}">{{ entry.label }}</a>
      @else
      <span aria-current="page">{{ entry.label }}</span>
      @end
    </li>
    @end
  </ol>
</nav>
