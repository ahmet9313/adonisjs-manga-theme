{{-- Sign-in form (page and dialog). Props: prefix (id prefix), next (redirect after sign-in). --}}
<form action="/giris" method="POST" class="space-y-4" data-submit-once>
  {{ csrfField() }}
  <input type="hidden" name="next" value="{{ next || '/' }}">
  @!component('components/ui/field', { id: prefix + '-login', name: 'login', label: 'Kullanıcı adı veya e-posta', required: true, autocomplete: 'username', autocapitalize: 'none', spellcheck: 'false', 'data-autofocus': true })
  @!component('components/auth/password', { id: prefix + '-password', name: 'password', label: 'Parola', autocomplete: 'current-password' })
  <div class="flex items-center justify-between gap-3">
    <label class="check">
      <input type="checkbox" name="remember" value="on">
      <span class="text-sm text-(--t-text-2)">Beni hatırla</span>
    </label>
  </div>
  <button type="submit" class="btn btn--primary btn--lg btn--block">Giriş yap</button>
</form>
