{{--
  Password field with a show/hide button (class `field`). Props: id, name, label, autocomplete,
  minlength, hint, required (true).
--}}
@let(error = flashMessages.has('inputErrorsBag.' + name) ? flashMessages.get('inputErrorsBag.' + name)[0] : '')
@let(hint = $props.get('hint', ''))
@let(describedBy = [error ? id + '-error' : '', hint ? id + '-hint' : ''].filter(Boolean).join(' '))
<div class="field {{ error ? 'field--invalid' : '' }}" x-data="{ show: false }">
  <label for="{{ id }}" class="field__label">{{ label }}</label>
  <div class="relative">
    <input type="password" :type="show ? 'text' : 'password'" id="{{ id }}" name="{{ name }}" class="control pr-11" autocomplete="{{ $props.get('autocomplete', 'current-password') }}"
      @if($props.get('required', true))
      required
      @end
      @if($props.get('minlength'))
      minlength="{{ $props.get('minlength') }}"
      @end
      @if(describedBy)
      aria-describedby="{{ describedBy }}"
      @end
      @if(error)
      aria-invalid="true"
      @end
      >
    <button type="button" @click="show = !show" class="btn btn--ghost btn--sm btn--icon absolute right-1 top-1/2 -translate-y-1/2"
            aria-label="Parolayı göster" :aria-label="show ? 'Parolayı gizle' : 'Parolayı göster'" aria-pressed="false" :aria-pressed="show.toString()">
      <span x-show="!show">
        @!component('components/icon', { name: 'eye', class: 'btn__icon' })
      </span>
      <span x-cloak x-show="show">
        @!component('components/icon', { name: 'eye-off', class: 'btn__icon' })
      </span>
    </button>
  </div>
  @if(hint)
  <p id="{{ id }}-hint" class="field__hint">{{ hint }}</p>
  @end
  @if(error)
  <p id="{{ id }}-error" class="field__error" role="alert">{{ error }}</p>
  @end
</div>
