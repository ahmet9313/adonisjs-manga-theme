{{-- Registration form (page and dialog). Props: prefix (id prefix), next (redirect afterwards). --}}
<form action="/kayit" method="POST" class="space-y-4" data-submit-once>
  {{ csrfField() }}
  <input type="hidden" name="next" value="{{ next || '/' }}">
  @!component('components/ui/field', { id: prefix + '-username', name: 'username', label: 'Kullanıcı adı', required: true, autocomplete: 'username', autocapitalize: 'none', spellcheck: 'false', placeholder: 'ornek_kullanici', hint: 'Profil adresin olur: /uye/kullanici-adi', 'data-autofocus': true })
  @!component('components/ui/field', { id: prefix + '-email', name: 'email', type: 'email', label: 'E-posta', required: true, autocomplete: 'email', placeholder: 'ornek@eposta.com' })
  @!component('components/auth/password', { id: prefix + '-reg-password', name: 'password', label: 'Parola', autocomplete: 'new-password', minlength: 8, hint: 'En az 8 karakter.' })
  @!component('components/auth/password', { id: prefix + '-reg-confirm', name: 'password_confirmation', label: 'Parola (tekrar)', autocomplete: 'new-password' })
  <button type="submit" class="btn btn--primary btn--lg btn--block">Hesap oluştur</button>
</form>
