{{--
  Error pages (403/404/500). Unlike `main`, this layout must not depend on the session, CSRF,
  auth or JavaScript: unmatched URLs skip the router middleware, so those helpers are undefined.
  Props: code, title, message.
--}}
@let(scheme = schemeOf(request))
<!DOCTYPE html>
<html lang="{{ site.language }}" data-theme="{{ scheme }}"{{{ themeAttrs() }}}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <title>{{ title ? title + ' — ' + site.name : site.name }}</title>
  {{{ themeMeta(scheme) }}}
  @if(site.favicon)
  <link rel="icon" href="{{ site.favicon }}">
  @else
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  @end
  @vite(['resources/css/app.css'])
  @if(themeCss())
  <style>{{{ themeCss() }}}</style>
  @end
</head>
<body class="site-bg flex min-h-screen flex-col">
  <a href="#main" class="skip-link">İçeriğe atla</a>
  <header class="site-header border-b border-(--t-border)">
    <div class="mx-auto flex h-16 max-w-(--t-container) items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
      <a href="/" class="logo">
        @if(site.logo)
        <img src="{{ site.logo }}" alt="" class="logo__img">
        @else
        <span class="logo__mark" aria-hidden="true">{{ site.name.charAt(0).toUpperCase() }}</span>
        @end
        <span class="logo__text">{{ site.name }}</span>
        <span class="sr-only">ana sayfa</span>
      </a>
      <nav aria-label="Ana menü">
        <ul class="flex items-center gap-1">
          <li><a href="/" class="nav-link">Ana Sayfa</a></li>
          <li><a href="/seriler" class="nav-link">Seriler</a></li>
        </ul>
      </nav>
    </div>
  </header>
  <main id="main" tabindex="-1" class="mx-auto flex w-full max-w-(--t-container) flex-1 items-center justify-center px-4 py-16 outline-none">
    <section class="panel w-full max-w-lg text-center" aria-labelledby="error-title">
      <p class="t-display t-num text-(--t-muted)" aria-hidden="true">{{ code }}</p>
      <h1 id="error-title" class="t-h2 mt-2">{{ title }}</h1>
      <p class="mx-auto mt-2 max-w-sm text-(--t-muted)">{{ message }}</p>
      @if(code === 404)
      <form action="/seriler" method="GET" role="search" class="mx-auto mt-6 flex max-w-sm gap-2">
        <label for="error-search" class="sr-only">Seri ara</label>
        <input id="error-search" type="search" name="search" placeholder="Seri ara…" class="control" autocomplete="off">
        <button type="submit" class="btn btn--secondary btn--md">Ara</button>
      </form>
      @end
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn--primary btn--md">Ana sayfaya dön</a>
        <a href="/seriler" class="btn btn--secondary btn--md">Serilere göz at</a>
      </div>
    </section>
  </main>
  @include('partials/footer')
</body>
</html>
