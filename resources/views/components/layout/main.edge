</head>
<body class="site-bg text-gray-200 min-h-screen flex flex-col font-sans" data-account="{{ auth && auth.user ? '1' : '0' }}" data-unread="{{ account ? account.unread : 0 }}" data-name="{{ auth && auth.user ? auth.user.fullName : '' }}">
