{{--
  Public layout. Props: title, description, noindex (gate pages). Slots: main, banner (full-width
  content between the header and the page container, e.g. the home hero), meta (extra <head> tags).
  Canonical, robots, Open Graph/Twitter, feed links and JSON-LD come from seoHead (seo_service)
  with the `seo` details a controller shared.
  The colour scheme is chosen on the server (schemeOf), so the first paint is never wrong.
--}}
@let(scheme = schemeOf(request))
<!DOCTYPE html>
<html lang="{{ site.language }}" data-theme="{{ scheme }}"{{{ themeAttrs() }}}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title && title !== site.name ? title + ' — ' + site.name : site.name }}</title>
  <meta name="description" content="{{ description ?? site.description }}">
  {{{ seoHead(request, { title, description, noindex, seo }) }}}
  <meta name="csrf-token" content="{{ csrfToken || '' }}">
  {{{ themeMeta(scheme) }}}
  @if(site.favicon)
  <link rel="icon" href="{{ site.favicon }}">
  @else
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  @end
  @if($slots.meta)
  {{{ await $slots.meta() }}}
  @end
  @vite(['resources/css/app.css', 'resources/js/app.js'])
  @if(themeCss())
  <style>{{{ themeCss() }}}</style>
  @end
</head>
<body class="site-bg flex min-h-screen flex-col" data-account="{{ auth && auth.user ? '1' : '0' }}" data-unread="{{ account ? account.unread : 0 }}" data-name="{{ auth && auth.user ? auth.user.fullName : '' }}">
  <a href="#main" class="skip-link">İçeriğe atla</a>
  @include('partials/announcement')
  @include('partials/navbar')
  @if($slots.banner)
  {{{ await $slots.banner() }}}
  @end
  <main id="main" tabindex="-1" class="mx-auto w-full max-w-(--t-container) flex-1 px-4 pb-12 outline-none sm:px-6 lg:px-8 {{ $slots.banner ? 'pt-2' : 'pt-6 sm:pt-8' }}">
    {{{ await $slots.main() }}}
  </main>
  @include('partials/footer')
  @include('partials/bottom_nav')

  {{-- Dialogs, notifications and background helpers (dialogs are teleported to the end of <body>). --}}
  @if(auth && auth.user)
  <div x-data="librarySync" hidden></div>
  @include('partials/community/inbox')
  @include('partials/community/inventory')
  @else
  @include('partials/auth_modal')
  @end
  @include('partials/ui/toast')
  @include('partials/ui/confirm')
  @include('partials/report/dialog')
</body>
</html>
