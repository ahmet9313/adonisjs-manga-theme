{{--
  Admin layout. Props: title (page <h1> and <title>), description, crumbs ([{ label, href? }]
  after "Panel"; default: the title). Slots: main, actions (buttons next to the page title).
  The sidebar groups come from config/admin_nav.ts and are filtered by role.
  Contracts (tests/functional/theme.spec.ts): every group label is directly followed by its
  chevron <svg>, item icons come before the label, the active item has
  `href="…" aria-current=page`, and the sidebar precedes the page in the document.
--}}
@let(themed = adminThemed(request.qs()))
@let(scheme = themed ? schemeOf(request) : 'dark')
@let(me = auth.user)
@let(crumbList = crumbs || (title && title !== 'Panel' ? [{ label: title }] : []))
<!DOCTYPE html>
<html lang="{{ site.language }}" data-theme="{{ scheme }}"{{{ themed ? themeAttrs() : '' }}}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <meta name="csrf-token" content="{{ csrfToken || '' }}">
  {{{ themeMeta(scheme) }}}
  @if(site.favicon)
  <link rel="icon" href="{{ site.favicon }}">
  @else
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  @end
  <title>{{ title || 'Panel' }} — {{ site.name }} Yönetim</title>
  @vite(['resources/css/app.css', 'resources/js/app.js'])
  @if(themed && themeCss())
  <style>{{{ themeCss() }}}</style>
  @end
</head>
<body class="site-bg min-h-screen" data-account="1" data-unread="0" data-name="{{ me.fullName }}"
      x-data="adminShell" @keydown.escape.window="closeNav()">
  <a href="#main" class="skip-link">İçeriğe atla</a>

  <aside id="admin-navigation" class="admin-sidebar admin-chrome" aria-label="Yönetim"
         data-open="false" :data-open="navOpen.toString()" :inert="!navOpen && !desktop" x-trap.noscroll="navOpen && !desktop">
    <div class="flex h-16 shrink-0 items-center gap-2 border-b border-(--t-border) px-4">
      <a href="/admin" class="logo min-w-0">
        @if(site.logo)
        <img src="{{ site.logo }}" alt="" class="logo__img">
        @else
        <span class="logo__mark" aria-hidden="true">{{ site.name.charAt(0).toUpperCase() }}</span>
        @end
        <span class="logo__text truncate">{{ site.name }}</span>
        <span class="sr-only">yönetim paneli</span>
      </a>
      <span class="badge badge--sm" data-tone="accent">Yönetim</span>
      <button type="button" class="btn btn--ghost btn--sm btn--icon ml-auto lg:hidden" @click="closeNav()" aria-label="Menüyü kapat">
        @!component('components/icon', { name: 'x', class: 'btn__icon' })
      </button>
    </div>

    <nav class="flex-1 space-y-4 overflow-y-auto px-3 py-4" aria-label="Yönetim menüsü">
      @each(group in adminNav)
        @if(group.roles.includes(me.role))
          <div>
            @if(group.label)
            <button type="button" class="admin-group" @click="toggleGroup('{{ group.key }}')"
                    aria-expanded="true" :aria-expanded="isGroupOpen('{{ group.key }}').toString()" aria-controls="nav-{{ group.key }}">
              {{ group.label }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/></svg>
            </button>
            @end
            <ul id="nav-{{ group.key }}" class="mt-1 space-y-0.5 pl-3" x-show="isGroupOpen('{{ group.key }}')">
              @each(item in group.items)
                @let(active = item.exact ? request.url() === item.href : request.url().startsWith(item.href))
                <li>
                  <a href="{{ item.href }}" {{ active ? 'aria-current=page' : '' }} class="admin-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="{{ item.icon }}"/></svg>
                    {{ item.label }}
                  </a>
                </li>
              @end
            </ul>
          </div>
        @end
      @end
    </nav>

    <div class="shrink-0 space-y-1 border-t border-(--t-border) p-3">
      <a href="/" class="admin-link">
        @!component('components/icon', { name: 'external' })
        Siteye dön
      </a>
      <form action="/cikis" method="POST">
        {{ csrfField() }}
        <button type="submit" class="admin-link w-full text-(--t-danger)">
          @!component('components/icon', { name: 'logout' })
          Çıkış yap
        </button>
      </form>
    </div>
  </aside>
  <div x-cloak x-show="navOpen" x-transition.opacity.duration.150ms class="fixed inset-0 z-[79] bg-(--t-scrim) lg:hidden" @click="closeNav()" aria-hidden="true"></div>

  <div class="flex min-h-screen flex-col lg:pl-64">
    <header class="admin-chrome sticky top-0 z-30 border-b border-(--t-border) bg-(--t-header-bg)">
      <div class="flex h-16 items-center gap-3 px-4 sm:px-6 lg:px-8">
        <button type="button" x-ref="navButton" class="btn btn--ghost btn--md btn--icon -ml-2 lg:hidden" @click="toggleNav()"
                aria-controls="admin-navigation" aria-expanded="false" :aria-expanded="navOpen.toString()" aria-label="Yönetim menüsü">
          @!component('components/icon', { name: 'menu', class: 'btn__icon' })
        </button>
        <nav aria-label="Konum" class="breadcrumb min-w-0">
          <ol class="flex-nowrap">
            <li><a href="/admin">Panel</a></li>
            @each(crumb in crumbList)
            <li class="min-w-0">
              @if(crumb.href)
              <a href="{{ crumb.href }}" class="truncate">{{ crumb.label }}</a>
              @else
              <span aria-current="page" class="truncate">{{ crumb.label }}</span>
              @end
            </li>
            @end
          </ol>
        </nav>
        <div class="ml-auto flex items-center gap-1.5">
          @if(themed)
          <div class="hidden sm:block">
            @!component('components/ui/theme_switch')
          </div>
          @end
          <a href="/" target="_blank" rel="noopener" class="btn btn--ghost btn--md btn--icon" aria-label="Siteyi yeni sekmede aç" title="Siteyi aç">
            @!component('components/icon', { name: 'external', class: 'btn__icon' })
          </a>
          @component('components/ui/dropdown', { id: 'admin-account', label: 'Hesap menüsü: ' + me.fullName, iconOnly: true, align: 'right', buttonClass: 'flex h-10 w-10 items-center justify-center rounded-full' })
            @slot('trigger')
              @!component('components/avatar', { user: me, size: 'h-8 w-8', text: 'text-xs' })
            @end
            <div class="px-2.5 pb-2 pt-1.5">
              <p class="truncate text-sm font-bold text-(--t-heading)">{{ me.fullName }}</p>
              <p class="truncate text-xs text-(--t-muted)">{{ me.email }}</p>
            </div>
            <div class="menu__sep" role="separator"></div>
            <a href="/uye/{{ me.username }}" class="menu__item">
              @!component('components/icon', { name: 'user' })
              Profilim
            </a>
            <a href="/ayarlar" class="menu__item">
              @!component('components/icon', { name: 'cog' })
              Hesap ayarları
            </a>
            <div class="menu__sep" role="separator"></div>
            <form action="/cikis" method="POST">
              {{ csrfField() }}
              <button type="submit" class="menu__item menu__item--danger">
                @!component('components/icon', { name: 'logout' })
                Çıkış yap
              </button>
            </form>
          @end
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1" class="w-full flex-1 px-4 py-6 outline-none sm:px-6 lg:px-8 lg:py-8">
      <header class="page-head">
        <div class="min-w-0">
          <h1 class="page-head__title">{{ title || 'Panel' }}</h1>
          @if(description)
          <p class="page-head__desc">{{ description }}</p>
          @end
        </div>
        @if($slots.actions)
        <div class="page-head__actions">
          {{{ await $slots.actions() }}}
        </div>
        @end
      </header>
      {{{ await $slots.main() }}}
    </main>
  </div>

  @include('partials/ui/toast')
  @include('partials/ui/confirm')
</body>
</html>
