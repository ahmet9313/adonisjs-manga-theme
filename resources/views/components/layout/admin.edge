<!DOCTYPE html>
<html lang="tr"{{{ adminThemed(request.qs()) ? themeAttrs() : '' }}}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title || 'Admin' }} - {{ site.name }}</title>
  @vite(['resources/css/app.css', 'resources/js/app.js'])
  @if(adminThemed(request.qs()) && themeCss())
  <style>{{{ themeCss() }}}</style>
  @end
</head>
<body class="site-bg min-h-screen font-sans text-gray-200" x-data="{ sidebarOpen: false }" @keydown.escape.window="sidebarOpen = false">

  {{-- Mobile overlay --}}
  <div x-cloak x-show="sidebarOpen" @click="sidebarOpen = false"
       class="fixed inset-0 bg-black/50 z-40 lg:hidden" x-transition.opacity></div>

  {{-- Sidebar --}}
  <aside id="admin-navigation" class="admin-chrome glass-strong fixed top-0 left-0 z-50 h-full w-64 border-r border-white/10 flex flex-col transition-transform duration-200"
         :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'">
    {{-- Logo --}}
    <div class="p-5 border-b border-white/10">
      <a href="/admin" class="text-xl font-bold bg-gradient-to-r from-(--t-logo-1) via-(--t-logo-2) to-(--t-logo-3) bg-clip-text text-transparent">
        {{ site.name }} Admin
      </a>
    </div>

    {{-- Navigation: groups come from config/admin_nav.ts --}}
    <nav class="flex-1 space-y-4 overflow-y-auto p-4" aria-label="Yönetim menüsü">
      @each(group in adminNav)
        @if(group.roles.includes(auth.user.role))
          <div x-data="{ open: true }">
            @if(group.label)
              <button type="button" @click="open = !open" :aria-expanded="open.toString()" aria-controls="nav-{{ group.key }}"
                      class="mb-1 flex w-full items-center justify-between rounded px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-gray-500 transition hover:text-gray-300">
                {{ group.label }}
                <svg class="h-3.5 w-3.5 transition-transform" :class="open ? '' : '-rotate-90'" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </button>
            @end
            <div id="nav-{{ group.key }}" x-show="open" class="space-y-0.5">
              @each(item in group.items)
                @let(active = item.exact ? request.url() === item.href : request.url().startsWith(item.href))
                <a href="{{ item.href }}" {{ active ? 'aria-current=page' : '' }}
                   class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition {{ active ? 'bg-emerald-500/10 text-emerald-400' : 'text-gray-400 hover:bg-gray-800 hover:text-gray-200' }}">
                  <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="{{ item.icon }}"/></svg>
                  {{ item.label }}
                </a>
              @end
            </div>
          </div>
        @end
      @end

      <div class="border-t border-white/10 my-3"></div>

      <a href="/ayarlar" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-400 hover:bg-gray-800 hover:text-gray-200 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        Hesabım
      </a>
    </nav>

    {{-- Footer --}}
    <div class="p-4 border-t border-white/10">
      <a href="/" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-gray-400 hover:bg-gray-800 hover:text-gray-200 transition mb-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        Siteye Dön
      </a>
      <form action="/cikis" method="POST">
        {{ csrfField() }}
        <button type="submit" class="flex items-center gap-2 w-full px-3 py-2 rounded-lg text-sm text-red-400 hover:bg-red-900/20 hover:text-red-300 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          Çıkış Yap
        </button>
      </form>
    </div>
  </aside>

  {{-- Main content --}}
  <div class="lg:ml-64 min-h-screen">
    {{-- Top bar --}}
    <header class="admin-chrome glass-strong sticky top-0 z-30 border-b border-white/10">
      <div class="flex items-center justify-between px-4 lg:px-6 h-14">
        <div class="flex min-w-0 items-center gap-3">
          <button @click="sidebarOpen = !sidebarOpen" aria-label="Yönetim menüsü" aria-controls="admin-navigation" :aria-expanded="sidebarOpen" class="lg:hidden text-gray-400 hover:text-(--t-heading)">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
          <h2 class="text-lg font-semibold text-gray-200 truncate">{{ title || 'Panel' }}</h2>
        </div>
        <a href="/uye/{{ auth.user.username }}" class="hidden sm:flex max-w-[40%] items-center gap-2 text-sm text-gray-400 hover:text-(--t-heading)" title="{{ auth.user.email }}">
          @!component('components/avatar', { user: auth.user, size: 'h-7 w-7', text: 'text-xs' })
          <span class="truncate">{{ auth.user.fullName }}</span>
        </a>
      </div>
    </header>

    {{-- Page content --}}
    <main class="p-4 lg:p-6">
      @include('partials/admin/flash_messages')
      {{{ await $slots.main() }}}
    </main>
  </div>
</body>
</html>
