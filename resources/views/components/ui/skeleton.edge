{{--
  Loading placeholders (class `skeleton`). Decorative: hidden from assistive technology; pair
  them with a visually hidden status text ("Yükleniyor…") in the surrounding region.
  Props: variant text|card|row|comment (text), count (1), class.
--}}
@let(count = Number($props.get('count', 1)))
@let(variant = $props.get('variant', 'text'))
<div class="{{ variant === 'card' ? 'series-grid' : 'space-y-3' }} {{ $props.get('class', '') }}" aria-hidden="true">
  @each(index in Array.from({ length: count }, (_, i) => i))
    @if(variant === 'card')
    <div class="space-y-2">
      <div class="skeleton aspect-[3/4] rounded-(--radius-card)"></div>
      <div class="skeleton h-3.5 w-4/5"></div>
      <div class="skeleton h-3 w-1/2"></div>
    </div>
    @elseif(variant === 'row')
    <div class="flex items-center gap-3">
      <div class="skeleton h-16 w-12 shrink-0"></div>
      <div class="flex-1 space-y-2">
        <div class="skeleton h-3.5 w-2/3"></div>
        <div class="skeleton h-3 w-1/3"></div>
      </div>
    </div>
    @elseif(variant === 'comment')
    <div class="card flex gap-3 p-4">
      <div class="skeleton h-10 w-10 shrink-0 rounded-full"></div>
      <div class="flex-1 space-y-2">
        <div class="skeleton h-3.5 w-40"></div>
        <div class="skeleton h-3 w-full"></div>
        <div class="skeleton h-3 w-3/4"></div>
      </div>
    </div>
    @else
    <div class="skeleton h-3.5 {{ index % 3 === 2 ? 'w-2/3' : 'w-full' }}"></div>
    @end
  @end
</div>
