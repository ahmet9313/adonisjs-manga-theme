{{--
  Badge (achievement) card of the badges page (class `badge-card`, resources/css/pages/rewards.css).
  Props: badge (an entry of progress.badgeBoard: name, description, icon, tone, exp, goal, value,
         earnedAt), level (heading tag, h3), class.
  Earned: the icon tile in the badge's tone and the date it was earned. Locked: a muted, dashed
  card with the progress towards the goal. The Tailwind gradient of config/rewards.ts (`tone`)
  is mapped to a design-system tone (data-tone), so the tile follows both colour schemes.
--}}
@let(badge = $props.get('badge'))
@let(level = $props.get('level', 'h3'))
@let(earned = Boolean(badge.earnedAt))
@let(hue = String(badge.tone || '').split(' ')[0].replace('from-', '').split('-')[0])
@let(tone = { emerald: 'success', green: 'success', lime: 'success', teal: 'success', sky: 'info', blue: 'info', cyan: 'info', amber: 'warning', yellow: 'warning', orange: 'warning', red: 'danger', rose: 'danger' }[hue] || 'accent')
@let(goal = Math.max(1, Number(badge.goal) || 1))
@let(value = Math.min(goal, Math.max(0, Number(badge.value) || 0)))
<article class="badge-card {{ $props.get('class', '') }}" data-tone="{{ tone }}" data-earned="{{ earned ? 'true' : 'false' }}">
  <span class="badge-card__icon" aria-hidden="true">
    <span class="badge-card__glyph">{{ badge.icon }}</span>
    @if(!earned)
    <span class="badge-card__lock">
      @!component('components/icon', { name: 'lock', class: 'h-3 w-3', stroke: 2 })
    </span>
    @end
  </span>
  <div class="min-w-0 flex-1">
    <div class="flex items-start justify-between gap-2">
      <{{ level }} class="badge-card__name">{{ badge.name }}</{{ level }}>
      @if(badge.exp)
      @!component('components/ui/badge', { kind: earned ? 'accent' : 'neutral', text: '+' + badge.exp + ' EXP', size: 'sm', class: 'mt-0.5' })
      @end
    </div>
    <p class="badge-card__desc">{{ badge.description }}</p>
    @if(earned)
    <p class="badge-card__earned">
      @!component('components/icon', { name: 'check-circle' })
      <span>Kazanıldı · <time datetime="{{ String(badge.earnedAt).replace(' ', 'T') + 'Z' }}">{{ dateOf(badge.earnedAt) }}</time></span>
    </p>
    @else
    <div class="badge-card__progress">
      <div class="flex items-center justify-between gap-2 text-xs">
        <span class="text-muted">Kilitli</span>
        <span class="t-num font-bold text-body-2">{{ value.toLocaleString('tr-TR') }} / {{ goal.toLocaleString('tr-TR') }}</span>
      </div>
      @!component('components/ui/progress', { value, max: goal, label: badge.name + ' rozetine ilerleme', valueText: value + ' / ' + goal, size: 'sm', class: 'mt-1.5' })
    </div>
    @end
  </div>
</article>
