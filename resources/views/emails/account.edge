{{--
  Account mail (HTML part): password reset, e-mail verification and the e-mail change notice.
  Data from account_mail_service: siteName, heading, intro, action { label, url }?, note?.
  Mail clients ignore stylesheets and CSS variables, so the colours are inline and fixed here
  (a neutral light card that reads well in every client).
--}}
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ heading }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;color:#1f1f24;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f6;padding:24px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;background:#ffffff;border:1px solid #e3e3e8;border-radius:12px;">
          <tr>
            <td style="padding:28px 28px 8px;font-size:15px;font-weight:700;color:#5b3fd6;">{{ siteName }}</td>
          </tr>
          <tr>
            <td style="padding:0 28px;">
              <h1 style="margin:8px 0 12px;font-size:22px;line-height:1.3;color:#141418;">{{ heading }}</h1>
              <p style="margin:0 0 20px;font-size:15px;line-height:1.6;">{{ intro }}</p>
            </td>
          </tr>
          @if(action)
          <tr>
            <td style="padding:0 28px 20px;">
              <a href="{{ action.url }}" style="display:inline-block;background:#5b3fd6;color:#ffffff;text-decoration:none;font-weight:700;font-size:15px;padding:12px 22px;border-radius:8px;">{{ action.label }}</a>
              <p style="margin:16px 0 0;font-size:13px;line-height:1.5;color:#5c5c66;">Düğme çalışmazsa bu adresi tarayıcına yapıştır:<br><a href="{{ action.url }}" style="color:#5b3fd6;word-break:break-all;">{{ action.url }}</a></p>
            </td>
          </tr>
          @end
          @if(note)
          <tr>
            <td style="padding:0 28px 28px;">
              <p style="margin:0;padding-top:16px;border-top:1px solid #ececf0;font-size:13px;line-height:1.5;color:#5c5c66;">{{ note }}</p>
            </td>
          </tr>
          @end
        </table>
        <p style="margin:16px 0 0;font-size:12px;color:#62626c;">Bu e-posta {{ siteName }} hesabınla ilgili olduğu için gönderildi.</p>
      </td>
    </tr>
  </table>
</body>
</html>
