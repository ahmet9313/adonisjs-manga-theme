{{--
  Series header over the banner art: cover, title, other names, metadata, genres, description and
  the main actions (start/continue reading or watching, save, share).
  Hooks: continueReading (data-config with the account's last chapter), bookmarkButton
  (partials/series/bookmark_control), textClamp (chapter_list.js) and the share menu (partials/share).
--}}
@let(firstChapter = chapters.length ? chapters[chapters.length - 1] : null)
@let(resume = reading && reading.last !== null && chapters.some((chapter) => chapter.number === reading.last) ? reading.last : null)
<section class="series-hero" aria-labelledby="series-title">
  <div class="series-hero__grid">
    @if(series.coverVeil === 'blur')
    {{-- Blurred cover (cover_policy_service): "Göster" uncovers it on this page only. --}}
    <div class="series-hero__cover" x-data="{ shown: false }">
      <img src="{{ thumbOf(series.coverImage, 640) }}" srcset="{{ srcsetOf(series.coverImage, [320, 640]) || null }}" sizes="(min-width: 1024px) 240px, 150px" alt="{{ series.title }} kapak görseli" width="460" height="644" decoding="async" fetchpriority="high" data-fallback="/images/no-cover.svg" data-veil="blur" :data-veil="shown ? null : 'blur'">
      <div class="cover-veil cover-veil--action" x-show="!shown">
        @!component('components/icon', { name: 'eye-off', stroke: 1.8, class: 'cover-veil__icon' })
        <button type="button" class="btn btn--sm btn--secondary" @click="shown = true">Kapağı göster</button>
      </div>
    </div>
    @else
    <div class="series-hero__cover">
      <img src="{{ thumbOf(series.coverImage, 640) }}" srcset="{{ srcsetOf(series.coverImage, [320, 640]) || null }}" sizes="(min-width: 1024px) 240px, 150px" alt="{{ series.title }} kapak görseli" width="460" height="644" decoding="async" fetchpriority="high" data-fallback="/images/no-cover.svg">
    </div>
    @end

    <div class="series-hero__titles">
      <h1 id="series-title" class="series-hero__title">{{ series.title }}</h1>
      @if(series.alternativeTitles && series.alternativeTitles.length)
      <p class="series-hero__alt" title="{{ series.alternativeTitles.join(' · ') }}"><span class="sr-only">Diğer adları: </span>{{ series.alternativeTitles.join(' · ') }}</p>
      @end
    </div>

    <div class="series-hero__body">
      <ul class="series-meta" aria-label="Seri özeti">
        <li>
          <a href="/seriler?type={{ encodeURIComponent(series.type) }}" class="badge badge--lg" data-tone="{{ badgeTone('type', series.type) }}" title="Tüm {{ typeLabel }} serileri">{{ typeLabel }}</a>
        </li>
        @if(series.status)
        <li>
          @!component('components/ui/badge', { kind: 'status', value: series.status, size: 'lg' })
        </li>
        @end
        @if(series.ageRating)
        <li>
          @!component('components/ui/badge', { kind: 'age', value: series.ageRating, size: 'lg', title: series.ageRating.replace('+', '') + (isVideo ? ' yaş ve üzeri izleyiciler için' : ' yaş ve üzeri okurlar için') })
        </li>
        @end
        @if(series.access !== 'public')
        <li>
          <span class="badge badge--lg lock-badge" data-tone="{{ series.access === 'vip' ? 'accent' : 'neutral' }}" title="Bölümler {{ series.access === 'vip' ? 'yalnız VIP üyelere' : 'yalnız üyelere' }} açık">
            @!component('components/icon', { name: series.access === 'vip' ? 'star' : 'lock', stroke: 2 })
            {{ site.accessLevels[series.access].label }}
          </span>
        </li>
        @end
        @if(series.publicationYear)
        <li class="series-meta__item">
          @!component('components/icon', { name: 'calendar', class: 'h-4 w-4' })
          <span><span class="sr-only">Yayın yılı: </span>{{ series.publicationYear }}</span>
        </li>
        @end
        @if(ui('series_reviews'))
        <li>
          <a href="#incelemeler" class="series-rating">
            @if(series.ratingCount)
            <span class="series-rating__star" aria-hidden="true">★</span>
            <span class="series-rating__value t-num">{{ series.ratingAverage.toFixed(1) }}</span>
            <span class="series-rating__count">({{ series.ratingCount }} puan · {{ series.reviewCount }} inceleme)</span>
            @else
            <span class="series-rating__star" aria-hidden="true">☆</span>
            <span class="series-rating__count">Henüz puan yok · ilk puanı sen ver</span>
            @end
          </a>
        </li>
        @end
      </ul>

      @if(series.genres.length)
      <ul class="series-genres" aria-label="Türler">
        @each(genre in series.genres)
        <li>
          <a href="/seriler?genre={{ encodeURIComponent(genre) }}" class="link-chip" title="{{ genre }} türündeki seriler">{{ genre }}</a>
        </li>
        @end
      </ul>
      @end

      @if(ui('series_description') && series.description)
      <div class="series-desc" x-data="textClamp">
        <p x-ref="text" class="series-desc__text is-clamped" :class="{ 'is-clamped': !open }">{{ series.description }}</p>
        <button type="button" x-cloak x-show="long" @click="open = !open" aria-expanded="false" :aria-expanded="open.toString()" class="btn btn--link btn--sm series-desc__more">
          <span x-text="open ? 'Daha az göster' : 'Devamını oku'">Devamını oku</span>
        </button>
      </div>
      @end

      <div class="series-actions">
        @if(firstChapter)
        <div x-data="continueReading" data-config="{{ JSON.stringify({ type: series.type, slug: series.slug, last: reading ? reading.last : null, chapters: chapters.map(c => c.number) }) }}" class="contents">
          <a href="{{ seriesUrl }}/{{ resume !== null ? resume : firstChapter.number }}" data-start="{{ seriesUrl }}/{{ firstChapter.number }}" :href="last !== null ? href : $el.dataset.start" class="btn btn--primary btn--lg">
            @!component('components/icon', { name: 'play', class: 'btn__icon' })
            <span x-show="last === null"
              @if(resume !== null)
              style="display: none"
              @end
              >{{ isVideo ? 'İzlemeye Başla' : 'Okumaya Başla' }} — Bölüm {{ firstChapter.number }}</span>
            <span x-show="last !== null" data-label="{{ isVideo ? 'İzlemeye Devam Et — Bölüm ' : 'Okumaya Devam Et — Bölüm ' }}" x-text="$el.dataset.label + last"
              @if(resume === null)
              style="display: none"
              @end
              >{{ isVideo ? 'İzlemeye Devam Et' : 'Okumaya Devam Et' }} — Bölüm {{ resume }}</span>
          </a>
        </div>
        @else
        <button type="button" class="btn btn--primary btn--lg" disabled>Henüz bölüm yok</button>
        @end

        @include('partials/series/bookmark_control')

        @if(ui('share_buttons'))
        @!component('partials/share/menu', { url: siteUrl(request, seriesUrl), title: series.title, id: 'series-share' })
        @end
      </div>
    </div>
  </div>
</section>
