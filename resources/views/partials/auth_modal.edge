{{-- Sign-in / registration dialog for guests. Open with $dispatch('open-auth', 'login' | 'register'). --}}
<div x-data="{ open: false, view: 'login' }" @open-auth.window="view = $event.detail === 'register' ? 'register' : 'login'; open = true">
  @component('components/ui/modal', { id: 'auth', title: 'Giriş yap', titleExpr: "view === 'login' ? 'Giriş yap' : 'Kayıt ol'", size: 'sm' })
    <div x-show="view === 'login'">
      <p class="mb-5 text-sm text-(--t-muted)">{{ site.name }} hesabınla okumaya kaldığın yerden devam et.</p>
      @!component('components/auth/login_form', { prefix: 'modal', next: request.url(true) })
      <p class="mt-5 text-center text-sm text-(--t-muted)">
        Hesabın yok mu?
        <button type="button" class="btn btn--link" @click="view = 'register'; $nextTick(() => document.getElementById('modal-username')?.focus())">Kayıt ol</button>
      </p>
    </div>
    <div x-cloak x-show="view === 'register'">
      <p class="mb-5 text-sm text-(--t-muted)">Ücretsiz hesap: kaydedilenler, okuma geçmişi, yorumlar ve ödüller.</p>
      @!component('components/auth/register_form', { prefix: 'modal', next: request.url(true) })
      <p class="mt-5 text-center text-sm text-(--t-muted)">
        Zaten hesabın var mı?
        <button type="button" class="btn btn--link" @click="view = 'login'; $nextTick(() => document.getElementById('modal-login')?.focus())">Giriş yap</button>
      </p>
    </div>
  @end
</div>
