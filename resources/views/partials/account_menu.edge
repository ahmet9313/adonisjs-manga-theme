{{--
  Account menu (signed in) or the sign-in buttons (guests). A disclosure: the `dropdown`
  component handles open/close and keys, `accountMenu` the level progress and the daily check-in.
--}}
@if(auth && auth.user)
  @let(me = auth.user)
  @let(summary = account || null)
  @let(look = summary ? summary.look : lookOf(me))
  @let(level = summary ? summary.level : levelOf(me).level)
  <div x-data="accountMenu"
       data-config="{{ JSON.stringify({ checkedIn: summary ? summary.checkedIn : true, streak: summary ? summary.streak : 0, nextCheckin: summary ? summary.nextCheckin : 0, level: level, current: summary ? summary.current : 0, needed: summary ? summary.needed : 0, progress: summary ? summary.progress : 0, exp: summary ? summary.exp : me.exp }) }}">
    <div class="relative" x-data="dropdown" @keydown="onKeydown($event)" @click.outside="close()">
      <button type="button" x-ref="button" @click="toggle()" aria-expanded="false" :aria-expanded="open.toString()" aria-controls="account-menu"
              aria-label="Hesap menüsü: {{ me.fullName }}" class="relative ml-0.5 flex h-10 w-10 items-center justify-center rounded-full">
        @!component('components/avatar', { user: me, size: 'h-9 w-9', text: 'text-sm', frame: look.frame })
        <span x-cloak x-show="!checkedIn" class="absolute -right-0.5 -top-0.5 h-3 w-3 rounded-full bg-(--t-accent) ring-2 ring-(--t-header-bg)" title="Günlük giriş ödülü hazır"></span>
      </button>

      <div id="account-menu" x-ref="panel" x-cloak x-show="open" x-transition.origin.top.right.duration.120ms
           class="menu absolute right-0 top-full mt-2 max-h-[calc(100dvh-5.5rem)] w-[min(22rem,calc(100vw-1.5rem))] overflow-y-auto overscroll-contain p-0">
        <div class="relative isolate overflow-hidden px-4 pb-4 pt-4">
          @if(look.wallpaper)
          <div class="wall absolute inset-0 -z-20 {{ look.wallpaper.cls || '' }}" style="{{ visualStyle(look.wallpaper) }}"></div>
          <div class="wall-veil absolute inset-0 -z-10"></div>
          @end
          <div class="flex items-center gap-3">
            <a href="/uye/{{ me.username }}" class="shrink-0 rounded-full" tabindex="-1" aria-hidden="true">
              @!component('components/avatar', { user: me, size: 'h-12 w-12', text: 'text-lg', frame: look.frame })
            </a>
            <div class="min-w-0 flex-1">
              <div class="flex min-w-0 items-center gap-1.5">
                <a href="/uye/{{ me.username }}" class="truncate text-[0.9375rem] font-bold text-(--t-heading) hover:underline">
                  @!component('components/user_name', { user: me, look })
                </a>
                <span class="lv-badge" data-tier="{{ level >= 50 ? 4 : level >= 25 ? 3 : level >= 10 ? 2 : 1 }}" :data-tier="tier()" x-text="'Lv.' + level">Lv.{{ level }}</span>
              </div>
              <p class="truncate text-xs text-(--t-muted)">&#64;{{ me.username }}</p>
            </div>
          </div>

          <div class="mt-3">
            <div class="progress progress--sm" role="progressbar" aria-label="Sonraki seviyeye ilerleme" aria-valuemin="0" aria-valuemax="100"
                 aria-valuenow="{{ summary ? summary.progress : 0 }}" :aria-valuenow="progress">
              <div class="progress__bar" style="width: {{ summary ? summary.progress : 0 }}%" :style="'width:' + progress + '%'"></div>
            </div>
            <div class="mt-1.5 flex justify-between text-[11px] text-(--t-muted)">
              <span class="t-num" x-text="current + ' / ' + needed + ' EXP'"></span>
              <span class="t-num" x-text="'Lv.' + (level + 1) + ' için ' + Math.max(0, needed - current)"></span>
            </div>
          </div>

          <div class="mt-3 flex items-center gap-3 rounded-(--radius-control) border border-(--t-border) bg-(--t-surface-2) px-3 py-2">
            <span class="inline-flex items-center gap-1 text-sm font-bold" :class="streak ? 'text-(--t-warning)' : 'text-(--t-muted)'" title="Üst üste günlük giriş">
              @!component('components/icon', { name: 'fire', class: 'h-4 w-4' })
              <span x-text="streak">{{ summary ? summary.streak : 0 }}</span>
            </span>
            <span class="min-w-0 flex-1 truncate text-xs text-(--t-muted)" x-text="checkedIn ? 'Yarın tekrar gel' : '+' + nextCheckin + ' EXP hazır'"></span>
            <button type="button" @click="checkin()" :disabled="checkedIn || busy" class="btn btn--sm" :class="checkedIn ? 'btn--secondary' : 'btn--primary'">
              @!component('components/icon', { name: 'gift', class: 'btn__icon' })
              <span x-text="checkedIn ? 'Alındı' : 'Günlük Giriş'">Günlük Giriş</span>
            </button>
          </div>
        </div>

        <div class="border-t border-(--t-border) p-1.5">
          <a href="/uye/{{ me.username }}" class="menu__item">
            @!component('components/icon', { name: 'user' })
            Profilim
          </a>
          <button type="button" class="menu__item" @click="close(); $dispatch('open-inbox')">
            @!component('components/icon', { name: 'inbox' })
            <span class="flex-1">Gelen Kutusu</span>
            <span x-cloak x-show="$store.account.unread" class="count" x-text="$store.account.unread > 99 ? '99+' : $store.account.unread"></span>
          </button>
          <a href="/kaydedilenler" class="menu__item">
            @!component('components/icon', { name: 'bookmark' })
            Kaydedilenler
          </a>
          <a href="/gecmis" class="menu__item">
            @!component('components/icon', { name: 'clock' })
            Okuma Geçmişi
          </a>
          <div class="menu__sep" role="separator"></div>
          <p class="menu__label">Topluluk</p>
          <a href="/oduller" class="menu__item">
            @!component('components/icon', { name: 'gift' })
            Seviye ve Ödüller
          </a>
          <a href="/rozetler" class="menu__item">
            @!component('components/icon', { name: 'trophy' })
            Rozetler
          </a>
          <a href="/kartlar" class="menu__item">
            @!component('components/icon', { name: 'cards' })
            Kartlar
          </a>
          <a href="/kozmetik/cerceveler" class="menu__item">
            @!component('components/icon', { name: 'sparkles' })
            Kozmetikler
          </a>
          <button type="button" class="menu__item" @click="close(); $dispatch('open-inventory')">
            @!component('components/icon', { name: 'archive' })
            Envanter
          </button>
          <div class="menu__sep" role="separator"></div>
          <a href="/ayarlar" class="menu__item">
            @!component('components/icon', { name: 'cog' })
            Ayarlar
          </a>
          @if(me.isStaff)
          <a href="/admin" class="menu__item">
            @!component('components/icon', { name: 'shield' })
            Yönetim Paneli
          </a>
          @end
          <div class="menu__sep" role="separator"></div>
          <form action="/cikis" method="POST">
            {{ csrfField() }}
            <button type="submit" class="menu__item menu__item--danger">
              @!component('components/icon', { name: 'logout' })
              Çıkış Yap
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
@else
  <div class="flex items-center gap-2">
    <button type="button" @click="$dispatch('open-auth', 'login')" class="btn btn--ghost btn--md hidden sm:inline-flex">Giriş yap</button>
    <button type="button" @click="$dispatch('open-auth', 'register')" class="btn btn--primary btn--md hidden sm:inline-flex">Kayıt ol</button>
  </div>
@end
