{{-- Horizontal series card used by recommendations. Needs `item` and `label`. --}}
@let(url = '/series/' + item.type + '/' + item.slug)
@let(ribbon = item.status === 'Tamamlandı' ? ['TAMAM', 'bg-sky-600'] : item.status === 'Bırakıldı' ? ['BIRAKILDI', 'bg-gray-600'] : ['DEVAM', 'bg-emerald-600'])
<article class="group flex gap-3 rounded-2xl p-2 transition hover:bg-white/[0.04]">
  <a href="{{ url }}" class="relative block w-24 shrink-0 overflow-hidden rounded-xl sm:w-28" aria-label="{{ item.title }}">
    <img src="{{ item.coverImage }}" alt="" loading="lazy" class="aspect-[3/4] w-full object-cover transition duration-300 group-hover:scale-105" onerror="this.onerror=null;this.src='/images/no-cover.svg'">
    <span class="absolute -left-6 top-2.5 w-24 -rotate-45 py-0.5 text-center text-[9px] font-extrabold tracking-wider text-(--t-heading) shadow {{ ribbon[1] }}">{{ ribbon[0] }}</span>
    <span class="absolute right-1 top-1 inline-flex items-center gap-1 rounded-md bg-black/70 px-1.5 py-0.5 text-[11px] font-semibold text-(--t-heading)" title="Okuyan kişi">
      @!component('components/icon', { name: 'eye', class: 'h-3.5 w-3.5' })
      {{ item.readers.toLocaleString('tr-TR') }}
    </span>
  </a>
  <div class="min-w-0 flex-1 py-1">
    <p class="truncate text-xs text-gray-400">
      @if(item.genres.length)
        <a href="/seriler?genre={{ encodeURIComponent(item.genres[0]) }}" class="font-semibold text-gray-200 hover:text-emerald-300">{{ item.genres[0] }}</a>
        <span aria-hidden="true"> · </span>
      @end
      {{ label }}
    </p>
    <h3 class="mt-1 line-clamp-1 font-bold text-(--t-heading)"><a href="{{ url }}" class="hover:text-emerald-300">{{ item.title }}</a></h3>
    <p class="mt-1 line-clamp-2 text-sm text-gray-400">{{ item.description }}</p>
    <div class="mt-2 flex items-center gap-4 text-sm text-gray-300">
      <span class="inline-flex items-center gap-1" title="Kaydeden kişi">
        @!component('components/icon', { name: 'bookmark', class: 'h-4 w-4 text-amber-300' })
        {{ item.savers }}
      </span>
      <span class="inline-flex items-center gap-1">
        @!component('components/icon', { name: 'library', class: 'h-4 w-4 text-gray-400' })
        {{ item.chapterCount }} Bölüm
      </span>
    </div>
  </div>
</article>
