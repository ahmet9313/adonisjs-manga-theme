{{-- "Envanter" dialog with earned cosmetics. Opened with $dispatch('open-inventory', kind?). --}}
<div x-data="inventory" @open-inventory.window="show($event.detail)">
  @component('components/ui/modal', { id: 'inventory', title: 'Envanter', size: 'lg' })
    <div role="tablist" aria-label="Kozmetik türü" class="tabs" x-data="{ keys() { return tabs.map((tab) => tab.key) } }"
         @keydown.right.prevent="kind = keys()[(keys().indexOf(kind) + 1) % keys().length]; $nextTick(() => $el.querySelector('[aria-selected=true]')?.focus())"
         @keydown.left.prevent="kind = keys()[(keys().indexOf(kind) + keys().length - 1) % keys().length]; $nextTick(() => $el.querySelector('[aria-selected=true]')?.focus())">
      <template x-for="tab in tabs" :key="tab.key">
        <button type="button" role="tab" class="tab" :id="'inventory-tab-' + tab.key" aria-controls="inventory-panel"
                @click="kind = tab.key" :aria-selected="(kind === tab.key).toString()" :tabindex="kind === tab.key ? 0 : -1">
          <span x-text="tab.label"></span>
          <span class="chip__count" x-text="(data[tab.key] || []).length"></span>
        </button>
      </template>
    </div>

    <div id="inventory-panel" role="tabpanel" :aria-labelledby="'inventory-tab-' + kind" tabindex="0" class="pt-4 outline-none">
      <p x-show="error" x-cloak x-text="error" role="alert" class="field__error"></p>
      <div x-show="loading" role="status">
        <span class="sr-only">Yükleniyor…</span>
        @!component('components/ui/skeleton', { variant: 'row', count: 2 })
      </div>
      <div x-show="!loading && !(data[kind] || []).length" x-cloak class="empty">
        <span class="empty__icon">
          @!component('components/icon', { name: 'archive' })
        </span>
        <p class="empty__text" x-text="emptyText()"></p>
        <div class="empty__actions">
          <a :href="storeLink()" class="btn btn--secondary btn--md">Koleksiyona göz at</a>
        </div>
      </div>

      <div x-show="!loading && (data[kind] || []).length" class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
        <template x-for="item in data[kind] || []" :key="item.id">
          <div class="card flex flex-col items-center gap-2 p-3 text-center transition-colors"
               :class="item.equipped ? 'border-(--t-accent-line) bg-(--t-accent-soft)' : ''">
            <span class="relative flex h-20 w-full items-center justify-center overflow-hidden rounded-(--radius-control) bg-(--t-surface-2)">
              <template x-if="kind === 'sticker'">
                <img :src="item.visual.img" :alt="item.name" class="max-h-16 max-w-[80%] object-contain" loading="lazy">
              </template>
              <template x-if="kind === 'frame'">
                <span class="relative inline-flex h-12 w-12">
                  <span class="h-full w-full rounded-full bg-(--t-border-strong)"></span>
                  <template x-if="item.visual.img"><img :src="item.visual.img" alt="" class="avatar-frame-img"></template>
                  <template x-if="!item.visual.img"><span class="avatar-frame" :class="item.visual.cls"></span></template>
                </span>
              </template>
              <template x-if="kind === 'effect'">
                <span class="truncate px-2 text-lg font-extrabold" :class="item.visual.cls" :style="item.visual.css || ''" x-text="name || 'Aa'"></span>
              </template>
              <template x-if="kind === 'wallpaper'">
                <span class="wall absolute inset-0" :class="item.visual.cls" :style="item.visual.img ? `background-image:url('${item.visual.img}')` : ''"></span>
              </template>
            </span>
            <span class="w-full truncate text-sm font-semibold text-(--t-heading)" x-text="item.name"></span>
            <template x-if="kind !== 'sticker'">
              <button type="button" @click="toggle(item)" :disabled="busy" class="btn btn--sm btn--block" :class="item.equipped ? 'btn--primary' : 'btn--secondary'"
                      :aria-pressed="item.equipped.toString()" x-text="item.equipped ? 'Kuşanıldı' : 'Kuşan'"></button>
            </template>
          </div>
        </template>
      </div>
    </div>
    @slot('footer')
      <a :href="storeLink()" class="btn btn--ghost btn--md">
        @!component('components/icon', { name: 'sparkles', class: 'btn__icon' })
        Tüm koleksiyon
      </a>
    @end
  @end
</div>
