{{-- "Envanter" dialog with earned cosmetics. Opened with $dispatch('open-inventory', kind?). --}}
<div x-data="inventory" @open-inventory.window="show($event.detail)" @keydown.escape.window="open = false">
  <div x-cloak x-show="open" x-transition.opacity class="fixed inset-0 z-[85] flex items-start justify-center overflow-y-auto bg-black/70 p-3 backdrop-blur-sm sm:items-center sm:p-6" @click.self="open = false">
    <div role="dialog" aria-modal="true" aria-labelledby="inventory-title" class="glass-strong relative my-6 w-full max-w-3xl rounded-3xl border border-white/10 shadow-2xl">
      <button type="button" @click="open = false" class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full text-gray-400 hover:bg-white/10 hover:text-(--t-heading)" aria-label="Kapat">
        @!component('components/icon', { name: 'x', class: 'h-5 w-5' })
      </button>
      <div class="p-5 sm:p-7">
        <h2 id="inventory-title" class="mb-4 text-2xl font-bold text-(--t-heading) sm:text-3xl">Envanter</h2>
        <div class="flex gap-1 overflow-x-auto border-b border-white/10" role="tablist">
          <template x-for="tab in tabs" :key="tab.key">
            <button type="button" role="tab" @click="kind = tab.key" :aria-selected="(kind === tab.key).toString()"
                    class="-mb-px whitespace-nowrap border-b-2 px-3 py-2.5 text-xs font-bold uppercase tracking-wide transition"
                    :class="kind === tab.key ? 'border-white text-(--t-heading)' : 'border-transparent text-gray-400 hover:text-gray-200'">
              <span x-text="tab.label"></span>
              <span class="ml-1 text-gray-500" x-text="(data[tab.key] || []).length"></span>
            </button>
          </template>
        </div>

        <p x-show="error" x-cloak x-text="error" role="alert" class="mt-3 text-sm text-red-400"></p>
        <p x-show="loading" class="py-8 text-center text-sm text-gray-400" role="status">Yükleniyor…</p>
        <p x-show="!loading && !(data[kind] || []).length" x-cloak class="py-8 text-gray-400" x-text="emptyText()"></p>

        <div x-show="!loading" class="mt-4 grid max-h-[55vh] grid-cols-2 gap-3 overflow-y-auto pr-1 sm:grid-cols-3 md:grid-cols-4">
          <template x-for="item in data[kind] || []" :key="item.id">
            <div class="flex flex-col items-center gap-2 rounded-2xl border p-3 text-center transition"
                 :class="item.equipped ? 'border-emerald-500/70 bg-emerald-500/10' : 'border-white/10 bg-white/[0.04]'">
              <div class="flex h-20 w-full items-center justify-center">
                <template x-if="kind === 'sticker'">
                  <img :src="item.visual.img" :alt="item.name" class="max-h-20 max-w-full object-contain" loading="lazy">
                </template>
                <template x-if="kind === 'frame'">
                  <span class="relative inline-flex h-14 w-14">
                    <span class="h-full w-full overflow-hidden rounded-full bg-gradient-to-br from-slate-500 to-slate-700"></span>
                    <template x-if="item.visual.img"><img :src="item.visual.img" alt="" class="avatar-frame-img"></template>
                    <template x-if="!item.visual.img"><span class="avatar-frame" :class="item.visual.cls"></span></template>
                  </span>
                </template>
                <template x-if="kind === 'effect'">
                  <span class="truncate text-lg font-bold" :class="item.visual.cls" :style="item.visual.css || ''" x-text="name"></span>
                </template>
                <template x-if="kind === 'wallpaper'">
                  <span class="wall h-full w-full rounded-xl" :class="item.visual.cls" :style="item.visual.img ? `background-image:url('${item.visual.img}')` : ''"></span>
                </template>
              </div>
              <span class="w-full truncate text-sm font-semibold text-(--t-heading)" x-text="item.name"></span>
              <template x-if="kind !== 'sticker'">
                <button type="button" @click="toggle(item)" :disabled="busy" class="btn-soft w-full !py-1.5" :class="item.equipped ? 'btn-green' : ''" x-text="item.equipped ? 'Kuşanıldı' : 'Kuşan'"></button>
              </template>
            </div>
          </template>
        </div>
      </div>
      <a :href="storeLink()" class="flex items-center justify-center gap-2 rounded-b-3xl border-t border-white/10 bg-black/20 px-5 py-4 text-sm font-semibold text-(--t-heading) hover:bg-white/5">
        @!component('components/icon', { name: 'smile', class: 'h-5 w-5' })
        Koleksiyona git
      </a>
    </div>
  </div>
</div>
