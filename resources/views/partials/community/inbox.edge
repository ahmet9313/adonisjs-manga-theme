{{-- "Gelen Kutusu" drawer. Opened with $dispatch('open-inbox'). --}}
<div x-data="inbox" @open-inbox.window="show()">
  @component('components/ui/modal', { id: 'inbox', title: 'Gelen Kutusu', size: 'drawer', close: 'close()' })
    @slot('head')
      <p class="modal__desc" x-text="unread ? unread + ' okunmamış bildirim' : 'Hepsi okundu'"></p>
    @end
    <div class="flex flex-wrap gap-1.5" role="group" aria-label="Bildirim türü">
      <template x-for="tab in tabs" :key="tab.key">
        <button type="button" class="chip" @click="setFilter(tab.key)" :aria-pressed="(filter === tab.key).toString()">
          <span x-text="tab.label"></span>
          <span x-show="tab.key === 'unread' && unread" class="chip__count" x-text="unread"></span>
        </button>
      </template>
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-end gap-2">
      <button type="button" @click="readAll()" :disabled="!unread || busy" class="btn btn--ghost btn--sm">
        @!component('components/icon', { name: 'check', class: 'btn__icon' })
        Tümünü okundu say
      </button>
      <button type="button" @click="removeAll()" :disabled="!items.length || busy" class="btn btn--sm" :class="confirmClear ? 'btn--danger-solid' : 'btn--ghost'">
        @!component('components/icon', { name: 'trash', class: 'btn__icon' })
        <span x-text="confirmClear ? 'Emin misin? Tekrar bas' : 'Tümünü sil'">Tümünü sil</span>
      </button>
    </div>

    <p x-show="error" x-cloak x-text="error" role="alert" class="field__error mt-3"></p>

    <ul class="mt-3 space-y-2" aria-live="polite">
      <template x-for="item in items" :key="item.id">
        <li class="card relative flex gap-3 p-3 transition-colors" :class="item.read ? '' : 'border-(--t-accent-line) bg-(--t-accent-soft)'">
          <span class="tone-icon" :data-tone="tone(item.category)" aria-hidden="true">
            <span x-text="emoji(item.category)"></span>
          </span>
          <div class="min-w-0 flex-1 pr-8">
            <div class="flex items-start gap-2">
              <span x-show="!item.read" class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-(--t-accent)"></span>
              <a :href="item.link || '#'" @click="follow(item, $event)" class="min-w-0 flex-1 text-sm font-bold text-(--t-heading) hover:underline" x-text="item.title"></a>
            </div>
            <p class="mt-0.5 break-words text-sm text-(--t-text-2)" x-text="item.body"></p>
            <p class="mt-1 text-xs text-(--t-muted)">
              <time :datetime="item.createdAt" x-text="ago(item.createdAt)"></time>
              <span x-show="!item.read" class="sr-only">, okunmamış</span>
            </p>
          </div>
          <div class="absolute right-2 top-2" x-data="dropdown" @keydown="onKeydown($event)" @click.outside="close()">
            <button type="button" x-ref="button" @click="toggle()" class="btn btn--ghost btn--sm btn--icon" aria-label="Bildirim seçenekleri" aria-expanded="false" :aria-expanded="open.toString()">
              @!component('components/icon', { name: 'dots', class: 'btn__icon' })
            </button>
            <div x-ref="panel" x-cloak x-show="open" x-transition.origin.top.right.duration.120ms class="menu absolute right-0 top-full z-10 mt-1 w-52">
              <button type="button" class="menu__item" @click="close(); toggleRead(item)">
                @!component('components/icon', { name: 'check' })
                <span x-text="item.read ? 'Okunmadı say' : 'Okundu say'"></span>
              </button>
              <button type="button" class="menu__item menu__item--danger" @click="close(); remove(item)">
                @!component('components/icon', { name: 'trash' })
                Sil
              </button>
            </div>
          </div>
        </li>
      </template>
    </ul>
    <div x-show="loading" class="mt-3" role="status">
      <span class="sr-only">Yükleniyor…</span>
      @!component('components/ui/skeleton', { variant: 'row', count: 3 })
    </div>
    <div x-show="!loading && !items.length" x-cloak class="mt-4">
      @!component('components/ui/empty_state', { icon: 'inbox', title: 'Burada henüz bir şey yok', description: 'Yanıtlar, ödüller ve kaydettiğin serilerin yeni bölümleri burada görünür.' })
    </div>
    <div class="mt-4 flex justify-center" x-show="hasMore && !loading" x-cloak>
      <button type="button" @click="load()" class="btn btn--secondary btn--md">Daha fazla göster</button>
    </div>
  @end
</div>
