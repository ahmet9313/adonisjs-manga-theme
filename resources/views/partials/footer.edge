{{--
  Site footer. Works without JavaScript (also used by the error layout); the scheme switch
  stays hidden (x-cloak) until Alpine runs. The only <footer> element of the site.
--}}
@if(ui('footer'))
<footer class="site-footer mt-auto border-t border-(--t-border)">
  <div class="mx-auto grid max-w-(--t-container) gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.5fr_repeat(3,1fr)] lg:px-8">
    <div class="max-w-sm">
      <a href="/" class="logo">
        @if(site.logo)
        <img src="{{ site.logo }}" alt="" class="logo__img">
        @else
        <span class="logo__mark" aria-hidden="true">{{ site.name.charAt(0).toUpperCase() }}</span>
        @end
        <span class="logo__text">{{ site.name }}</span>
        <span class="sr-only">ana sayfa</span>
      </a>
      @if(ui('footer_description'))
      <p class="mt-3 text-sm leading-relaxed text-(--t-footer-link)">{{ site.description }}</p>
      @end
      @if(ui('footer_social') && site.socialLinks.length)
      <nav aria-label="Sosyal medya" class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
        @each(link in site.socialLinks)
        <a href="{{ link.url }}" class="footer-link" rel="noopener noreferrer">{{ link.label }}</a>
        @end
      </nav>
      @end
    </div>
    <nav aria-labelledby="footer-explore">
      <p id="footer-explore" class="footer-title">Keşfet</p>
      <ul class="space-y-2">
        <li><a href="/seriler" class="footer-link">Seriler</a></li>
        <li><a href="/takvim" class="footer-link">Yayın Takvimi</a></li>
        <li><a href="/seriler?order=rating" class="footer-link">En yüksek puanlılar</a></li>
        <li><a href="/oneriler" class="footer-link">Öneriler</a></li>
        <li><a href="/kaydedilenler" class="footer-link">Kaydedilenler</a></li>
      </ul>
    </nav>
    <nav aria-labelledby="footer-community">
      <p id="footer-community" class="footer-title">Topluluk</p>
      <ul class="space-y-2">
        <li><a href="/oduller" class="footer-link">Seviye ve ödüller</a></li>
        <li><a href="/rozetler" class="footer-link">Rozetler</a></li>
        <li><a href="/kartlar" class="footer-link">Kartlar</a></li>
        <li><a href="/kozmetik/cerceveler" class="footer-link">Kozmetikler</a></li>
      </ul>
    </nav>
    <nav aria-labelledby="footer-account">
      <p id="footer-account" class="footer-title">Hesap</p>
      <ul class="space-y-2">
        @if(auth && auth.user)
        <li><a href="/uye/{{ auth.user.username }}" class="footer-link">Profilim</a></li>
        <li><a href="/gecmis" class="footer-link">Okuma geçmişi</a></li>
        <li><a href="/ayarlar" class="footer-link">Ayarlar</a></li>
        @else
        <li><a href="/giris" class="footer-link">Giriş yap</a></li>
        <li><a href="/kayit" class="footer-link">Kayıt ol</a></li>
        @end
      </ul>
    </nav>
  </div>
  <div class="border-t border-(--t-border)">
    <div class="mx-auto flex max-w-(--t-container) flex-wrap items-center justify-between gap-3 px-4 py-5 text-sm text-(--t-footer-link) sm:px-6 lg:px-8">
      <span>&copy; {{ new Date().getFullYear() }} {{ site.name }}</span>
      @if(ui('scheme_switch'))
      <div x-cloak x-data>
        @!component('components/ui/theme_switch', { labels: true })
      </div>
      @end
    </div>
  </div>
</footer>
@end
