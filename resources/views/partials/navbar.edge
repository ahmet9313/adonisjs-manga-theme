{{--
  Site header. Desktop (≥ lg): logo, main links, search, scheme switch, inbox and account.
  Below lg the links, search and scheme switch move into #mobile-navigation (hamburger).
  Contracts (scripts/check-mobile-nav.mjs, tests): the desktop links sit in `nav .lg:flex`, the
  hamburger is the first [aria-controls="mobile-navigation"], the panel toggles `display` and holds
  #mobile-series-search with its results, and every element follows the Göster/Gizle switches.
--}}
@if(ui('header'))
@let(path = request.url())
@let(links = [
  { key: 'nav_home', href: '/', label: 'Ana Sayfa', icon: 'home', active: path === '/' },
  { key: 'nav_series', href: '/seriler', label: 'Seri Listesi', icon: 'grid', active: path.startsWith('/seriler') },
  { key: 'nav_recommend', href: '/oneriler', label: 'Öneriler', icon: 'bulb', active: path.startsWith('/oneriler') },
  { key: 'nav_bookmarks', href: '/kaydedilenler', label: 'Kaydedilenler', icon: 'bookmark', active: path.startsWith('/kaydedilenler') },
].filter((link) => ui(link.key)))
<header class="site-header sticky top-0 z-40 border-b border-(--t-border)"
        x-data="{ mobileOpen: false }"
        @click.outside="mobileOpen = false"
        @keydown.escape.window="mobileOpen = false"
        @resize.window="if (window.innerWidth >= 1024) mobileOpen = false">
  <div class="mx-auto flex h-16 max-w-(--t-container) items-center gap-2 px-4 sm:gap-3 sm:px-6 lg:px-8">
    <button type="button" class="btn btn--ghost btn--md btn--icon -ml-2 lg:hidden"
            @click="mobileOpen = !mobileOpen" aria-expanded="false" :aria-expanded="mobileOpen.toString()"
            aria-controls="mobile-navigation" aria-label="Menü">
      <span x-show="!mobileOpen">
        @!component('components/icon', { name: 'menu', class: 'btn__icon' })
      </span>
      <span x-cloak x-show="mobileOpen">
        @!component('components/icon', { name: 'x', class: 'btn__icon' })
      </span>
    </button>

    <a href="/" class="logo">
      {{-- Below lg the phone logo (Tema → Genel) replaces the logo; either falls back to the other. --}}
      @if(site.logo && site.logoMobile)
      <img src="{{ site.logo }}" alt="" class="logo__img max-lg:hidden">
      <img src="{{ site.logoMobile }}" alt="" class="logo__img lg:hidden">
      @elseif(site.logo || site.logoMobile)
      <img src="{{ site.logo || site.logoMobile }}" alt="" class="logo__img">
      @else
      <span class="logo__mark" aria-hidden="true">{{ site.name.charAt(0).toUpperCase() }}</span>
      @end
      @if(ui('logo_text'))
      <span class="logo__text">{{ site.name }}</span>
      @else
      <span class="sr-only">{{ site.name }}</span>
      @end
      <span class="sr-only">ana sayfa</span>
    </a>

    <nav aria-label="Ana menü" class="ml-4 min-w-0">
      <ul class="hidden items-center gap-1 lg:flex">
        @each(link in links)
        <li><a href="{{ link.href }}" class="nav-link" {{ link.active ? 'aria-current=page' : '' }}>{{ link.label }}</a></li>
        @end
        @if(site.recruitmentUrl)
        <li><a href="{{ site.recruitmentUrl }}" class="nav-link">Ekip Alım</a></li>
        @end
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1.5 sm:gap-2">
      @if(ui('search'))
      <div class="relative hidden lg:block" x-data="navSearch('desktop')" @click.outside="close()">
        <label for="desktop-series-search" class="sr-only">Seri ara</label>
        <div class="control control--icon h-10 w-56 xl:w-72">
          @!component('components/icon', { name: 'search' })
          <input id="desktop-series-search" type="search" role="combobox" aria-autocomplete="list" aria-controls="desktop-search-results"
                 aria-expanded="false" :aria-expanded="open.toString()" :aria-activedescendant="activeId()"
                 x-ref="input" x-model="query" @input.debounce.250ms="search()" @keydown="onKeydown($event)" @focus="reopen()"
                 placeholder="Seri ara…" autocomplete="off" enterkeyhint="search">
          <kbd class="kbd hidden xl:inline-flex" aria-hidden="true">/</kbd>
        </div>
        <div id="desktop-search-results" role="listbox" aria-label="Arama sonuçları" x-cloak x-show="open"
             x-transition.origin.top.duration.120ms class="menu absolute right-0 top-full mt-2 max-h-[28rem] w-[24rem] overflow-y-auto">
          @include('partials/search_results')
        </div>
      </div>
      @end

      @if(ui('nav_discover'))
      <a href="/rastgele" class="btn btn--ghost btn--md btn--icon max-lg:hidden" aria-label="Rastgele seri" title="Rastgele seri">
        @!component('components/icon', { name: 'shuffle', class: 'btn__icon' })
      </a>
      @end

      @if(ui('scheme_switch'))
      <div class="hidden lg:block">
        @!component('components/ui/theme_switch')
      </div>
      @end

      @if(ui('bell') && auth && auth.user)
      <button type="button" @click="$dispatch('open-inbox')" class="btn btn--ghost btn--md btn--icon relative"
              aria-label="Gelen kutusu" :aria-label="'Gelen kutusu' + ($store.account.unread ? ', ' + $store.account.unread + ' okunmamış' : '')">
        @!component('components/icon', { name: 'bell', class: 'btn__icon' })
        <span x-cloak x-show="$store.account.unread" class="count absolute right-0.5 top-0.5 ring-2 ring-(--t-header-bg)" x-text="$store.account.unread > 99 ? '99+' : $store.account.unread" aria-hidden="true"></span>
      </button>
      @end

      @include('partials/account_menu')
    </div>
  </div>

  <div id="mobile-navigation" x-cloak x-show="mobileOpen" x-transition.opacity.duration.150ms
       class="max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-(--t-border) bg-(--t-header-bg) lg:hidden">
    <div class="mx-auto max-w-(--t-container) space-y-4 px-4 py-4 sm:px-6">
      @if(ui('search'))
      <div x-data="navSearch('mobile')">
        <label for="mobile-series-search" class="sr-only">Seri ara</label>
        <div class="control control--icon h-11">
          @!component('components/icon', { name: 'search' })
          <input id="mobile-series-search" type="search" role="combobox" aria-autocomplete="list" aria-controls="mobile-search-results"
                 aria-expanded="false" :aria-expanded="open.toString()" :aria-activedescendant="activeId()"
                 x-ref="input" x-model="query" @input.debounce.250ms="search()" @keydown="onKeydown($event)" @focus="reopen()"
                 placeholder="Seri ara…" autocomplete="off" enterkeyhint="search" class="text-base">
        </div>
        <div id="mobile-search-results" role="listbox" aria-label="Arama sonuçları" x-cloak x-show="open" class="menu mt-2 max-h-80 overflow-y-auto">
          @include('partials/search_results')
        </div>
      </div>
      @end

      @if(links.length || site.recruitmentUrl || ui('nav_discover'))
      <nav aria-label="Mobil menü">
        <ul class="grid gap-1">
          @each(link in [...links, ...(ui('nav_discover') ? [{ href: '/seriler/a-z', label: 'A–Z Liste', icon: 'list', active: path.startsWith('/seriler/a-z') }, { href: '/rastgele', label: 'Rastgele Seri', icon: 'shuffle', active: false }] : [])])
          <li>
            <a href="{{ link.href }}" class="mobile-link" {{ link.active ? 'aria-current=page' : '' }} @click="mobileOpen = false">
              @!component('components/icon', { name: link.icon })
              {{ link.label }}
            </a>
          </li>
          @end
          @if(site.recruitmentUrl)
          <li>
            <a href="{{ site.recruitmentUrl }}" class="mobile-link">
              @!component('components/icon', { name: 'users' })
              Ekip Alım
            </a>
          </li>
          @end
        </ul>
      </nav>
      @end

      @if(!(auth && auth.user))
      <div class="grid grid-cols-2 gap-2">
        <button type="button" class="btn btn--secondary btn--md" @click="mobileOpen = false; $dispatch('open-auth', 'login')">Giriş yap</button>
        <button type="button" class="btn btn--primary btn--md" @click="mobileOpen = false; $dispatch('open-auth', 'register')">Kayıt ol</button>
      </div>
      @end

      @if(ui('scheme_switch'))
      <div class="flex items-center justify-between gap-3 border-t border-(--t-border) pt-4">
        <span class="text-sm font-semibold text-(--t-text-2)">Görünüm</span>
        @!component('components/ui/theme_switch', { labels: true })
      </div>
      @end
    </div>
  </div>
</header>
@end
