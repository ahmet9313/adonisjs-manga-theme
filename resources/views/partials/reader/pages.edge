{{--
  Chapter content. Images: the first two load eagerly with high priority, the rest lazily; each
  page keeps a placeholder height until its image has loaded (reader.js sets data-state) and
  offers a retry when it fails. In paged mode (reader.js) only the [data-current] page shows, the
  outer thirds of the page area and swipes turn pages (mirrored right to left), the middle third
  toggles immersive reading and the pager below counts them; in webtoon mode a tap on the strip
  toggles it. partials/reader/overlay: webtoon page counter and "Kaldığın yer". Novel text:
  paragraphs in a readable column (.reader-prose).
--}}
@if(pageCount)
<div class="reader-pages" @click="tap($event)" @touchstart.passive="touchStart($event)" @touchend.passive="touchEnd($event)" @touchcancel="touch = null">
  @each((page, index) in chapter.pages)
  <figure class="reader-page" data-page data-state="loading" {{ index === 0 ? 'data-current' : '' }}>
    <img src="{{ page }}" alt="{{ series.title }}, Bölüm {{ chapter.number }}, sayfa {{ index + 1 }} / {{ pageCount }}" decoding="async"
      @if(index < 2)
      loading="eager" fetchpriority="high"
      @else
      loading="lazy"
      @end
      >
    <div class="reader-page__error">
      @!component('components/icon', { name: 'photo', class: 'h-6 w-6' })
      <p>Sayfa {{ index + 1 }} yüklenemedi.</p>
      <button type="button" class="btn btn--secondary btn--sm" @click="retry($el.closest('[data-page]'))">
        @!component('components/icon', { name: 'refresh', class: 'btn__icon' })
        <span>Tekrar dene</span>
      </button>
    </div>
  </figure>
  @end
</div>
<div class="reader-pager" x-show="paged" x-cloak>
  <button type="button" class="btn btn--secondary btn--md" @click="turn(-1)" :disabled="page <= 0">
    @!component('components/icon', { name: 'chevron-left', class: 'btn__icon' })
    <span>Önceki</span>
  </button>
  <output class="reader-pager__count t-num" aria-live="polite"><span x-text="page + 1">1</span> / {{ pageCount }}</output>
  <button type="button" class="btn btn--secondary btn--md" @click="turn(1)">
    <span x-text="page + 1 < pages.length ? 'Sonraki' : prefs.auto && next ? 'Sonraki bölüm' : 'Bitir'">Sonraki</span>
    @!component('components/icon', { name: 'chevron-right', class: 'btn__icon' })
  </button>
</div>
@include('partials/reader/overlay')
@elseif(isNovel)
<article class="reader-prose" aria-label="Bölüm metni" :style="'--reader-font:' + fontSize">
  @each(paragraph in chapter.textContent.split(/\n\s*\n/).map((part) => part.trim()).filter(Boolean))
  <p>{{ paragraph }}</p>
  @end
</article>
@else
<div class="reader-empty">
  @!component('components/ui/empty_state', { icon: 'document', title: 'Bu bölümde içerik yok', description: 'Bölümün sayfaları henüz yüklenmemiş olabilir. Seri sayfasından başka bir bölüm seçebilirsin.' })
</div>
@end
