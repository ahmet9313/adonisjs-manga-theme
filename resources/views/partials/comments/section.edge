{{--
  Threaded comments of a series (chapterId null) or of a chapter. Needs `commentThread` =
  { seriesId, chapterId } in the view state. commentSection (comments.js) loads the thread and
  renders it as a flat list of rows with a depth (--d on .comment-row) because Alpine has no
  recursive templates; replies load per comment. In the reader the thread loads when it comes
  into view (data-lazy). Ids yorum-<id>, reply-<id> and comment-root are used by the script.
--}}
@let(viewer = auth && auth.user ? auth.user : null)
<section id="yorumlar" class="section" aria-labelledby="yorumlar-title"
  x-data="commentSection"
  data-config="{{ JSON.stringify({ seriesId: commentThread.seriesId, chapterId: commentThread.chapterId, me: viewer ? { username: viewer.username } : null }) }}"
  @if(commentThread.chapterId)
  data-lazy="1"
  @end
  >
  <div class="section-head">
    <div class="min-w-0">
      <h2 id="yorumlar-title" class="section-head__title">
        @!component('components/icon', { name: 'chat' })
        Yorumlar
      </h2>
      <p class="section-head__desc">
        <span x-show="ready && !loadError" x-cloak x-text="counts.roots + ' yorum · ' + counts.replies + ' yanıt'"></span>
        <span x-show="!ready">{{ commentThread.chapterId ? 'Bu bölüm hakkında ne düşünüyorsun?' : 'Seri hakkında konuşalım.' }}</span>
      </p>
    </div>
    <div class="chip-row" role="group" aria-label="Yorum sıralaması">
      <button type="button" class="chip" @click="changeSort('new')" aria-pressed="true" :aria-pressed="(sort === 'new').toString()">En yeni</button>
      <button type="button" class="chip" @click="changeSort('top')" aria-pressed="false" :aria-pressed="(sort === 'top').toString()">En beğenilen</button>
    </div>
  </div>

  {{-- New comment --}}
  @if(viewer)
  <div class="thread-compose">
    <span class="hidden shrink-0 sm:block">
      @!component('components/avatar', { user: viewer, size: 'h-10 w-10', text: 'text-sm', frame: lookOf(viewer).frame })
    </span>
    <div class="min-w-0 flex-1" x-data="{ ckey: 'root' }">
      @include('partials/comments/composer')
    </div>
  </div>
  @else
  <div class="thread-cta">
    <span class="tone-icon" data-tone="accent" aria-hidden="true">
      @!component('components/icon', { name: 'chat' })
    </span>
    <div class="min-w-0 flex-1">
      <p class="thread-cta__title">Sohbete katıl</p>
      <p class="thread-cta__text">Yorum yazmak, yanıtlamak ve oy vermek için giriş yap. Yorum yaptıkça EXP kazanırsın.</p>
    </div>
    <div class="thread-cta__actions">
      <button type="button" class="btn btn--secondary btn--sm" @click="$dispatch('open-auth', 'login')">Giriş yap</button>
      <button type="button" class="btn btn--primary btn--sm" @click="$dispatch('open-auth', 'register')">Kayıt ol</button>
    </div>
  </div>
  @end

  <div x-show="loadError" x-cloak class="alert mt-4" data-tone="danger" role="alert">
    @!component('components/icon', { name: 'exclamation' })
    <p class="min-w-0 flex-1" x-text="loadError"></p>
    <button type="button" class="btn btn--secondary btn--sm -my-1" @click="load(true)">Tekrar dene</button>
  </div>

  {{-- Thread --}}
  <div class="thread mt-5" x-show="roots.length" x-cloak>
    <template x-for="row in rows()" :key="row.key">
      <div>
        <template x-if="row.kind === 'comment'">
          <div class="comment-row" :class="row.depth > 0 && 'is-reply'" :style="indent(row.depth)"
               x-data="{ get node() { return nodes[row.id] }, get author() { return nodes[row.id] ? nodes[row.id].author : null } }">
            <article class="c-card" x-show="node" :id="'yorum-' + row.id">
              <template x-if="author && author.look && author.look.wallpaper">
                <div class="c-wall wall" :class="author.look.wallpaper.cls" :style="wallStyle(author.look.wallpaper)"></div>
              </template>
              <div class="c-veil"></div>

              <div class="thread-card">
                <div class="thread-card__head">
                  <template x-if="author">
                    <a :href="'/uye/' + author.username" class="thread-card__avatar" tabindex="-1" aria-hidden="true">
                      @include('partials/comments/avatar')
                    </a>
                  </template>
                  <template x-if="!author">
                    <span class="thread-card__avatar thread-card__avatar--empty" aria-hidden="true">
                      @!component('components/icon', { name: 'user', class: 'h-4 w-4' })
                    </span>
                  </template>

                  <div class="min-w-0 flex-1">
                    <template x-if="author">
                      @include('partials/series/author_name')
                    </template>
                    <template x-if="!author">
                      <p class="user-chip__name text-(--t-muted)">Silinmiş yorum</p>
                    </template>
                    <p class="user-chip__meta flex flex-wrap items-center gap-x-1.5">
                      <time :datetime="node && node.createdAt" :title="node && stamp(node.createdAt)" x-text="node ? ago(node.createdAt) : ''"></time>
                      <span x-show="node && node.spoiler" class="badge badge--sm" data-tone="warning">Spoiler</span>
                    </p>
                  </div>

                  <template x-if="node && (node.canDelete || canReport(node))">
                    <div class="relative -mr-1.5 -mt-1" x-data="dropdown" @keydown="onKeydown($event)" @click.outside="close()">
                      <button type="button" x-ref="button" @click="toggle()" class="btn btn--ghost btn--sm btn--icon" aria-label="Yorum seçenekleri" aria-expanded="false" :aria-expanded="open.toString()">
                        @!component('components/icon', { name: 'dots', class: 'btn__icon' })
                      </button>
                      <div x-ref="panel" x-cloak x-show="open" x-transition.origin.top.right.duration.120ms class="menu absolute right-0 top-full z-10 mt-1 w-48">
                        <template x-if="canReport(node)">
                          <button type="button" class="menu__item" @click="close(true); report(node)">
                            @!component('components/icon', { name: 'flag' })
                            Şikâyet et
                          </button>
                        </template>
                        <template x-if="node.canDelete">
                          <form @submit.prevent="close(); remove(node.id)" data-confirm="Yorum kalıcı olarak silinecek. Yanıtları varsa yerinde “Bu yorum silindi.” yazar." data-confirm-title="Yorum silinsin mi?" data-confirm-label="Sil">
                            <button type="submit" class="menu__item menu__item--danger">
                              @!component('components/icon', { name: 'trash' })
                              Yorumu sil
                            </button>
                          </form>
                        </template>
                      </div>
                    </div>
                  </template>
                </div>

                {{-- What this reply answers --}}
                <template x-if="node && node.parent && !node.deleted">
                  <button type="button" class="reply-ref" @click="jumpTo(node.parent.id)" :title="node.parent.deleted ? 'Silinmiş yoruma yanıt' : 'Yanıtlanan yoruma git'">
                    @!component('components/icon', { name: 'reply', class: 'h-3.5 w-3.5 shrink-0 text-(--t-accent)' })
                    <template x-if="!node.parent.deleted">
                      <span class="min-w-0 truncate"><strong class="font-semibold text-(--t-accent-text)" x-text="'@' + node.parent.username"></strong> kişisine yanıt: <span class="italic text-(--t-text-2)" x-text="'“' + node.parent.excerpt + '”'"></span></span>
                    </template>
                    <template x-if="node.parent.deleted">
                      <span class="italic">Silinmiş bir yoruma yanıt</span>
                    </template>
                  </button>
                </template>

                {{-- Body --}}
                <template x-if="node && node.deleted">
                  <p class="thread-card__deleted">
                    @!component('components/icon', { name: 'trash', class: 'h-4 w-4' })
                    Bu yorum silindi.
                  </p>
                </template>
                <template x-if="node && !node.deleted">
                  <div class="spoiler" :class="node.spoiler && !revealed[node.id] && 'is-hidden'">
                    <div class="spoiler__content" :inert="Boolean(node.spoiler && !revealed[node.id])">
                      <p x-show="node.body" class="thread-card__text" x-text="node.body"></p>
                      <template x-if="node.sticker">
                        <img :src="node.sticker.image" :alt="node.sticker.name + ' çıkartması'" :title="node.sticker.name" loading="lazy" decoding="async" class="thread-card__sticker">
                      </template>
                      <template x-if="node.image">
                        <button type="button" class="thread-card__image" @click="lightbox = node.image" aria-label="Görseli büyüt">
                          <img :src="node.image" alt="Yorum görseli" loading="lazy" decoding="async">
                        </button>
                      </template>
                    </div>
                    <button type="button" class="spoiler__veil" x-show="node.spoiler && !revealed[node.id]" @click="revealed[node.id] = true">
                      @!component('components/icon', { name: 'eye-off' })
                      <span>Spoiler içeriyor</span>
                      <span class="spoiler__cta">Göster</span>
                    </button>
                  </div>
                </template>

                {{-- Actions --}}
                <div class="thread-card__actions" x-show="node && (!node.deleted || node.replyCount)">
                  <button type="button" class="btn btn--ghost btn--sm" x-show="node && node.replyCount" @click="toggleReplies(node.id)" :aria-expanded="Boolean(node && node.expanded).toString()">
                    @!component('components/icon', { name: 'chat', class: 'btn__icon' })
                    <span x-text="node && node.expanded ? 'Yanıtları gizle' : (node ? node.replyCount : 0) + ' yanıt'"></span>
                  </button>
                  <button type="button" class="btn btn--ghost btn--sm" x-show="node && !node.deleted" @click="openReply(node.id)" :aria-expanded="(replyingTo === row.id).toString()">
                    @!component('components/icon', { name: 'reply', class: 'btn__icon' })
                    <span>Yanıtla</span>
                  </button>
                  <div class="vote" x-show="node && !node.deleted">
                    <button type="button" class="btn btn--ghost btn--sm vote__up" @click="vote(node.id, 1)" :aria-pressed="(node && node.vote === 1).toString()" >
                      <span class="sr-only">Artı oy</span>
                      @!component('components/icon', { name: 'up', class: 'btn__icon', stroke: 2.2 })
                      <span class="t-num" x-text="node ? node.likeCount : 0"></span>
                    </button>
                    <button type="button" class="btn btn--ghost btn--sm vote__down" @click="vote(node.id, -1)" :aria-pressed="(node && node.vote === -1).toString()" >
                      <span class="sr-only">Eksi oy</span>
                      @!component('components/icon', { name: 'down', class: 'btn__icon', stroke: 2.2 })
                      <span class="t-num" x-text="node ? node.dislikeCount : 0"></span>
                    </button>
                  </div>
                </div>
              </div>
            </article>

            {{-- Inline reply composer --}}
            <template x-if="replyingTo === row.id">
              <div class="thread-reply" x-data="{ ckey: row.id }">
                @include('partials/comments/composer')
              </div>
            </template>
          </div>
        </template>

        <template x-if="row.kind === 'more'">
          <div class="comment-row is-reply" :style="indent(row.depth)">
            <button type="button" class="btn btn--link btn--sm ml-2" @click="loadReplies(row.id)" :disabled="Boolean(nodes[row.id] && nodes[row.id].loadingReplies)" :aria-busy="Boolean(nodes[row.id] && nodes[row.id].loadingReplies).toString()">
              <span x-text="row.remaining + ' yanıtı daha göster'"></span>
            </button>
          </div>
        </template>
      </div>
    </template>
  </div>

  <div x-show="!ready || (loading && !roots.length)" class="mt-5" role="status">
    <span class="sr-only">Yorumlar yükleniyor…</span>
    @!component('components/ui/skeleton', { variant: 'comment', count: 3 })
  </div>

  <div x-show="ready && !loading && !roots.length && !loadError" x-cloak class="mt-5">
    @!component('components/ui/empty_state', { icon: 'chat', title: 'Henüz yorum yok', description: 'İlk yorumu sen yaz; düşüncelerini paylaş, sohbeti başlat.' })
  </div>

  <div class="mt-5 flex justify-center" x-show="hasMore && roots.length" x-cloak>
    <button type="button" class="btn btn--secondary btn--md" @click="load()" :disabled="loading" :aria-busy="loading.toString()">
      Daha fazla yorum
    </button>
  </div>

  {{-- Image viewer --}}
  @component('components/ui/modal', { id: 'comment-image', title: 'Yorum görseli', size: 'xl', open: 'lightbox', close: "lightbox = ''" })
    <template x-if="lightbox">
      <img :src="lightbox" alt="Yorum görseli, büyük boy" class="comment-lightbox">
    </template>
    @slot('footer')
      <a :href="lightbox || '#'" target="_blank" rel="noopener" class="btn btn--secondary btn--sm">
        @!component('components/icon', { name: 'external', class: 'btn__icon' })
        <span>Yeni sekmede aç</span>
      </a>
      <button type="button" class="btn btn--primary btn--sm" @click="lightbox = ''">Kapat</button>
    @end
  @end
</section>
