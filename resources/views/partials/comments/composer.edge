{{--
  Comment composer bound to composers[ckey] ('root' or the parent comment id).
  Images and GIFs: the "Görsel" button, dropping a file on the box or pasting (Ctrl+V).
  Ctrl/⌘ + Enter sends. Stickers come from the reader's inventory (/envanter).
  Typing @ and two letters suggests members (/uyeler/ara); ↑ ↓ choose, Enter or Tab inserts.
--}}
<form class="composer" :class="composer(ckey).dragging && 'is-dragging'"
  @submit.prevent="submit(ckey)"
  @dragover.prevent="composer(ckey).dragging = true"
  @dragleave.prevent="if (!$el.contains($event.relatedTarget)) composer(ckey).dragging = false"
  @drop.prevent="drop(ckey, $event)">
  <div class="composer__drop" x-show="composer(ckey).dragging" x-cloak aria-hidden="true">
    @!component('components/icon', { name: 'photo', class: 'h-5 w-5' })
    Görseli veya GIF'i buraya bırak
  </div>

  <div class="relative">
  <label :for="ckey === 'root' ? 'comment-root' : 'reply-' + ckey" class="sr-only" x-text="ckey === 'root' ? 'Yorum yaz' : 'Yanıt yaz'">Yorum yaz</label>
  <textarea
    :id="ckey === 'root' ? 'comment-root' : 'reply-' + ckey"
    class="composer__input"
    rows="2"
    x-model="composer(ckey).text"
    @input="grow($event); mentionInput(ckey, $event)"
    @keydown="mentionKeydown(ckey, $event)"
    @blur="closeMention(ckey)"
    @click="mentionInput(ckey, $event)"
    aria-autocomplete="list"
    :aria-controls="'mentions-' + ckey"
    :aria-activedescendant="mentionActiveId(ckey)"
    @paste="paste(ckey, $event)"
    @keydown.ctrl.enter.prevent="submit(ckey)"
    @keydown.meta.enter.prevent="submit(ckey)"
    :placeholder="ckey === 'root' ? 'Ne düşünüyorsun? Görsel veya GIF de ekleyebilirsin.' : 'Yanıtını yaz…'"
  ></textarea>

  <div :id="'mentions-' + ckey" role="listbox" aria-label="Üye önerileri" class="menu mention-menu"
       x-cloak x-show="mentionOpen(ckey)">
    <template x-for="(item, index) in mentionItems(ckey)" :key="item.username">
      <div role="option" class="menu__item mention-menu__item" :id="'mention-' + ckey + '-' + index"
           :aria-selected="Boolean(composer(ckey).mention && index === composer(ckey).mention.active).toString()"
           @mousedown.prevent="pickMention(ckey, item)">
        <span class="mention-menu__avatar" aria-hidden="true">
          <template x-if="item.avatar">
            <img :src="item.avatar" alt="" loading="lazy" decoding="async">
          </template>
          <template x-if="!item.avatar">
            <span class="text-on-image" :style="`background: linear-gradient(135deg, hsl(${item.hue} 70% 45%), hsl(${(item.hue + 50) % 360} 70% 35%))`" x-text="item.fullName.charAt(0).toUpperCase()"></span>
          </template>
        </span>
        <span class="min-w-0 flex-1 truncate">
          <span class="mention-menu__name" x-text="item.fullName"></span>
          <span class="mention-menu__user" x-text="'@' + item.username"></span>
        </span>
      </div>
    </template>
  </div>
  </div>

  <div class="composer__attachments" x-show="composer(ckey).sticker || composer(ckey).preview" x-cloak>
    <template x-if="composer(ckey).sticker">
      <div class="composer__thumb">
        <img :src="composer(ckey).sticker.visual.img" :alt="composer(ckey).sticker.name + ' çıkartması'" class="h-20 w-20 object-contain">
        <button type="button" class="composer__remove" @click="composer(ckey).sticker = null" aria-label="Çıkartmayı kaldır">
          @!component('components/icon', { name: 'x', class: 'h-3.5 w-3.5', stroke: 2.2 })
        </button>
      </div>
    </template>
    <template x-if="composer(ckey).preview">
      <div class="composer__thumb">
        <img :src="composer(ckey).preview" alt="Eklenen görsel" class="max-h-48 max-w-full border border-(--t-border) object-contain">
        <span x-show="composer(ckey).file && composer(ckey).file.type === 'image/gif'" class="badge badge--solid badge--sm composer__gif" data-tone="neutral">GIF</span>
        <button type="button" class="composer__remove" @click="clearImage(ckey)" aria-label="Görseli kaldır">
          @!component('components/icon', { name: 'x', class: 'h-3.5 w-3.5', stroke: 2.2 })
        </button>
      </div>
    </template>
  </div>

  <p x-show="composer(ckey).error" x-cloak x-text="composer(ckey).error" role="alert" class="field__error composer__error"></p>

  <div class="composer__bar">
    <div class="composer__tools">
      <label class="btn btn--ghost btn--sm composer__file" title="Görsel veya GIF ekle (en fazla 8 MB)">
        <input type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="sr-only" @change="pick(ckey, $event)">
        @!component('components/icon', { name: 'photo', class: 'btn__icon' })
        <span class="sr-only sm:not-sr-only">Görsel</span>
      </label>

      <div class="relative" x-data="dropdown" @keydown="onKeydown($event)" @click.outside="close()">
        <button type="button" x-ref="button" class="btn btn--ghost btn--sm" @click="toggle(); if (open) loadStickers()" aria-expanded="false" :aria-expanded="open.toString()" title="Çıkartma ekle">
          @!component('components/icon', { name: 'smile', class: 'btn__icon' })
          <span class="sr-only sm:not-sr-only">Çıkartma</span>
        </button>
        <div x-ref="panel" x-cloak x-show="open" x-transition.origin.top.left.duration.120ms class="menu sticker-menu absolute left-0 top-full z-20 mt-2">
          <div class="sticker-menu__head">
            <p class="menu__label">Çıkartmalarım</p>
            <a href="/kozmetik/cikartmalar" class="link text-xs">Tümü</a>
          </div>
          <div x-show="stickers === null" class="sticker-grid" role="status">
            <span class="sr-only">Çıkartmalar yükleniyor…</span>
            <span class="skeleton aspect-square" aria-hidden="true"></span>
            <span class="skeleton aspect-square" aria-hidden="true"></span>
            <span class="skeleton aspect-square" aria-hidden="true"></span>
            <span class="skeleton aspect-square" aria-hidden="true"></span>
          </div>
          <p x-show="stickers && !stickers.length" class="sticker-menu__empty">
            Henüz açılmış çıkartman yok. Seviye atladıkça ve rozet kazandıkça açılır.
          </p>
          <div x-show="stickers && stickers.length" class="sticker-grid">
            <template x-for="sticker in stickers || []" :key="sticker.id">
              <button type="button" class="sticker-grid__item" @click="composer(ckey).sticker = sticker; close(true)" :title="sticker.name" :aria-label="sticker.name + ' çıkartmasını ekle'">
                <img :src="sticker.visual.img" alt="" loading="lazy" decoding="async">
              </button>
            </template>
          </div>
        </div>
      </div>

      <button type="button" class="btn btn--ghost btn--sm composer__spoiler" @click="composer(ckey).spoiler = !composer(ckey).spoiler" aria-pressed="false" :aria-pressed="composer(ckey).spoiler.toString()" title="Spoiler olarak işaretle">
        @!component('components/icon', { name: 'eye-off', class: 'btn__icon' })
        <span class="sr-only sm:not-sr-only">Spoiler</span>
      </button>
    </div>

    <div class="composer__send">
      <span class="composer__count t-num" x-show="composer(ckey).text.length" x-cloak
            :data-tone="composer(ckey).text.length > maxLength ? 'danger' : (composer(ckey).text.length > maxLength - 100 ? 'warning' : '')"
            x-text="composer(ckey).text.length + ' / ' + maxLength"></span>
      <button type="button" x-show="ckey !== 'root'" class="btn btn--ghost btn--sm" @click="replyingTo = null">Vazgeç</button>
      <button type="submit" class="btn btn--primary btn--sm" :disabled="!canSend(ckey)" :aria-busy="composer(ckey).busy.toString()" title="Ctrl + Enter ile de gönderebilirsin">
        <span x-text="composer(ckey).busy ? 'Gönderiliyor' : (ckey === 'root' ? 'Gönder' : 'Yanıtla')">Gönder</span>
      </button>
    </div>
  </div>
</form>
