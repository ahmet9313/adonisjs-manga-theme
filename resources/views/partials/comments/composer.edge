{{--
  Composer bound to `composers[ckey]` ('root' or the parent comment id).
  Images/GIFs: button, drag and drop onto the box, or paste (Ctrl+V).
--}}
<form
  @submit.prevent="submit(ckey)"
  @dragover.prevent="composer(ckey).dragging = true"
  @dragleave.prevent="if (!$el.contains($event.relatedTarget)) composer(ckey).dragging = false"
  @drop.prevent="drop(ckey, $event)"
  class="glass relative rounded-2xl border p-3 transition"
  :class="composer(ckey).dragging ? 'border-emerald-400 ring-2 ring-emerald-400/40' : 'border-white/10 focus-within:border-emerald-500/70'"
>
  <div x-show="composer(ckey).dragging" class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center rounded-2xl bg-emerald-500/10 text-sm font-semibold text-emerald-200">
    Görseli veya GIF'i buraya bırak
  </div>
  <label :for="ckey === 'root' ? 'comment-root' : 'reply-' + ckey" class="sr-only" x-text="ckey === 'root' ? 'Yorum yaz' : 'Yanıt yaz'"></label>
  <textarea
    :id="ckey === 'root' ? 'comment-root' : 'reply-' + ckey"
    x-model="composer(ckey).text"
    @input="grow($event)"
    @paste="paste(ckey, $event)"
    @keydown.ctrl.enter.prevent="submit(ckey)"
    @keydown.meta.enter.prevent="submit(ckey)"
    :placeholder="ckey === 'root' ? 'Ne düşünüyorsun? Görsel veya GIF yapıştırabilirsin.' : 'Yanıtını yaz…'"
    rows="2"
    class="block max-h-72 w-full resize-none bg-transparent text-[15px] leading-relaxed text-gray-100 placeholder-gray-500 focus:outline-none"
  ></textarea>

  {{-- Sticker preview --}}
  <div x-show="composer(ckey).sticker" x-cloak class="relative mt-2 inline-block">
    <img :src="composer(ckey).sticker && composer(ckey).sticker.visual.img" :alt="composer(ckey).sticker && composer(ckey).sticker.name" class="h-24 w-24 object-contain">
    <button type="button" @click="composer(ckey).sticker = null" aria-label="Çıkartmayı kaldır" class="absolute -right-2 -top-2 flex h-7 w-7 items-center justify-center rounded-full bg-black/80 text-(--t-heading) hover:bg-black">
      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  {{-- Attachment preview --}}
  <div x-show="composer(ckey).preview" x-cloak class="relative mt-2 inline-block">
    <img :src="composer(ckey).preview" alt="Eklenen görsel" class="max-h-56 rounded-lg border border-white/10 object-contain">
    <span x-show="composer(ckey).file && composer(ckey).file.type === 'image/gif'" class="absolute bottom-2 left-2 rounded bg-black/70 px-1.5 py-0.5 text-[10px] font-bold text-(--t-heading)">GIF</span>
    <button type="button" @click="clearImage(ckey)" aria-label="Görseli kaldır" class="absolute right-2 top-2 flex h-8 w-8 items-center justify-center rounded-full bg-black/70 text-(--t-heading) hover:bg-black/90">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <p x-show="composer(ckey).error" x-cloak x-text="composer(ckey).error" role="alert" class="mt-2 text-sm text-red-400"></p>

  <div class="mt-2 flex flex-wrap items-center justify-between gap-x-2 gap-y-1 border-t border-white/10 pt-2">
    <div class="flex min-w-0 items-center gap-0.5 sm:gap-1">
      <button type="button" @click="$el.parentElement.querySelector('input[type=file]').click()" title="Görsel veya GIF ekle"
              class="flex h-9 items-center gap-1.5 rounded-full px-2.5 text-emerald-400 transition hover:bg-emerald-500/10 active:scale-95">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <span class="rounded border border-current px-1 text-[10px] font-bold leading-4">GIF</span>
      </button>
      <input type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden" @change="pick(ckey, $event)">
      <div class="relative" x-data="{ picker: false }" @click.outside="picker = false" @keydown.escape.stop="picker = false">
        <button type="button" @click="picker = !picker; if (picker) loadStickers()" :aria-expanded="picker.toString()" title="Çıkartma ekle"
                class="flex h-9 w-9 items-center justify-center rounded-full text-emerald-400 transition hover:bg-emerald-500/10 active:scale-95">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 01-6.364 0M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm-.375 0h.008v.015h-.008V9.75zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75zm-.375 0h.008v.015h-.008V9.75z"/></svg>
        </button>
        <div x-cloak x-show="picker" x-transition class="absolute bottom-full left-0 z-30 mb-2 w-72 max-w-[calc(100vw-3rem)] rounded-2xl border border-white/10 bg-(--t-surface-2) p-3 shadow-2xl">
          <div class="mb-2 flex items-center justify-between text-xs font-bold uppercase tracking-wide text-gray-400">
            <span>Çıkartmalarım</span>
            <a href="/kozmetik/cikartmalar" class="normal-case text-emerald-300 hover:underline">Tümü</a>
          </div>
          <p x-show="stickers === null" class="py-4 text-center text-sm text-gray-400">Yükleniyor…</p>
          <p x-show="stickers && !stickers.length" class="py-4 text-center text-sm text-gray-400">Henüz açılmış çıkartman yok.</p>
          <div class="grid max-h-56 grid-cols-4 gap-2 overflow-y-auto">
            <template x-for="sticker in stickers || []" :key="sticker.id">
              <button type="button" @click="composer(ckey).sticker = sticker; picker = false" :title="sticker.name"
                      class="flex aspect-square items-center justify-center rounded-xl bg-white/5 p-1 transition hover:bg-white/15 active:scale-95">
                <img :src="sticker.visual.img" :alt="sticker.name" class="max-h-full max-w-full object-contain" loading="lazy">
              </button>
            </template>
          </div>
        </div>
      </div>
      <button type="button" @click="composer(ckey).spoiler = !composer(ckey).spoiler" :aria-pressed="composer(ckey).spoiler.toString()" title="Spoiler olarak işaretle"
              class="flex h-9 items-center gap-1 rounded-full px-2.5 text-xs font-semibold transition active:scale-95"
              :class="composer(ckey).spoiler ? 'bg-amber-500/15 text-amber-300' : 'text-gray-400 hover:bg-gray-800 hover:text-gray-200'">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>
        Spoiler
      </button>
    </div>
    <div class="ml-auto flex items-center gap-2 sm:gap-3">
      <span class="text-xs tabular-nums" :class="composer(ckey).text.length > maxLength ? 'text-red-400' : 'text-gray-500'" x-show="composer(ckey).text.length > maxLength - 200" x-text="maxLength - composer(ckey).text.length"></span>
      <button type="button" x-show="ckey !== 'root'" @click="replyingTo = null" class="rounded-full px-3 py-1.5 text-sm text-gray-400 hover:text-(--t-heading)">Vazgeç</button>
      <button type="submit" :disabled="!canSend(ckey)"
              class="rounded-full bg-emerald-600 px-4 py-1.5 text-sm font-bold text-(--t-on-accent) transition hover:bg-emerald-500 active:scale-95 disabled:cursor-not-allowed disabled:opacity-40"
              x-text="composer(ckey).busy ? 'Gönderiliyor…' : (ckey === 'root' ? 'Gönder' : 'Yanıtla')"></button>
    </div>
  </div>
</form>
