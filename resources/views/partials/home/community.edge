{{--
  Community block (switch home_community, first page only): "Son Yorumlar" and "Öne Çıkan
  İncelemeler" side by side from 1024px. When only one of them has entries it takes the full
  width with its cards in two columns.
--}}
@let(split = latestComments.length > 0 && topReviews.length > 0)
<div class="section home-community {{ split ? 'home-community--split' : '' }}">
  @if(latestComments.length)
  <section aria-labelledby="home-comments-title">
    @!component('components/ui/section_head', {
      title: 'Son Yorumlar',
      id: 'home-comments-title',
      icon: 'chat',
      description: 'Okurların bölümler ve seriler hakkında son yazdıkları'
    })
    <ul class="home-stack {{ split ? '' : 'home-stack--wide' }}">
      @each(item in latestComments)
      <li>
        @!component('components/ui/comment_preview', { item })
      </li>
      @end
    </ul>
  </section>
  @end

  @if(topReviews.length)
  <section aria-labelledby="home-reviews-title">
    @!component('components/ui/section_head', {
      title: 'Öne Çıkan İncelemeler',
      id: 'home-reviews-title',
      icon: 'star',
      description: 'Okurların en faydalı bulduğu incelemeler'
    })
    <ul class="home-stack {{ split ? '' : 'home-stack--wide' }}">
      @each(item in topReviews)
      <li>
        @!component('components/ui/review_preview', { item })
      </li>
      @end
    </ul>
  </section>
  @end
</div>
