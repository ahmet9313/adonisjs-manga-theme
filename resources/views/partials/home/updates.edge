{{--
  "Son Güncellenenler" (switch home_updates): series with their three newest chapters, paginated
  with ?page=. The heading text appears only here (tests turn the switch off and look for it).
  `homeUpdates` (resources/js/components/hero_slider.js) loads the page links in place: it shows
  the skeleton rows below, asks the server for this partial alone (X-Fragment: home-updates) and
  swaps in its [data-updates-content]. Without JavaScript the links open the page as usual.
--}}
<section id="home-updates" class="section mt-6 scroll-mt-20 sm:mt-8" aria-labelledby="home-updates-title" x-data="homeUpdates" @click="navigate">
  <div data-updates-content>
    @component('components/ui/section_head', {
      title: 'Son Güncellenenler',
      id: 'home-updates-title',
      icon: 'clock',
      description: currentPage > 1 ? 'Sayfa ' + currentPage + ' / ' + totalPages : 'Yeni bölüm eklenen seriler',
      href: '/seriler',
      linkLabel: 'Tüm seriler'
    })
      @slot('actions')
        @include('partials/home/calendar_link')
      @end
    @end

    @if(recentlyUpdated.length)
    <ul class="home-updates">
      @each((item, index) in recentlyUpdated)
      <li class="home-update">
        @component('components/series/card', { series: item, layout: 'row', priority: !heroOn && index < 3 })
          @if(item.latestChapters.length)
          <ul class="home-chapters" aria-label="{{ item.title }} son bölümleri">
            @each(chapter in item.latestChapters)
            <li>
              <a href="/series/{{ item.type }}/{{ item.slug }}/{{ chapter.number }}" class="home-chapter">
                <span class="home-chapter__no">Bölüm {{ chapter.number }}</span>
                @if(chapter.title)
                <span class="home-chapter__title">{{ chapter.title }}</span>
                @end
                @if(chapter.fresh)
                @!component('components/ui/badge', { kind: 'accent', text: 'Yeni', size: 'sm', class: 'home-chapter__new' })
                @end
                <time class="home-chapter__time" datetime="{{ chapter.publishedAt }}" title="{{ dateOf(chapter.publishedAt) }}">{{ chapter.timeAgo }}</time>
              </a>
            </li>
            @end
          </ul>
          @else
          <p class="home-chapters__none">Henüz bölüm yok</p>
          @end
        @end
      </li>
      @end
    </ul>

    @!component('components/ui/pagination', { current: currentPage, total: totalPages, label: 'Son güncellenenler sayfaları', hash: 'home-updates', class: 'mt-8' })
    @elseif(currentPage > 1)
    @component('components/ui/empty_state', { icon: 'book-open', title: 'Bu sayfada seri yok', description: 'Listenin sonuna geldiniz; en yeni güncellemeler ilk sayfada.' })
      @component('components/ui/button', { variant: 'secondary', href: '/#home-updates', icon: 'arrow-left' })
        İlk sayfaya dön
      @end
    @end
    @else
    @component('components/ui/empty_state', { icon: 'book-open', title: 'Henüz seri eklenmemiş', description: 'Seriler eklendikçe yeni bölüm gelenler burada listelenir.' })
      @if(auth && auth.user && auth.user.isStaff)
      @component('components/ui/button', { variant: 'primary', href: '/admin/seriler/ekle', icon: 'plus' })
        Seri ekle
      @end
      @end
    @end
    @end
  </div>

  <template data-updates-skeleton>
    <li class="home-update home-update--skeleton" aria-hidden="true">
      <div class="series-card series-card--row">
        <div class="series-card__cover skeleton"></div>
        <div class="series-card__body">
          <div class="skeleton h-4 w-3/4"></div>
          <div class="flex gap-1.5">
            <div class="skeleton h-4 w-14"></div>
            <div class="skeleton h-4 w-16"></div>
          </div>
          <div class="home-chapters">
            @each(row in [0, 1, 2])
            <div class="home-chapter home-chapter--skeleton">
              <div class="skeleton h-3 w-16"></div>
              <div class="skeleton h-3 {{ row === 1 ? 'w-1/4' : 'w-1/3' }}"></div>
              <div class="skeleton ml-auto h-3 w-12"></div>
            </div>
            @end
          </div>
        </div>
      </div>
    </li>
  </template>
  <p class="sr-only" role="status" data-updates-status></p>
</section>
