{
  "name": "Mangahub",
  "version": "0.9.0-beta.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "setup": "node scripts/setup-and-start.mjs --check",
    "setup:start": "node scripts/setup-and-start.mjs",
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "test:mobile-nav": "node scripts/check-mobile-nav.mjs",
    "test:ui": "node scripts/check-mobile-nav.mjs",
    "test:a11y": "node scripts/check-a11y.mjs",
    "lint": "eslint .",
    "lint:design": "node scripts/check-design-tokens.mjs",
    "lint:contrast": "node --import=@poppinss/ts-exec scripts/check-contrast.mjs --quiet",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "migrate": "node ace migration:run",
    "migrate:rollback": "node ace migration:rollback",
    "migrate:fresh": "node ace migration:fresh",
    "seed": "node ace db:seed",
    "seed:demo": "node ace db:seed --files=database/seeders/social_seeder.ts",
    "seed:clear": "node scripts/clear-demo.mjs",
    "covers:fetch": "node scripts/fetch-covers.mjs",
    "db:reset": "node ace migration:fresh && node ace db:seed",
    "admin:promote": "node scripts/promote-admin.mjs",
    "measure": "node scripts/measure-baseline.mjs"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "allowScripts": {
    "@swc/core@1.15.41": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.27.2": true
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#generated/*": "./.adonisjs/server/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@tailwindcss/vite": "^4.3.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.9.3",
    "axe-core": "^4.14.0",
    "eslint": "^10.5.0",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3",
    "vite": "^7.3.5",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.3.4",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^5.1.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@vinejs/vine": "^4.4.0",
    "alpinejs": "^3.15.12",
    "better-sqlite3": "^13.0.3",
    "edge.js": "^6.5.1",
    "luxon": "^3.7.2",
    "mysql2": "^3.22.5",
    "reflect-metadata": "^0.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
